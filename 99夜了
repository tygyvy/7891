    local function registeredDamage(registers)
        local total = 0
        for key, val in pairs(registers:GetAttributes()) do
            if tostring(key):sub(1, 6) == "Local_" and registers:GetAttribute(tostring(key):sub(7)) == nil then
                total = total + toNum(val, 0)
            end
