    local N99Esp = { Pool = {}, Running = false, Clock = 0 }

    local ESP_CATEGORY_SOURCES = nil -- filled lazily so Reg buckets are warm

    local function espBillboardFor(model, color)
        local data = N99Esp.Pool[model]
        if data and data.Bill and data.Bill.Parent then
            return data
        end
        raiseIdentity()
        local hl = Instance.new("Highlight")
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = toNum(N99.ESPFillTransparency, 0.75)
        hl.OutlineTransparency = toNum(N99.ESPOutlineTransparency, 0)
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = model
        hl.Enabled = N99.ESPHighlight and true or false
        hl.Parent = UI.HighlightContainer

        local bill = Instance.new("BillboardGui")
        bill.Size = UDim2.fromOffset(200, 22)
        bill.StudsOffset = Vector3.new(0, 3, 0)
        bill.MaxDistance = toNum(N99.ESPMaxDistance, 1200)
        bill.AlwaysOnTop = true
        bill.Adornee = model.PrimaryPart or nil
        bill.Parent = UI.OverlayContainer

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.fromScale(1, 1)
        txt.BackgroundTransparency = 1
        txt.Font = Enum.Font.GothamBold
        txt.TextColor3 = color
        txt.TextStrokeTransparency = 0.2
        txt.TextSize = toNum(N99.ESPTextSize, 14)
        txt.Text = tostring(model.Name)
        txt.Parent = bill

        data = { Highlight = hl, Bill = bill, Text = txt, LastText = "", LastDist = -1 }
        N99Esp.Pool[model] = data
        return data
    end

    local function hideEspFor(model)
        local data = N99Esp.Pool[model]
        if not data then return end
        pcall(function()
            if data.Highlight then data.Highlight.Enabled = false end
            if data.Bill then data.Bill.Enabled = false end
        end)
    end

    local function releaseEspFor(model)
        local data = N99Esp[model] or N99Esp.Pool[model]
        if not data then return end
        pcall(function()
            if data.Highlight then data.Highlight:Destroy() end
            if data.Bill then data.Bill:Destroy() end
        end)
        N99Esp.Pool[model] = nil
    end

    function N99Esp.ClearAll()
        for model in pairs(N99Esp.Pool) do
            releaseEspFor(model)
        end
    end

    function N99Esp.AnyEnabled()
        return N99.PlayerESP or N99.ChildrenESP or N99.ChestESP or N99.FuelESP
            or N99.GearsESP or N99.FoodESP or N99.WeaponsESP or N99.OthersESP
    end

    local function colorFor(kind)
        if kind == "Player" then return Color3.fromRGB(255, 90, 90) end
        if kind == "Child" then return Color3.fromRGB(90, 200, 255) end
        if kind == "Chest" then return Color3.fromRGB(255, 200, 60) end
        if kind == "Fuel" then return Color3.fromRGB(255, 149, 0) end
        if kind == "Gear" then return Color3.fromRGB(170, 170, 190) end
        if kind == "Food" then return Color3.fromRGB(120, 230, 120) end
        if kind == "Weapon" then return Color3.fromRGB(200, 120, 255) end
        return Color3.fromRGB(235, 235, 245)
    end

    local activeEspSeen = {}

    local function showEsp(model, kind, here)
        if not (model and model:IsA("Model") and model.Parent and model.PrimaryPart) then return end
        local pt = model.PrimaryPart.Position
        local dist = (pt - here).Magnitude
        local maxD = toNum(N99.ESPMaxDistance, 1200)
        if dist > maxD then
            hideEspFor(model)
            return
        end
        activeEspSeen[model] = true
        local data = espBillboardFor(model, colorFor(kind))
        if not data then return end
        if N99.ESPHighlight then data.Highlight.Enabled = true end
        data.Bill.Enabled = true
        data.Highlight.FillTransparency = toNum(N99.ESPFillTransparency, 0.75)
        data.Highlight.OutlineTransparency = toNum(N99.ESPOutlineTransparency, 0)
        data.Text.TextSize = toNum(N99.ESPTextSize, 14)
        local distInt = math.floor(dist)
        if N99.ESPDistance and distInt ~= data.LastDist then
            data.LastDist = distInt
            local label = string.format("%s [%dm]", tostring(model.Name), distInt)
            if label ~= data.LastText then
                data.LastText = label
                data.Text.Text = label
            end
        elseif not N99.ESPDistance and data.LastText ~= tostring(model.Name) then
            data.LastText = tostring(model.Name)
            data.Text.Text = data.LastText
        end
    end

    function N99Esp.Update(dt)
        if N99Esp.Running then return end
        N99Esp.Running = true
        task.spawn(function()
            local here = Char.Position()
            if here then
                table.clear(activeEspSeen)

                if N99.PlayerESP then
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            showEsp(plr.Character, "Player", here)
                        end
                    end
                end

                if N99.ChildrenESP then
                    for _, model in ipairs(Reg.Children) do
                        showEsp(model, "Child", here)
                    end
                end

                if N99.ChestESP then
                    for _, model in ipairs(Reg.Chests) do
                        showEsp(model, "Chest", here)
                    end
                end

                if N99.FuelESP then
                    for _, name in ipairs(World.Fuel) do
                        for _, model in ipairs(Reg.Named[name] or {}) do
                            showEsp(model, "Fuel", here)
                        end
                    end
                end

                if N99.GearsESP then
                    for _, name in ipairs(World.Gears) do
                        for _, model in ipairs(Reg.Named[name] or {}) do
                            showEsp(model, "Gear", here)
                        end
                    end
                end

                if N99.FoodESP then
                    for _, name in ipairs(World.Food) do
                        for _, model in ipairs(Reg.Named[name] or {}) do
                            showEsp(model, "Food", here)
                        end
                    end
                end

                if N99.WeaponsESP then
                    for _, name in ipairs(World.Weapons) do
                        for _, model in ipairs(Reg.Named[name] or {}) do
                            showEsp(model, "Weapon", here)
                        end
                    end
                end

                if N99.OthersESP then
                    for _, name in ipairs(World.Loot) do
                        for _, model in ipairs(Reg.Named[name] or {}) do
                            showEsp(model, "Other", here)
                        end
                    end
                    for _, name in ipairs(World.Toys) do
                        for _, model in ipairs(Reg.Named[name] or {}) do
                            showEsp(model, "Other", here)
                        end
                    end
                end

                -- Clean up ESP objects that fell out of range or despawned
                for model, data in pairs(N99Esp.Pool) do
                    if not activeEspSeen[model] then
                        if not model or not model.Parent then
                            releaseEspFor(model)
                        else
                            hideEspFor(model)
                        end
                    end
                end
            end
            N99Esp.Running = false
        end)
    end

