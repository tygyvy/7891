    -- 16. AUTOMATION COORDINATOR (SINGLE 0.5s HEARTBEAT LOOP FOR ALL AUTOS)
    -- ========================================================================
    local Auto = {
        Started = {},
        NextCampfire = 0,
        NextScrap = 0,
        NextChest = 0,
        NextCollect = 0,
        NextPlant = 0,
        NextSeedBox = 0,
    }

    local function onceStart(key, fn)
        if Auto.Started[key] then return end
        Auto.Started[key] = true
        task.spawn(fn)
    end

    task.spawn(function()
        lowerIdentity()
        while not N99.Unload do
            local now = os.clock()
            local ok, err = pcall(function()
                -- Campfire fuel feeder
                if N99.AutoCampfireToggle and Char.Alive() and now >= Auto.NextCampfire then
                    Auto.NextCampfire = now + 2.5
                    local pct = Place.FireStatus()
                    if pct < toNum(N99.AutoCampfireSlider, 50) then
                        Camp.Fuel()
                    end
                end

                -- Scrapper: logs & gears to workbench
                if (N99.AutoScrapLogsToggle or N99.AutoScrapGearsToggle) and now >= Auto.NextScrap then
                    Auto.NextScrap = now + 4
                    if N99.AutoScrapLogsToggle then
                        Bring.Run("logs for scrapping", { "Log" }, { Quiet = true })
                    end
                    if N99.AutoScrapGearsToggle then
                        Bring.Run("gears for scrapping", N99.ScrapGearsSelection, { Quiet = true })
                    end
                end

                -- Auto Chest sweep
                if N99.AutoChestToggle and now >= Auto.NextChest then
                    Auto.NextChest = now + 6
                    Chest.Sweep()
                end

                -- Collectable sweeps (flowers / gold stacks)
                if (N99.AutoCollectFlowers or N99.AutoCollectGoldStacks) and now >= Auto.NextCollect then
                    Auto.NextCollect = now + 3.5
                    if N99.AutoCollectFlowers then
                        Collect.Sweep("flowers", Reg.Flowers)
                    end
                    if N99.AutoCollectGoldStacks then
                        Collect.Sweep("coins", Reg.Coins)
                    end
                end

                -- Spam planter
                if N99.StartSpamPlanting and now >= Auto.NextPlant then
                    Auto.NextPlant = now + 1.2
                    Plant.Saplings()
                end

                -- Auto open seed boxes
                if N99.AutoOpenSeedBox and now >= Auto.NextSeedBox then
                    Auto.NextSeedBox = now + 8
                    Plant.OpenBoxes()
                end

                -- Infinite sapling re-arm
                if N99.INFSaplings and not Plant.Armed then
                    Plant.Rearm(true)
                end
            end)
            if not ok then
                warn("[Core.xyz 99Nights] Auto loop error: " .. tostring(err))
            end
            task.wait(0.5)
        end
    end)

