    function Explore.NearestBucket(bucket, maxDist)
        local here = Char.Position()
        if not here then return nil end
        local best, bestDist = nil, math.huge
        for _, model in ipairs(bucket or {}) do
            local pt = model and model:IsA("Model") and model.Parent and getPivotCFrame(model)
            if pt then
                local dist = (here - pt.Position).Magnitude
                if dist < bestDist and (not maxDist or dist <= maxDist) then
                    best, bestDist = model, dist
                end
            end
        end
        return best, bestDist
    end

    function Explore.LocateNearest(name, bucket)
