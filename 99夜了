    local Hold = { Part = nil, Target = nil, Running = false }

    function Hold.CFrame(target)
        local frame = Char.Frame()
        if not frame then return nil end
        local here = frame.Position
        local pt = getPivotCFrame(target)
        if not pt then return nil end
        local dir = (pt.Position - here)
        if dir.Magnitude < 0.01 then
            dir = frame.LookVector
        else
            dir = dir.Unit
        end
        local dist = math.clamp(dir.Magnitude, 0, 3.2)
        return frame + dir * dist + Vector3.new(0, 0.4, 0)
    end

    function Hold.Start(target)
        if Hold.Target == target and Hold.Running then return end
        Hold.Stop()
        Hold.Target = target
        Hold.Running = true
        raiseIdentity()
        local part = Instance.new("Part")
        part.Name = "CoreXYZ_HoldAnchor"
        part.Size = Vector3.new(0.3, 0.3, 0.3)
        part.Transparency = 1
        part.Anchored = false
        part.CanCollide = false
        part.CanQuery = false
        part.Massless = true
        part.Parent = workspace
        Hold.Part = part

        local root = Char.Parts() and select(3, Char.Parts())
        if root then
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = root
            weld.Part1 = part
            weld.Parent = part
        end

        task.spawn(function()
            while Hold.Running and not N99.Unload do
                pcall(function()
                    if Hold.Part and Hold.Part.Parent then
                        local frame = Hold.CFrame(Hold.Target)
                        if frame then
                            Hold.Part.CFrame = frame
                        end
                    end
                end)
                RunService.Heartbeat:Wait()
            end
        end)
    end

    function Hold.Stop()
        Hold.Running = false
        Hold.Target = nil
        raiseIdentity()
        if Hold.Part then pcall(function() Hold.Part:Destroy() end) end
        Hold.Part = nil
    end

