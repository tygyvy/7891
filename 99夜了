local function refreshLocalCharacterCache()
    local char = LocalPlayer.Character
    if not char then
        State.cachedLocalChar = nil
        State.cachedLocalHRP = nil
        State.cachedLocalHum = nil
        return
    end
    State.cachedLocalChar = char
    State.cachedLocalHRP = char:FindFirstChild("HumanoidRootPart")
    State.cachedLocalHum = char:FindFirstChildOfClass("Humanoid")
    table.clear(State.cachedLocalParts)
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            table.insert(State.cachedLocalParts, part)
        end
    end
end

refreshLocalCharacterCache()

bindConnection("LocalCharAdded", LocalPlayer.CharacterAdded, function(char)
    task.wait(0.15)
    refreshLocalCharacterCache()
    pcall(function()
        State.defaultWalkSpeed = math.max(16, (char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").WalkSpeed) or 16)
        State.defaultJumpPower = math.max(50, (char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").JumpPower) or 50)
    end)
    pcall(function()
        if ConfigState.Headless then applyHeadless(true) end
        if ConfigState.Korblox then applyKorblox(true) end
        if ConfigState.SelfChams then State.applySelfChams() end
        if ConfigState.LegTrailEnabled then State.applyLegTrails() end
        if ConfigState.ToolVisuals or ConfigState.ToolChams or ConfigState.ToolGlow then State.applyToolVisuals() end
        if State.isAuthorized then State.N99CharWatch = true end
    end)
    task.wait(0.35)
    refreshLocalCharacterCache()
end)

-- FOV circle visuals live on minimal overlay ScreenGui created in adapter bootstrap
local fovCircle = UI.FovCircle
local fovOuterStroke = UI.FovOuterStroke
local fovGradient = UI.FovGradient

local function updateFOVCircle(camera)
    if not fovCircle then return end
    local wantVisible = ConfigState.ShowFOV and ConfigState.Aimbot
    if fovCircle.Visible ~= wantVisible then
        fovCircle.Visible = wantVisible
    end
    if not wantVisible then return end
    local fovMode = ConfigState.FovVisualMode or "Still"
    local radius = math.max(8, ConfigState.FOVRadius)
    local diameter = radius * 2
    if fovMode == "Following" then
        local targetPart = State.cachedAimTarget
        local screenPos = nil
        if targetPart and targetPart.Parent then
            local ok, pos = pcall(function()
                local v3, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                return Vector2.new(v3.X, v3.Y), onScreen
            end)
            if ok and pos then
                screenPos = pos
            end
        end
        if not screenPos then
            screenPos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        end
        fovCircle.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)
    else
        fovCircle.Position = UDim2.fromScale(0.5, 0.5)
    end
    fovCircle.Size = UDim2.fromOffset(diameter, diameter)
    if fovOuterStroke then
        fovOuterStroke.Color = ConfigState.FovColor or Theme.White
    end
    if fovGradient then
        fovGradient.Color = ColorSequence.new(ConfigState.FovGradientColor or Color3.fromRGB(70, 70, 82))
    end
end

local function updateAimbot(camera)
    if not ConfigState.Aimbot then
        State.cachedAimTarget = nil
        return
    end
    State.targetScanAccumulator = State.targetScanAccumulator + 0.016
    if State.targetScanAccumulator >= 0.1 then
        State.targetScanAccumulator = 0
        State.cachedAimTarget = getClosestTarget(camera)
    end
    local targetPart = State.cachedAimTarget
    if not targetPart or not targetPart.Parent then
        return
    end
    if ConfigState.AimbotLockCharacter then
        local char = targetPart.Parent
        if char and char:FindFirstChildOfClass("Humanoid") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum.Health <= 0 then
                State.cachedAimTarget = nil
                return
            end
        end
    end
    local ok, targetPos = pcall(function()
        return targetPart.Position
    end)
    if not ok then return end
    local camCF = camera.CFrame
    local lookLerp = math.clamp(1 - (ConfigState.Smoothness or 0.9), 0.02, 1)
    local targetCF = CFrame.new(camCF.Position, targetPos)
    camera.CFrame = camCF:Lerp(targetCF, lookLerp)
end

local autoInteractAccum = 0
local function updateAutoInteract(camera, dt)
    autoInteractAccum = autoInteractAccum + dt
    if autoInteractAccum < 0.18 then
        return
    end
    autoInteractAccum = 0
    if not ConfigState.AutoInteract then
        return
    end
    local myChar = LocalPlayer.Character
    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return
    end
    local radius = ConfigState.InteractRadius or 15
    local prompts = {}
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            local attachPart = desc.Parent
            if attachPart and attachPart:IsA("BasePart") then
                local dist = (attachPart.Position - hrp.Position).Magnitude
                if dist <= radius then
                    table.insert(prompts, { Prompt = desc, Dist = dist })
                end
            end
        end
        if #prompts > 24 then
            break
        end
    end
    table.sort(prompts, function(a, b)
        return a.Dist < b.Dist
    end)
    for i = 1, math.min(#prompts, 4) do
        pcall(function()
            local prompt = prompts[i].Prompt
            if type(Env.fireproximityprompt) == "function" then
                Env.fireproximityprompt(prompt)
            else
                prompt.HoldDuration = 0
                prompt:InputHoldBegin()
                task.delay(0.05, function()
                    pcall(function() prompt:InputHoldEnd() end)
                end)
            end
        end)
    end
end

local noclipSteppedAccum = 0
local steppedClock = 0

local function postCameraFramePass()
    steppedClock = steppedClock + 0.016
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local dt = 0.016

    -- Freecam movement controller (WASD + QE fly on Scriptable camera)
    if ConfigState.Freecam then
        local camCF = camera.CFrame
        State.freecamPos = camCF.Position
        local moveVec = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec - camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec - camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then moveVec = moveVec + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then moveVec = moveVec - Vector3.new(0, 1, 0) end
        if moveVec.Magnitude > 0 then
            moveVec = moveVec.Unit
            camera.CFrame = camCF + moveVec * ((ConfigState.FreecamSpeed or 45) * dt)
        end
    end

    -- NoClip: strip collisions of local character parts each physics tick
    if ConfigState.NoClip then
        noclipSteppedAccum = noclipSteppedAccum + dt
        if noclipSteppedAccum >= 0.03 then
            noclipSteppedAccum = 0
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetChildren()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        State.noclipCollideCache[part] = part.CanCollide
                        part.CanCollide = false
                    end
                end
            end
        end
    end

    -- AntiFling: keep low collisions & velocity clamp
    if ConfigState.AntiFling then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local vel = hrp.AssemblyLinearVelocity
            if math.abs(vel.Y) > 120 or vel.Magnitude > 220 then
                pcall(function()
                    hrp.AssemblyLinearVelocity = Vector3.new(math.clamp(vel.X, -60, 60), math.clamp(vel.Y, -60, 60), math.clamp(vel.Z, -60, 60))
                end)
            end
        end
    end

    -- Spinbot / Orbit
    if ConfigState.Spinbot then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(ConfigState.SpinSpeed or 25), 0)
            end)
        end
    end
    if State.orbitingPlayerName then
        local orbTarget = Players:FindFirstChild(State.orbitingPlayerName)
        if orbTarget and orbTarget.Character then
            local tRoot = orbTarget.Character:FindFirstChild("HumanoidRootPart")
            if tRoot then
                State.orbitAngle = State.orbitAngle + (ConfigState.OrbitSpeed or 4.5) * dt
                local radius = ConfigState.OrbitRadius or 8
                camera.CFrame = CFrame.new(
                    tRoot.Position + Vector3.new(math.cos(State.orbitAngle) * radius, 4, math.sin(State.orbitAngle) * radius),
                    tRoot.Position
                )
            end
        end
    end

    -- Spectate cam
    if State.spectatingPlayerName then
        local specTarget = Players:FindFirstChild(State.spectatingPlayerName)
        if specTarget and specTarget.Character then
            local hum = specTarget.Character:FindFirstChildOfClass("Humanoid")
            if hum and camera.CameraSubject ~= hum then
                camera.CameraSubject = hum
            end
        end
    end

    -- Aim assist & FOV circle
    updateAimbot(camera)
    updateFOVCircle(camera)

    -- Auto Interact
    pcall(updateAutoInteract, camera, dt)

    -- ESP overlays & hitbox engine (throttled internally)
    pcall(function()
        if ConfigState.ESP or ConfigState.Box3DESP or ConfigState.SkeletonESP or ConfigState.HealthBarESP or ConfigState.Tracers then
            updateESP(camera)
        end
    end)
    if ConfigState.HitboxExpander then
        pcall(updateHitboxExpander)
    end

    -- Weather, music, visual suites & 99 Nights frame hooks
    pcall(function()
        if State.updateWeatherFrame then State.updateWeatherFrame(camera, dt) end
    end)
    pcall(function()
        if State.updateMusicPlayerFrame then State.updateMusicPlayerFrame(dt) end
    end)
    pcall(function()
        if State.updateVisualSuitesFrame then State.updateVisualSuitesFrame(dt, steppedClock) end
    end)
    pcall(function()
        if State.N99Frame then State.N99Frame(dt, camera) end
    end)
end

-- Bind the post camera render pass (deterministic cleanup already handled in section 2)
pcall(function()
    RunService:BindToRenderStep("CoreXYZ_PostCameraSync", Enum.RenderPriority.Camera.Value + 1, function()
        postCameraFramePass()
    end)
end)
