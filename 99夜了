local function setOptionValues(opt, values)
    if not opt then return end
    pcall(function()
        if type(opt.SetValues) == "function" then
            opt:SetValues(values)
            return
        end
    end)
    pcall(function()
        opt.Values = values
        if type(opt.Value) ~= "table" and not opt.Multi then
            local found = false
            for _, v in ipairs(values) do
                if v == opt.Value then found = true break end
            end
            if not found and #values > 0 then
                opt.Value = values[1]
            end
        end
    end)
end

