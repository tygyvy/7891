    frameCorner.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.65, 0, 1, 0)
    label.Text = name
    label.TextColor3 = Color3.fromRGB(220, 230, 255)
    label.TextSize = 13
