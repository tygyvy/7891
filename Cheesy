                    local lockObj = cur:FindFirstChild("Lock") or cur:FindFirstChild("SkullLock")
                    if lockObj and lockObj:FindFirstChildWhichIsA("ProximityPrompt", true) then isContainerLocked = true end
                end
            end
            cur = cur.Parent
        end
        return isDirectLockPrompt, isContainerLocked
