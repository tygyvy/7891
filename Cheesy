                    end
                    claimTVNetworkPhysics()
                    rootPart.AssemblyAngularVelocity = tumbleTorque
                    rootPart.AssemblyLinearVelocity = slamVelocity
                end)
            end)
            if not success then isTVSlamExecuting = false end
        end)
        return true
    end
