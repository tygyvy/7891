    local conn
    conn = hum:GetPropertyChangedSignal("Health"):Connect(function()
        if not m_AntiBurn.enabled then conn:Disconnect(); return end
        local fd = hum:FindFirstChild("FireDebounce")
        if fd and fd.Value == true then task.spawn(m_handleBurn, character, fd) end
    end)
