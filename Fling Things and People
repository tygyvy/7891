-- 五、Anti Line Lag
local autoLineLag = { enabled = false, playerData = {}, conn = nil, thread = nil }
local LL_THRESHOLD = 5
local LL_WINDOW = 1.5
local LL_NOTIFY_COOLDOWN = 6
local beamMove = nil
local function getBeamMove()
    if not beamMove and lp then
        local ps = lp:FindFirstChild("PlayerScripts")
        if ps then beamMove = ps:FindFirstChild("CharacterAndBeamMove") end
    end
    return beamMove
end
local function disableBeam()
    pcall(function()
        local b = getBeamMove()
        if b and b.Enabled then b.Enabled = false end
    end)
end
local function enableBeam()
    pcall(function()
        local b = getBeamMove()
        if b and not b.Enabled then b.Enabled = true end
    end)
end
local function isMaliciousLine(myPos, targetPart)
    if not myPos or not targetPart then return false end
    local p = targetPart.Position
    return math.abs(myPos.X - p.X) >= 40000 or math.abs(myPos.Y - p.Y) >= 40000 or math.abs(myPos.Z - p.Z) >= 40000
end
local function cleanupLineData()
    local now = tick()
    for k, data in pairs(autoLineLag.playerData) do
        if not data or not data.lastTime or now - data.lastTime > 3 then
            autoLineLag.playerData[k] = nil
        else
            local t = {}
            for _, ts in ipairs(data.timestamps or {}) do
                if ts >= now - LL_WINDOW then table.insert(t, ts) end
            end
            data.timestamps = t
        end
    end
end
local function startAntiLineLag()
    autoLineLag.enabled = true
    disableBeam()
    if not CreateLine then return end
    autoLineLag.conn = CreateLine.OnClientEvent:Connect(function(player, target, cframe)
        if not autoLineLag.enabled or not player or player == lp then return end
        local chr = player.Character
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local targetPart = cframe or (typeof(target) == "CFrame" and target)
        if not targetPart then return end
        if isMaliciousLine(hrp.Position, targetPart) then
            local now = tick()
            if not autoLineLag.playerData[player] then
                autoLineLag.playerData[player] = { lastNotify = 0, timestamps = {}, lastTime = now }
            end
            local d = autoLineLag.playerData[player]
            table.insert(d.timestamps, now)
            d.lastTime = now
            local t = {}
            for _, ts in ipairs(d.timestamps) do
                if ts >= now - LL_WINDOW then table.insert(t, ts) end
            end
            d.timestamps = t
            if #d.timestamps >= LL_THRESHOLD and now - d.lastNotify >= LL_NOTIFY_COOLDOWN then
                d.lastNotify = now
                notify("Line lag detected!", (player.DisplayName or player.Name) .. " is spamming lines!", 5)
            end
        end
    end)
    autoLineLag.thread = task.spawn(function()
        while autoLineLag.enabled do
            task.wait(0.05)
            cleanupLineData()
        end
    end)
end
local function stopAntiLineLag()
    autoLineLag.enabled = false
    if autoLineLag.conn then autoLineLag.conn:Disconnect(); autoLineLag.conn = nil end
    if autoLineLag.thread then task.cancel(autoLineLag.thread); autoLineLag.thread = nil end
    autoLineLag.playerData = {}
    enableBeam()
end

