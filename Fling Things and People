local function mercuryAutoBreakLoop()
    local c = LocalPlayer.Character
    if c then
        local h = c:FindFirstChild("Humanoid")
        if h and h.Health > 0 then pcall(function() c:BreakJoints() end) end
    end
    while T.mercuryAutoBreakActive do
        local newC = LocalPlayer.CharacterAdded:Wait()
        if not T.mercuryAutoBreakActive then break end
        local h = newC:WaitForChild("Humanoid", 5)
        task.wait(0.3)
        if T.mercuryAutoBreakActive and h and h.Health > 0 then
            pcall(function() newC:BreakJoints() end)
        end
    end
end
local function mercuryStartAutoBreak()
    T.mercuryAutoBreakActive = true
    task.spawn(mercuryAutoBreakLoop)
end
local function mercuryStopAutoBreak()
    T.mercuryAutoBreakActive = false
end

local mercuryShurikenItems = {
    NinjaKatana = true, NinjaKunai = true, NinjaShuriken = true,
    ToolCleaver = true, ToolDiggingForkRusty = true, ToolPencil = true, ToolPickaxe = true,
}
local function mercuryShurikenScan()
    local c = LocalPlayer.Character
    local hrp = c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChildWhichIsA("BasePart"))
    local myPos = hrp and hrp.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local folder = Workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if mercuryShurikenItems[child.Name] then
                        local sticky = child:FindFirstChild("StickyPart") or child:FindFirstChildWhichIsA("BasePart")
                        if sticky then
                            local pos = sticky.Position
                            local mag = myPos and (pos - myPos).Magnitude or nil
                            if not (mag and mag <= 100) then
                                if math.abs(pos.X) > 5e11 or math.abs(pos.Y) > 5e11 or math.abs(pos.Z) > 5e11 then
                                    pcall(function() child:Destroy() end)
                                    local now = tick()
                                    if now - T.mercuryAntiShurikenLastNotify >= 6 then
                                        T.mercuryAntiShurikenLastNotify = now
