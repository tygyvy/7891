--[[ 踢出光环 ]]--
local function startKickAura()
    if T.kickAuraTask then task.cancel(T.kickAuraTask) T.kickAuraTask = nil end
    T.kickAuraKickedPlayers = {}
    T.kickAuraTask = task.spawn(function()
        while S.KickAura do
            local r = auraGetRoot()
            if not r then task.wait(0.1) continue end
            local now = tick()
            for uid, t0 in pairs(T.kickAuraKickedPlayers) do
                if now - t0 >= 1.5 then T.kickAuraKickedPlayers[uid] = nil end
            end
            local nearby = {}
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and not T.kickAuraKickedPlayers[plr.UserId] and plr.Character and auraPlayerAllowed(plr) then
                    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    local h = plr.Character:FindFirstChildOfClass("Humanoid")
                    if hrp and h and h.Health > 0 then
                        local dist = (hrp.Position - r.Position).Magnitude
                        if dist <= S.AuraRadius + 30 then
                            table.insert(nearby, {plr = plr, hrp = hrp, hum = h, dist = dist})
                        end
                    end
                end
            end
            table.sort(nearby, function(a, b) return a.dist < b.dist end)
            if #nearby > 0 then
                local tgt = nearby[1]
                pcall(function()
                    SetOwner:FireServer(tgt.hrp, tgt.hrp.CFrame)
                    task.wait(0.02)
                    DestroyLine:FireServer(tgt.hrp)
                    task.wait(0.02)
                    tgt.hrp.AssemblyLinearVelocity = Vector3.new(0, 2000, 0)
                    local bv = Instance.new("BodyVelocity")
                    bv.MaxForce = Vector3.one * math.huge
                    bv.Velocity = Vector3.new(math.random(-50, 50), 2000, math.random(-50, 50))
                    bv.Parent = tgt.hrp
                    Debris:AddItem(bv, 0.5)
                    task.wait(0.03)
                    DestroyLine:FireServer(tgt.hrp)
                end)
                local healthAfter = tgt.hum and tgt.hum.Health or 0
                if healthAfter > 0 then
                    T.kickAuraKickedPlayers[tgt.plr.UserId] = tick()
                end
            end
            task.wait(0.05)
        end
        T.kickAuraKickedPlayers = {}
    end)
end
local function stopKickAura()
    S.KickAura = false
    if T.kickAuraTask then task.cancel(T.kickAuraTask) T.kickAuraTask = nil end
    T.kickAuraKickedPlayers = {}
end

--[[ 防大玩具 ]]--
local function startAntiGucci()
    if T.antiGucciTask then task.cancel(T.antiGucciTask) T.antiGucciTask = nil end
    T.antiGucciTask = task.spawn(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local rootPart = character:WaitForChild("HumanoidRootPart")
        T.antiGucciSafePos = rootPart.CFrame
        local function ensureBlobman()
            local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
            local blob = inv and inv:FindFirstChild("CreatureBlobman")
            if not blob or not blob.Parent then
                pcall(function() SpawnToy:InvokeServer("CreatureBlobman", rootPart.CFrame, Vector3.zero) end)
                task.wait(1)
                inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                blob = inv and inv:FindFirstChild("CreatureBlobman")
            end
            return blob
        end
        local blob = ensureBlobman()
        if not blob then return end
        local seat = blob:FindFirstChildWhichIsA("VehicleSeat", true)
        if not seat then return end
        rootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
        task.wait()
        local gucciRunning = true
        seat:Sit(humanoid)
        local grabThread = task.spawn(function()
            local f = 0
            while gucciRunning do
                for _, part in ipairs(blob:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if f % 3 == 0 then pcall(function() SetOwner:FireServer(part, rootPart.CFrame) end)
                        elseif f % 3 == 1 then pcall(function() CreateLine:FireServer(part, Vector3.zero, part.Position, false) end)
                        else pcall(function() DestroyLine:FireServer(part) end) end
                    end
                end
                f = f + 1
                task.wait(0.035)
            end
        end)
        local start = tick()
        while tick() - start < 0.5 and S.AntiGucci do
            pcall(function()
                RagdollRemote:FireServer(rootPart, 0)
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
            RunService.Heartbeat:Wait()
        end
        gucciRunning = false
        local primary = blob.PrimaryPart or blob:FindFirstChildWhichIsA("BasePart", true)
        if primary then
            pcall(function() SetOwner:FireServer(primary, rootPart.CFrame) end)
            pcall(function() sethiddenproperty(primary, "NetworkIsSleeping", false) end)
        end
        pcall(function() seat:Destroy() end)
        task.wait(0.1)
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            humanoid.Sit = false
        end
        task.wait(0.05)
        rootPart.CFrame = T.antiGucciSafePos
        pcall(function()
            if blob:FindFirstChild("Head") then
                blob.Head.CFrame = CFrame.new(0, 50000, 0)
                blob.Head.Anchored = true
            end
        end)
    end)
end
local function stopAntiGucci()
    S.AntiGucci = false
    if T.antiGucciTask then task.cancel(T.antiGucciTask) T.antiGucciTask = nil end
    local character = LocalPlayer.Character
    if character then
        local r = character:FindFirstChild("HumanoidRootPart")
        local h = character:FindFirstChildOfClass("Humanoid")
