    local b = p1 and p1:FindFirstChild("Barrier")
    return b and b:FindFirstChild("PlotBarrier")
end
local function m_saveBurnState()
    local b = m_getBurnBarrier()
    if b then m_AntiBurn.savedCF = b.CFrame; m_AntiBurn.savedTrans = b.Transparency; m_AntiBurn.savedSize = b.Size end
end
local function m_restoreBurnState()
    local b = m_getBurnBarrier()
    if b and m_AntiBurn.savedCF then
        b.CFrame = m_AntiBurn.savedCF
        b.Transparency = m_AntiBurn.savedTrans or 0
        b.Size = m_AntiBurn.savedSize or Vector3.one
    end
end
local function m_handleBurn(character, debounce)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local b = m_getBurnBarrier()
    if not b or not b.Parent then return end
    m_saveBurnState()
    b.Transparency = 1
    b.Size = Vector3.zero
    while debounce and debounce.Value == true and b.Parent and hrp.Parent do
        b.CFrame = hrp.CFrame
        b.Size = Vector3.zero
        task.wait()
    end
    if debounce and debounce.Parent then debounce.Value = false end
    m_restoreBurnState()
end
local function m_watchBurn(character)
    task.wait(0.3)
    if not m_AntiBurn.enabled then return end
    local hum = character:FindFirstChild("Humanoid")
