local REMOVE_ITEMS = {
    NinjaKunai = true,
    ToolPickaxe = true,
    ToolPencil = true,
    NinjaShuriken = true,
    AntiKick = true,
    ToolDiggingForkRusty = true,
    ToolCleaver = true,
    AntiKickCleaver = true,
    NinjaKatana = true,
}
local REMOVE_DISTANCE = 35
local REMOVE_CFRAME = CFrame.new(0, 1e9, 1e9)

local function removeIsBlobman(obj)
    if not obj then return false end
    local n = string.lower(obj.Name)
    return n == "creatureblobman" or n:find("blobman") ~= nil
end

local function removeGetParts(obj)
    local parts = {}
    if not obj then return parts end
    if obj:IsA("BasePart") then table.insert(parts, obj) end
    for _, d in pairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then table.insert(parts, d) end
    end
    return parts
end

local function removeAntiKickInventory(player)
    if not player or not player.Character then return end
    local folder = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
    if not folder then return end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local myPos = myRoot.Position
    local myName = LocalPlayer.Name
    for _, child in ipairs(folder:GetChildren()) do
        if not removeIsBlobman(child) and REMOVE_ITEMS[child.Name] then
            local soundPart = child:FindFirstChild("SoundPart") or child:FindFirstChildWhichIsA("BasePart")
            if soundPart and (myPos - soundPart.Position).Magnitude <= REMOVE_DISTANCE then
                pcall(function()
                    if SetOwner then SetOwner:FireServer(soundPart, soundPart.CFrame) end
                end)
                local partOwner = soundPart:FindFirstChild("PartOwner")
                if partOwner and partOwner.Value == myName then
                    soundPart.CFrame = REMOVE_CFRAME
                end
            end
        end
    end
end

