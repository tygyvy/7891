combatSec:AddToggle("Triggerbot", {
    Text = "扳机机器人（扫到自动开火）", Default = false,
    Callback = function(v)
        S.Triggerbot = v
        if v then
            if T.triggerConn then T.triggerConn:Disconnect() T.triggerConn = nil end
            T.triggerConn = RunService.RenderStepped:Connect(function()
                if not S.Triggerbot then return end
                if Workspace:FindFirstChild("GrabParts") then return end
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end
                local cam = Workspace.CurrentCamera
                local camCF = cam.CFrame
                local origin = camCF.Position
                local look = camCF.LookVector
                local right = camCF.RightVector
                local up = camCF.UpVector
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = { myChar, Workspace.Terrain }
                local hit = nil
                local offsets = {
                    look,
                    (look + right * 0.02).Unit, (look - right * 0.02).Unit,
                    (look + up * 0.02).Unit, (look - up * 0.02).Unit,
                    (look + right * 0.04 + up * 0.02).Unit,
                    (look - right * 0.04 + up * 0.02).Unit,
                    (look + right * 0.04 - up * 0.02).Unit,
                    (look - right * 0.04 - up * 0.02).Unit,
                }
                for _, d in ipairs(offsets) do
                    local r = Workspace:Raycast(origin, d * 1000, rp)
                    if r then hit = r break end
                end
                if not hit then return end
                local model = hit.Instance:FindFirstAncestorOfClass("Model")
                if not model or model == myChar then return end
                if S.AimMode == "指定玩家" and S.AimTarget then
                    local plr = Players:GetPlayerFromCharacter(model)
                    if not plr or plr.Name ~= S.AimTarget then return end
                end
                local h = model:FindFirstChildOfClass("Humanoid")
                if not h or h.Health <= 0 then return end
                local r = model:FindFirstChild("HumanoidRootPart")
                if not r then return end
                if S.AimIgnoreFriends then
                    local plr = Players:GetPlayerFromCharacter(model)
                    if plr then
                        local isFriend = false
                        pcall(function() isFriend = LocalPlayer:IsFriendsWith(plr.UserId) end)
                        if isFriend then return end
                    end
                end
                local hasGP = LocalPlayer:FindFirstChild("FartherReach") ~= nil
                if (myRoot.Position - r.Position).Magnitude > (hasGP and 30 or 20) then return end
                pcall(function() mouse1press() end)
                pcall(function() mouse1release() end)
            end)
        else
            if T.triggerConn then T.triggerConn:Disconnect() T.triggerConn = nil end
        end
    end,
})
combatSec:AddToggle("LegitAim", {
    Text = "合法自瞄（会转动视角）", Default = false,
    Callback = function(v)
        S.LegitAim = v
        if v then
            if T.legitAimConn then T.legitAimConn:Disconnect() T.legitAimConn = nil end
            T.legitAimConn = RunService.RenderStepped:Connect(function()
                if not S.LegitAim then return end
                local myChar = LocalPlayer.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myRoot then return end
                local cam = Workspace.CurrentCamera
                local screenCenter = cam.ViewportSize / 2
                local maxRange = S.AimRange or 50
                local best, bestScore = nil, math.huge
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        if S.AimMode == "指定玩家" and S.AimTarget and plr.Name ~= S.AimTarget then
                            continue
                        end
                        if S.AimIgnoreFriends then
                            local isFriend = false
                            pcall(function() isFriend = LocalPlayer:IsFriendsWith(plr.UserId) end)
                            if isFriend then continue end
                        end
                        local tChar = plr.Character
                        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
                        local tHum = tChar:FindFirstChildOfClass("Humanoid")
                        if tRoot and tHum and tHum.Health > 0 then
                            local dist = (tRoot.Position - cam.CFrame.Position).Magnitude
                            if dist <= maxRange then
                                if S.LegitAimVisible then
                                    local rp = RaycastParams.new()
                                    rp.FilterType = Enum.RaycastFilterType.Exclude
                                    rp.FilterDescendantsInstances = { myChar, tChar }
                                    local ray = Workspace:Raycast(cam.CFrame.Position, tRoot.Position - cam.CFrame.Position, rp)
                                    if ray then continue end
                                end
                                local aimPart = tRoot
                                if S.AimHitbox == "头" then
                                    aimPart = tChar:FindFirstChild("Head") or tRoot
                                elseif S.AimHitbox == "身体" then
                                    aimPart = tChar:FindFirstChild("Torso") or tChar:FindFirstChild("UpperTorso") or tRoot
                                elseif S.AimHitbox == "随机" then
                                    local parts = {tChar:FindFirstChild("Head"), tChar:FindFirstChild("Torso"), tChar:FindFirstChild("UpperTorso"), tChar:FindFirstChild("Left Arm"), tChar:FindFirstChild("Right Arm"), tRoot}
                                    local valid = {}
                                    for _, p in ipairs(parts) do if p then table.insert(valid, p) end end
                                    if #valid > 0 then aimPart = valid[math.random(1, #valid)] end
                                end
                                local screenPos, onScreen = cam:WorldToScreenPoint(aimPart.Position)
                                local dx = screenPos.X - screenCenter.X
                                local dy = screenPos.Y - screenCenter.Y
                                local score = math.sqrt(dx*dx + dy*dy)
                                if not onScreen then score = score + 10000 end
                                if score < bestScore then
                                    bestScore = score
                                    best = aimPart
                                end
                            end
                        end
                    end
                end
                if best then
                    local camPos = cam.CFrame.Position
                    if S.LegitAimSmooth then
                        local targetDir = (best.Position - camPos).Unit
                        local currentLook = cam.CFrame.LookVector
                        local factor = math.min(1, 2.5 / S.LegitAimSmoothness)
                        local newLook = (currentLook + (targetDir - currentLook) * factor).Unit
                        cam.CFrame = CFrame.lookAt(camPos, camPos + newLook)
                    else
                        cam.CFrame = CFrame.lookAt(camPos, best.Position)
                    end
                end
            end)
        else
            if T.legitAimConn then T.legitAimConn:Disconnect() T.legitAimConn = nil end
        end
    end,
})
