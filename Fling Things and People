    end))
    task.spawn(function()
        local queue = { m_ws }
        while #queue > 0 and m_AntiAntiInput.enabled do
            local children = table.remove(queue):GetChildren()
            for _, c in ipairs(children) do
                if m_AntiAntiInput.enabled then
                    if m_antiInputItemSet[c.Name] then task.spawn(m_spamItem, c)
                    elseif not c:IsA("BasePart") and c.Name ~= "Terrain" then table.insert(queue, c) end
                else break end
            end
            task.wait()
        end
    end)
end
local function m_stopAntiAntiInput()
    m_AntiAntiInput.enabled = false
    for _, c in ipairs(m_AntiAntiInput.connections) do pcall(function() c:Disconnect() end) end
    for _, t in ipairs(m_AntiAntiInput.spamThreads) do pcall(function() task.cancel(t) end) end
    m_AntiAntiInput.connections = {}; m_AntiAntiInput.spamThreads = {}; m_AntiAntiInput.spamActive = {}
end

