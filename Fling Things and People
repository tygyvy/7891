        end
        local targets = {
            {path = {"Workspace", "Map", "AlwaysHereTweenedObjects", "InnerUFO", "Object", "ObjectModel"}, color = Color3.fromRGB(255, 100, 100)},
            {path = {"Workspace", "Map", "AlwaysHereTweenedObjects", "OuterUFO", "Object", "ObjectModel"}, color = Color3.fromRGB(100, 255, 100)},
            {path = {"Workspace", "Map", "AlwaysHereTweenedObjects", "CaveCart", "Object", "ObjectModel"}, color = Color3.fromRGB(100, 100, 255)},
            {path = {"Workspace", "Map", "AlwaysHereTweenedObjects", "Train", "Object", "ObjectModel"}, color = Color3.fromRGB(255, 150, 50)},
            {path = {"Workspace", "Map", "AlwaysHereTweenedObjects", "LrgDebris", "Object", "ObjectModel"}, color = Color3.fromRGB(255, 255, 100)},
            {path = {"Workspace", "Map", "AlwaysHereTweenedObjects", "LrgDebris2", "Object", "ObjectModel"}, color = Color3.fromRGB(200, 100, 255)},
        }
        local function highlightPath(path, color)
            local cur = game
            for _, name in ipairs(path) do
                if cur == game and name == "Workspace" then cur = Workspace
                else cur = cur:FindFirstChild(name) end
                if not cur then return end
            end
            for _, part in ipairs(cur:GetDescendants()) do
                if part:IsA("BasePart") and not part:FindFirstChild("HighlightObj_HL") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "HighlightObj_HL"
                    hl.FillColor = color
                    hl.OutlineColor = color:Lerp(Color3.new(0,0,0), 0.3)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = part
                end
            end
        end
        for _, t in ipairs(targets) do highlightPath(t.path, t.color) end
    end,
})
