--[[ Raycast 自瞄 ]]--
local S_OriginalRaycast = nil
local S_RaycastModule = nil
task.spawn(function()
    pcall(function()
        local lp = Players.LocalPlayer
        local rm = require(lp.PlayerScripts:WaitForChild("RaycastModule"))
        S_RaycastModule = rm
        S_OriginalRaycast = rm.RaycastFromCam
        local function getTarget(maxDist, maxFov)
            local cam = workspace.CurrentCamera
            local camPos = cam.CFrame.Position
            local camLook = cam.CFrame.LookVector
            local best = nil
            local bestAngle = maxFov or 80
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character then
                    if S.AimMode == "指定玩家" and S.AimTarget and p.Name ~= S.AimTarget then
                        continue
                    end
                    local r2 = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("Head")
                    local h2 = p.Character:FindFirstChildOfClass("Humanoid")
                    if r2 and h2 and h2.Health > 0 then
                        local offset = r2.Position - camPos
                        local dist = offset.Magnitude
                        if dist <= (maxDist or 50) then
                            local dot = camLook:Dot(offset.Unit)
                            local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
                            if angle < bestAngle then
                                bestAngle = angle
                                best = r2
                            end
                        end
                    end
                end
            end
            return best
        end
        rm.RaycastFromCam = function(p1, p2)
            if not S.SilentAim then return S_OriginalRaycast(p1, p2) end
            local target = getTarget(50, 80)
            if target then
                local cam = workspace.CurrentCamera
                local camPos = cam.CFrame.Position
                local dir = (target.Position - camPos).Unit * 55
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {lp.Character}
                params.IgnoreWater = true
                local hit = workspace:Raycast(camPos, dir, params)
                if hit and hit.Instance and hit.Instance:IsDescendantOf(target.Parent) then
                    return hit, hit.Instance.CFrame:ToObjectSpace(CFrame.new(hit.Position))
                end
            end
            return S_OriginalRaycast(p1, p2)
        end
    end)
end)

--[[ Anti Explosion ]]--
local function setupAntiExplosion(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end
    if T.antiExplosionConnection then T.antiExplosionConnection:Disconnect() end
    T.antiExplosionConnection = Workspace.ChildAdded:Connect(function(model)
        if not S.AntiExplosion then return end
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not r then return end
        if model:IsA("BasePart") and (model.Position - r.Position).Magnitude <= 20 then
            if h.SeatPart ~= nil then
                r.Anchored = true
                task.wait(0.03)
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
                r.Anchored = false
            else
                r.Anchored = true
                task.wait()
                h:ChangeState(Enum.HumanoidStateType.Running)
                r.Anchored = false
                h.AutoRotate = true
                for _, limb in ipairs(c:GetDescendants()) do
                    if limb:IsA("BasePart") and limb.Name == "RagdollLimbPart" then
                        limb.CanCollide = false
                    end
                end
            end
        end
    end)
end

--[[ 反击 ]]--
local function startFightBack()
    if T.fightBackConn then task.cancel(T.fightBackConn) T.fightBackConn = nil end
    T.fightBackConn = task.spawn(function()
        while S.FightBack do
            local c = LocalPlayer.Character
            if c and c:FindFirstChild("Head") then
                local head = c.Head
                local partOwner = head:FindFirstChild("PartOwner")
                if partOwner and partOwner.Value ~= "" then
                    local attacker = Players:FindFirstChild(partOwner.Value)
                    if attacker and attacker.Character then
                        pcall(function()
                            Struggle:FireServer()
                            local ac = attacker.Character
                            local hrp = ac:FindFirstChild("HumanoidRootPart")
                            local targetPart = ac:FindFirstChild("Torso") or ac:FindFirstChild("UpperTorso") or ac:FindFirstChild("Head")
                            if not hrp then return end
                            local mode = S.FightBackMode
                            if mode == "击杀" then
                                if targetPart then
                                    SetOwner:FireServer(targetPart, targetPart.CFrame)
                                    task.wait()
                                    local existingVel = targetPart:FindFirstChild("l")
                                    if not existingVel then
                                        local velocity = Instance.new("BodyVelocity")
                                        velocity.Name = "l"
                                        velocity.Velocity = Vector3.new(0, 2000, 0)
                                        velocity.MaxForce = Vector3.new(0, math.huge, 0)
                                        velocity.Parent = targetPart
                                        Debris:AddItem(velocity, 0.5)
                                    end
                                end
                            elseif mode == "踢出" then
                                SetOwner:FireServer(hrp, hrp.CFrame)
                                task.wait()
                                DestroyLine:FireServer(hrp)
                                task.wait()
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 2000, 0)
                                local bv = Instance.new("BodyVelocity")
                                bv.MaxForce = Vector3.one * math.huge
                                bv.Velocity = Vector3.new(math.random(-100, 100), 2000, math.random(-100, 100))
                                bv.Parent = hrp
                                Debris:AddItem(bv, 0.5)
                                task.wait(0.05)
                                DestroyLine:FireServer(hrp)
                            elseif mode == "虚空" then
                                SetOwner:FireServer(hrp, hrp.CFrame)
                                task.wait()
                                DestroyLine:FireServer(hrp)
                                task.wait()
                                hrp.AssemblyLinearVelocity = Vector3.new(0, -5000, 0)
                                local bv = Instance.new("BodyVelocity")
                                bv.MaxForce = Vector3.one * math.huge
                                bv.Velocity = Vector3.new(0, -5000, 0)
                                bv.Parent = hrp
                                Debris:AddItem(bv, 0.8)
                            elseif mode == "上天" then
                                SetOwner:FireServer(hrp, hrp.CFrame)
                                task.wait()
                                DestroyLine:FireServer(hrp)
                                task.wait()
                                local bv = Instance.new("BodyVelocity")
                                bv.MaxForce = Vector3.one * math.huge
                                bv.Velocity = Vector3.new(0, 5000, 0)
                                bv.Parent = hrp
                                Debris:AddItem(bv, 1.5)
                                local bp = Instance.new("BodyPosition")
                                bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                                bp.P = 4e7
                                bp.Position = hrp.Position + Vector3.new(0, 5000, 0)
                                bp.Parent = hrp
                                Debris:AddItem(bp, 2)
                            end
                        end)
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end
local function stopFightBack()
