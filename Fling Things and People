local function m_ragdollAttack(name)
    local pallet = _G.PermanentPallet
    if not pallet or not pallet.enabled or not pallet.currentPallet then
        m_notify("Ragdoll Method", "PERMANENT PALLET NEEDED", 5); return
    end
