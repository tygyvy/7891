                                        velocity.MaxForce = Vector3.new(0, math.huge, 0)
                                        velocity.Parent = targetPart
                                        Debris:AddItem(velocity, 0.5)
                                    end
                                end
                            elseif mode == "踢出" then
                                SetOwner:FireServer(hrp, hrp.CFrame)
                                task.wait()
                                DestroyLine:FireServer(hrp)
                                task.wait()
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 2000, 0)
