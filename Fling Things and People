local function startFightBack()
    if T.fightBackConn then task.cancel(T.fightBackConn) T.fightBackConn = nil end
    T.fightBackConn = task.spawn(function()
        while S.FightBack do
            local c = LocalPlayer.Character
            if c and c:FindFirstChild("Head") then
                local head = c.Head
                local partOwner = head:FindFirstChild("PartOwner")
                if partOwner and partOwner.Value ~= "" then
                    local attacker = Players:FindFirstChild(partOwner.Value)
                    if attacker and attacker.Character then
                        pcall(function()
                            Struggle:FireServer()
                            local ac = attacker.Character
                            local hrp = ac:FindFirstChild("HumanoidRootPart")
                            local targetPart = ac:FindFirstChild("Torso") or ac:FindFirstChild("UpperTorso") or ac:FindFirstChild("Head")
                            if not hrp then return end
                            local mode = S.FightBackMode
                            if mode == "击杀" then
                                if targetPart then
                                    SetOwner:FireServer(targetPart, targetPart.CFrame)
                                    task.wait()
                                    local existingVel = targetPart:FindFirstChild("l")
                                    if not existingVel then
                                        local velocity = Instance.new("BodyVelocity")
                                        velocity.Name = "l"
                                        velocity.Velocity = Vector3.new(0, 2000, 0)
                                        velocity.MaxForce = Vector3.new(0, math.huge, 0)
                                        velocity.Parent = targetPart
                                        Debris:AddItem(velocity, 0.5)
                                    end
                                end
                            elseif mode == "踢出" then
                                SetOwner:FireServer(hrp, hrp.CFrame)
                                task.wait()
                                DestroyLine:FireServer(hrp)
                                task.wait()
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 2000, 0)
                                local bv = Instance.new("BodyVelocity")
                                bv.MaxForce = Vector3.one * math.huge
                                bv.Velocity = Vector3.new(math.random(-100, 100), 2000, math.random(-100, 100))
                                bv.Parent = hrp
                                Debris:AddItem(bv, 0.5)
                                task.wait(0.05)
                                DestroyLine:FireServer(hrp)
                            elseif mode == "虚空" then
                                SetOwner:FireServer(hrp, hrp.CFrame)
                                task.wait()
                                DestroyLine:FireServer(hrp)
                                task.wait()
                                hrp.AssemblyLinearVelocity = Vector3.new(0, -5000, 0)
                                local bv = Instance.new("BodyVelocity")
                                bv.MaxForce = Vector3.one * math.huge
                                bv.Velocity = Vector3.new(0, -5000, 0)
                                bv.Parent = hrp
                                Debris:AddItem(bv, 0.8)
                            elseif mode == "上天" then
                                SetOwner:FireServer(hrp, hrp.CFrame)
                                task.wait()
                                DestroyLine:FireServer(hrp)
                                task.wait()
                                local bv = Instance.new("BodyVelocity")
                                bv.MaxForce = Vector3.one * math.huge
                                bv.Velocity = Vector3.new(0, 5000, 0)
                                bv.Parent = hrp
                                Debris:AddItem(bv, 1.5)
                                local bp = Instance.new("BodyPosition")
                                bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                                bp.P = 4e7
                                bp.Position = hrp.Position + Vector3.new(0, 5000, 0)
                                bp.Parent = hrp
                                Debris:AddItem(bp, 2)
                            end
                        end)
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end
