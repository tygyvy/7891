--[[ 工具函数 ]]--
local function char() return LocalPlayer.Character end
local function hum() local c = char() return c and c:FindFirstChildOfClass("Humanoid") end
local function root() local c = char() return c and c:FindFirstChild("HumanoidRootPart") end
local function plist()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then t[#t+1] = p.DisplayName .. " @" .. p.Name end
    end
    return t
end
local function GetPlayerCharacter()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChildOfClass("Humanoid") then return c end
end
local function auraGetRoot()
    local c = LocalPlayer.Character
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end
local function auraSetNetworkOwner(part)
    pcall(function() SetOwner:FireServer(part, auraGetRoot().CFrame) end)
end
local function auraBodyVelocity(part, vel, lifetime)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.one * math.huge
    bv.Velocity = vel
    bv.Parent = part
    Debris:AddItem(bv, lifetime or 1)
end
local function auraPlayerAllowed(player)
    if not S.AuraPlayerSelect then return true end
    return player and S.AuraTargetName and player.Name == S.AuraTargetName
end
local function grabKickPlayerAllowed(player)
    if not S.grabKickSelectEnabled then return true end
    if not player then return false end
    for name, v in pairs(S.grabKickSelected) do
        if v and name == player.Name then return true end
    end
    return false
end

--[[ 第三人称 ]]--
local function enableThirdPerson()
    S.ThirdPerson = true
    LocalPlayer.CameraMode = Enum.CameraMode.Classic
    LocalPlayer.CameraMinZoomDistance = 2
    LocalPlayer.CameraMaxZoomDistance = 128
    if T.thirdPersonConn then T.thirdPersonConn:Disconnect() end
    T.thirdPersonConn = RunService.RenderStepped:Connect(function()
        if not S.ThirdPerson then return end
        local now = tick()
        if T._tpLast and now - T._tpLast < 0.05 then return end
        T._tpLast = now
        local c = LocalPlayer.Character
        if not c or not c:FindFirstChild("HumanoidRootPart") then return end
        local bodyParts = {"Head", "Torso", "UpperTorso", "LowerTorso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot"}
        for _, name in ipairs(bodyParts) do
            local part = c:FindFirstChild(name)
            if part and part:IsA("BasePart") and part.Transparency > 0 then part.Transparency = 0 end
        end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Transparency = 1 end
        for _, partName in ipairs(bodyParts) do
            local part = c:FindFirstChild(partName)
            if part then
                for _, child in pairs(part:GetChildren()) do
                    if child:IsA("Decal") and child.Transparency > 0 then child.Transparency = 0 end
                end
            end
        end
        for _, acc in pairs(c:GetChildren()) do
            if acc:IsA("Accessory") then
                local handle = acc:FindFirstChild("Handle")
                if handle and handle.Transparency > 0 then handle.Transparency = 0 end
            end
        end
    end)
end
local function disableThirdPerson()
    S.ThirdPerson = false
    LocalPlayer.CameraMode = Enum.CameraMode.Classic
    LocalPlayer.CameraMinZoomDistance = 0.5
    LocalPlayer.CameraMaxZoomDistance = 0.5
    if T.thirdPersonConn then T.thirdPersonConn:Disconnect() T.thirdPersonConn = nil end
end

--[[ 防抓取 v2 ]]--
local function enableAntiGrabV2()
    if T.antiGrabV2Conn then T.antiGrabV2Conn:Disconnect() end
    T.struggleTasks = {}
    local function startStruggleLoop()
        local c = char()
        if not c or T.struggleTasks[c] then return end
        T.struggleTasks[c] = true
        task.spawn(function()
            while T.struggleTasks[c] do
                local head = c:FindFirstChild("Head")
                if head and head:FindFirstChild("PartOwner") and IsHeld and IsHeld.Value then
                    pcall(function()
                        Struggle:FireServer()
                        local gce = ReplicatedStorage:FindFirstChild("GameCorrectionEvents")
                        if gce then
                            local sav = gce:FindFirstChild("StopAllVelocity")
                            if sav then sav:FireServer() end
                        end
                    end)
                else
                    T.struggleTasks[c] = nil
                    break
                end
                task.wait(0.1)
            end
        end)
    end
    local lastCheck = 0
    T.antiGrabV2Conn = RunService.Heartbeat:Connect(function()
        local now = tick()
        if now - lastCheck < 0.04 then return end
        lastCheck = now
        local c = char()
        if c and c:FindFirstChild("Head") then
            local head = c.Head
            if head:FindFirstChild("PartOwner") and IsHeld and IsHeld.Value then
                startStruggleLoop()
            end
        end
    end)
end
local function disableAntiGrabV2()
    if T.antiGrabV2Conn then
        T.antiGrabV2Conn:Disconnect()
        T.antiGrabV2Conn = nil
    end
    if T.struggleTasks then
        for k in pairs(T.struggleTasks) do
            T.struggleTasks[k] = nil
        end
    end
end

