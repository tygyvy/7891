local vfSpeed = 5
local vfActive = false
local vfConn1, vfConn2 = nil, nil
local vfTable = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
local vfLast = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
local vfMag = 0

local function vfGetHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function vfStop()
    vfActive = false
    if vfConn1 then vfConn1:Disconnect(); vfConn1 = nil end
    if vfConn2 then vfConn2:Disconnect(); vfConn2 = nil end
    local c = LocalPlayer.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h then h.PlatformStand = false end
    end
    pcall(function() Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end)
end

local function vfStart()
    local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then
        repeat task.wait() until c:FindFirstChildOfClass("Humanoid")
        h = c:FindFirstChildOfClass("Humanoid")
    end
    if vfConn1 then vfConn1:Disconnect() end
    if vfConn2 then vfConn2:Disconnect() end
    local hrp = vfGetHRP()
    if not hrp then return end
    vfTable = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
    vfLast = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
    vfMag = 0
    vfActive = true

    local bg = Instance.new("BodyGyro")
    local bv = Instance.new("BodyVelocity")
    bg.P = 90000
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = hrp.CFrame
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bg.Parent = hrp
    bv.Parent = hrp

    task.spawn(function()
        while vfActive do
            task.wait()
            local cam = Workspace.CurrentCamera
            if h then h.PlatformStand = true end
            if vfTable.L + vfTable.R ~= 0 or vfTable.F + vfTable.B ~= 0 or vfTable.Q + vfTable.E ~= 0 then
                vfMag = 50
            elseif vfMag ~= 0 then
                vfMag = 0
            end
            if vfTable.L + vfTable.R ~= 0 or vfTable.F + vfTable.B ~= 0 or vfTable.Q + vfTable.E ~= 0 then
                local p = cam.CFrame.p
                bv.Velocity = (cam.CFrame.LookVector * (vfTable.F + vfTable.B) + cam.CFrame * CFrame.new(vfTable.L + vfTable.R, (vfTable.F + vfTable.B + vfTable.Q + vfTable.E) * 0.2, 0).p - p) * vfMag
                vfLast = { F = vfTable.F, B = vfTable.B, L = vfTable.L, R = vfTable.R }
            elseif vfMag ~= 0 then
                local p = cam.CFrame.p
                bv.Velocity = (cam.CFrame.LookVector * (vfLast.F + vfLast.B) + cam.CFrame * CFrame.new(vfLast.L + vfLast.R, (vfLast.F + vfLast.B + vfTable.Q + vfTable.E) * 0.2, 0).p - p) * vfMag
            else
                bv.Velocity = Vector3.zero
            end
            bg.CFrame = cam.CFrame
            if not vfActive then break end
        end
        vfTable = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
        vfLast = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
        vfMag = 0
        bg:Destroy()
        bv:Destroy()
        if h then h.PlatformStand = false end
    end)

    vfConn1 = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then vfTable.F = vfSpeed
        elseif input.KeyCode == Enum.KeyCode.S then vfTable.B = -vfSpeed
        elseif input.KeyCode == Enum.KeyCode.A then vfTable.L = -vfSpeed
        elseif input.KeyCode == Enum.KeyCode.D then vfTable.R = vfSpeed
        elseif input.KeyCode == Enum.KeyCode.E then vfTable.Q = vfSpeed * 2
        elseif input.KeyCode == Enum.KeyCode.Q then vfTable.E = -vfSpeed * 2
        end
        pcall(function() Workspace.CurrentCamera.CameraType = Enum.CameraType.Track end)
    end)

    vfConn2 = UserInputService.InputEnded:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then vfTable.F = 0
        elseif input.KeyCode == Enum.KeyCode.S then vfTable.B = 0
        elseif input.KeyCode == Enum.KeyCode.A then vfTable.L = 0
        elseif input.KeyCode == Enum.KeyCode.D then vfTable.R = 0
        elseif input.KeyCode == Enum.KeyCode.E then vfTable.Q = 0
        elseif input.KeyCode == Enum.KeyCode.Q then vfTable.E = 0
        end
    end)
end

