    distLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLbl.TextStrokeTransparency = 0.3
    distLbl.Font = Enum.Font.GothamBold
    distLbl.TextSize = 12
    distLbl.Visible = S.espShowDistance
    distLbl.Parent = bb

    local tracer = Instance.new("Beam")
    tracer.Name = "Tracer"
