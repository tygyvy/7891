-- 九、载具飞行
local flag7 = false
local n25 = 5
local fn12, fn13
local flag8_fly = false
local connection_fly = nil
local connection2_fly = nil
local flag9_fly = false
local function fn14_fly(arg) return arg and arg:FindFirstChild("HumanoidRootPart") end
local function fn15_fly(arg)
    if arg then
        arg.Velocity = v32(0, 0, 0)
        arg.AssemblyLinearVelocity = v32(0, 0, 0)
        arg.RotVelocity = v32(0, 0, 0)
        arg.AssemblyAngularVelocity = v32(0, 0, 0)
    end
end
local function fn16_fly()
    flag9_fly = false
    if connection_fly then connection_fly:Disconnect(); connection_fly = nil end
    if connection2_fly then connection2_fly:Disconnect(); connection2_fly = nil end
    local chr = lp.Character
    if chr then
        local hum = chr:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end)
end
local function fn17_fly(arg)
    local character = lp.Character or lp.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        repeat task.wait() until character:FindFirstChildOfClass("Humanoid")
        humanoid = character:FindFirstChildOfClass("Humanoid")
    end
    if connection_fly then connection_fly:Disconnect() end
    if connection2_fly then connection2_fly:Disconnect() end
    local hrp = fn14_fly(character)
    local tbl5 = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
    local tbl6 = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
    local n26 = 0
    local function startFly()
        flag9_fly = true
        local bodyGyro = Instance.new("BodyGyro")
        local bodyVelocity_ = Instance.new("BodyVelocity")
        bodyGyro.P = 90000
        bodyGyro.Parent = hrp
        bodyVelocity_.Parent = hrp
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.CFrame = hrp.CFrame
        bodyVelocity_.Velocity = Vector3.zero
        bodyVelocity_.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        task.spawn(function()
            while true do
                task.wait()
                local cam = workspace.CurrentCamera
                if not arg and humanoid then humanoid.PlatformStand = true end
                if tbl5.L + tbl5.R ~= 0 or tbl5.F + tbl5.B ~= 0 or tbl5.Q + tbl5.E ~= 0 then
                    n26 = 50
                elseif not (tbl5.L + tbl5.R ~= 0 or tbl5.F + tbl5.B ~= 0 or tbl5.Q + tbl5.E ~= 0) and n26 ~= 0 then
                    n26 = 0
                end
                if tbl5.L + tbl5.R ~= 0 or tbl5.F + tbl5.B ~= 0 or tbl5.Q + tbl5.E ~= 0 then
                    local p = cam.CFrame.p
                    bodyVelocity_.Velocity = (cam.CFrame.LookVector * (tbl5.F + tbl5.B) + cam.CFrame * CFrame.new(tbl5.L + tbl5.R, (tbl5.F + tbl5.B + tbl5.Q + tbl5.E) * 0.2, 0).p - p) * n26
                    tbl6 = { F = tbl5.F, B = tbl5.B, L = tbl5.L, R = tbl5.R }
                elseif tbl5.L + tbl5.R == 0 and tbl5.F + tbl5.B == 0 and tbl5.Q + tbl5.E == 0 and n26 ~= 0 then
                    local p = cam.CFrame.p
                    bodyVelocity_.Velocity = (cam.CFrame.LookVector * (tbl6.F + tbl6.B) + cam.CFrame * CFrame.new(tbl6.L + tbl6.R, (tbl6.F + tbl6.B + tbl5.Q + tbl5.E) * 0.2, 0).p - p) * n26
                else
                    bodyVelocity_.Velocity = Vector3.zero
                end
                bodyGyro.CFrame = cam.CFrame
                if flag9_fly then continue end
                break
            end
            tbl5 = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
            tbl6 = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
            n26 = 0
            bodyGyro:Destroy()
            bodyVelocity_:Destroy()
            if humanoid then humanoid.PlatformStand = false end
        end)
    end
    connection_fly = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then tbl5.F = arg and n25 or 1
        elseif input.KeyCode == Enum.KeyCode.S then tbl5.B = -(arg and n25 or 1)
        elseif input.KeyCode == Enum.KeyCode.A then tbl5.L = -(arg and n25 or 1)
        elseif input.KeyCode == Enum.KeyCode.D then tbl5.R = arg and n25 or 1
        elseif input.KeyCode == Enum.KeyCode.E then tbl5.Q = (arg and n25 or 1) * 2
        elseif input.KeyCode == Enum.KeyCode.Q then tbl5.E = -(arg and n25 or 1) * 2
        end
        pcall(function() cam.CameraType = Enum.CameraType.Track end)
    end)
    connection2_fly = UserInputService.InputEnded:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then tbl5.F = 0
        elseif input.KeyCode == Enum.KeyCode.S then tbl5.B = 0
        elseif input.KeyCode == Enum.KeyCode.A then tbl5.L = 0
        elseif input.KeyCode == Enum.KeyCode.D then tbl5.R = 0
        elseif input.KeyCode == Enum.KeyCode.E then tbl5.Q = 0
        elseif input.KeyCode == Enum.KeyCode.Q then tbl5.E = 0
        end
    end)
    startFly()
end
fn12 = function()
    if flag7 then return end
    flag7 = true
    flag8_fly = true
    fn16_fly()
    task.wait()
