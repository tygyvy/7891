local function m_hideItem(item)
    if not item then return end
    for _, d in ipairs(item:GetDescendants()) do
        if d:IsA("BasePart") then pcall(function() d.CanCollide = false; d.CanQuery = false end) end
    end
end
local function m_destroyItem(item)
    if m_DestroyRemote then pcall(function() m_DestroyRemote:FireServer(item) end) end
end
local function m_nearPlayer(pos, radius)
    for _, p in ipairs(MercuryPlayers:GetPlayers()) do
        if p ~= m_lp then
            local chr = p.Character
            local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - pos).Magnitude < radius then return p end
        end
    end
    return nil
end
local function m_stealNotify(player, itemName)
    m_notify("Anti-Input Theft!", player.DisplayName .. " stole your " .. (m_inputItems[itemName] or itemName) .. "!", 4)
end
local function m_watchTheft()
    if m_AntiInput.watchThread then task.cancel(m_AntiInput.watchThread) end
    m_AntiInput.watchThread = task.spawn(function()
        local lastItem, lastPos
        while m_AntiInput.enabled do
            task.wait(m_AntiInput.theftInterval)
            local folder = m_getSpawnFolder()
            local item = folder and folder:FindFirstChild(m_AntiInput.selectedItem)
            if not item then
                lastItem = nil; lastPos = nil
            else
                lastPos = item:FindFirstChild("HoldPart")
                lastPos = lastPos and lastPos.Position or item:GetPivot().Position
                if lastItem == item then
                    local prevPos = lastPos
                    if prevPos and (lastPos - prevPos).Magnitude > 0 then
                        local p = m_nearPlayer(lastPos, 6)
                        if p then m_stealNotify(p, item.Name); m_destroyItem(item); lastItem=nil; lastPos=nil end
                    end
                else
                    local p = m_nearPlayer(lastPos, 3)
                    if p then m_stealNotify(p, item.Name); m_destroyItem(item); lastItem=nil; lastPos=nil end
                end
                lastItem = item
            end
        end
    end)
end
local function m_cleanupItems()
    local folder = m_getSpawnFolder()
    if not folder then return end
    for _, c in ipairs(folder:GetChildren()) do
        if m_inputItems[c.Name] then m_destroyItem(c) end
    end
end
local function m_keepOnlySelected()
    local folder = m_getSpawnFolder()
    if not folder then return end
    for _, c in ipairs(folder:GetChildren()) do
        if m_inputItems[c.Name] and c.Name ~= m_AntiInput.selectedItem then m_destroyItem(c) end
    end
end
local function m_startAntiInput()
    m_cleanupItems()
    m_keepOnlySelected()
    m_watchTheft()
    m_AntiInput.loopThread = task.spawn(function()
        local folder = m_getSpawnFolder()
        local current = nil
        local lastSpawn = 0
        while m_AntiInput.enabled do
            task.wait()
            local chr = m_lp.Character
            local hum = chr and chr:FindFirstChild("Humanoid")
            local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
            if not chr or not hum or not hrp or hum.Health <= 0 then
                current = nil
            else
                if not folder or not folder.Parent then folder = m_getSpawnFolder() end
                if not folder then
                    current = nil
                else
                    local item = folder:FindFirstChild(m_AntiInput.selectedItem)
                    if not item then
                        if tick() - lastSpawn >= m_AntiInput.spawnCooldown then
                            task.spawn(function()
                                pcall(function()
                                    m_SpawnRemote:InvokeServer(m_AntiInput.selectedItem, hrp.CFrame * m_cf(0,100,20), m_v32(0,0,0))
                                end)
                            end)
                            lastSpawn = tick()
                        end
                        current = nil
                    else
                        if item ~= current then m_hideItem(item); current = item end
                        local hold = item:FindFirstChild("HoldPart")
                        if hold then
                            local holdFn = hold:FindFirstChild("HoldItemRemoteFunction")
                            local dropFn = hold:FindFirstChild("DropItemRemoteFunction")
                            if holdFn and dropFn then
                                task.spawn(function()
                                    pcall(function() holdFn:InvokeServer(item, chr) end)
                                end)
                                task.wait(m_AntiInput.holdTime)
                                task.spawn(function()
                                    pcall(function()
                                        dropFn:InvokeServer(item, hrp.CFrame * m_cf(0,1000,0), m_v32(0,0,0))
                                    end)
                                end)
                                task.wait()
                            end
                        end
                    end
                end
            end
        end
    end)
end
local function m_stopAntiInput()
    if m_AntiInput.loopThread then task.cancel(m_AntiInput.loopThread); m_AntiInput.loopThread = nil end
    if m_AntiInput.watchThread then task.cancel(m_AntiInput.watchThread); m_AntiInput.watchThread = nil end
    m_cleanupItems()
end

