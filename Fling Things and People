        local dragAttach = dragPart and dragPart:FindFirstChild("DragAttach")
        if dragAttach then
            dragAttach.Position = Workspace.CurrentCamera.CFrame.LookVector * infZoomValue
        end
    end
    local function startInfZoomLoop()
        if infZoomLoop then return end
        infZoomLoop = RunService.RenderStepped:Connect(function()
            if not S.InfZoom then return end
            applyInfZoom()
        end)
    end
    local function stopInfZoom()
        if infZoomConn1 then infZoomConn1:Disconnect() infZoomConn1 = nil end
        if infZoomConn2 then infZoomConn2:Disconnect() infZoomConn2 = nil end
        if infZoomLoop then infZoomLoop:Disconnect() infZoomLoop = nil end
        infZoomValue = 0
    end
    grabDebugSec:AddToggle("InfZoom", {
        Text = "无限缩放（滚轮拉远）",
        Default = false,
        Callback = function(v)
            S.InfZoom = v
            if v then
                infZoomValue = 0
                infZoomConn1 = UserInputService.InputChanged:Connect(function(input)
                    if not S.InfZoom then return end
                    if input.UserInputType == Enum.UserInputType.MouseWheel then
                        if Workspace:FindFirstChild("GrabParts") then
                            if input.Position.Z > 0 then
                                infZoomValue = math.min(infZoomValue + S.InfZoomSpeed, S.InfZoomMax)
                            else
                                infZoomValue = math.max(infZoomValue - S.InfZoomSpeed, 0)
                            end
                        else
                            infZoomValue = 0
                        end
                    end
                end)
                infZoomConn2 = Workspace.ChildAdded:Connect(function(child)
                    if not S.InfZoom then return end
                    if child.Name == "GrabParts" then
                        infZoomValue = 0
                    end
                end)
                startInfZoomLoop()
                applyInfZoom()
            else
                stopInfZoom()
            end
        end,
    })
    grabDebugSec:AddSlider("InfZoomSpeed", {
        Text = "缩放速度", Default = 1.5, Min = 0.5, Max = 10, Rounding = 1,
        Callback = function(v) S.InfZoomSpeed = v end,
    })
    grabDebugSec:AddSlider("InfZoomMax", {
        Text = "最大缩放距离", Default = 500, Min = 10, Max = 1000, Rounding = 0,
        Callback = function(v) S.InfZoomMax = v end,
    })
end

