local function m_counterScan()
    local chr = m_lp.Character
    if not chr then return end
    local parts = {
        chr:FindFirstChild("HumanoidRootPart"),
        chr:FindFirstChild("Head"),
        chr:FindFirstChild("Torso") or chr:FindFirstChild("UpperTorso"),
        chr:FindFirstChild("Left Arm"), chr:FindFirstChild("Right Arm"),
        chr:FindFirstChild("Left Leg"), chr:FindFirstChild("Right Leg"),
    }
    for _, part in ipairs(parts) do
        if part then
            local owner = m_getOwnerName(part)
            if owner then
                if m_CounterAttack.method == "Ownership" then m_ownershipAttack(owner)
                elseif m_CounterAttack.method == "Void" then m_voidAttack(owner)
                elseif m_CounterAttack.method == "Ragdoll" then m_ragdollAttack(owner) end
            end
        end
    end
    local isHeld = m_lp:FindFirstChild("IsHeld")
    if isHeld and isHeld.Value == true then
        local gp = m_ws:FindFirstChild("GrabParts")
        local gp2 = gp and gp:FindFirstChild("GrabPart")
        local owner = gp2 and m_getOwnerName(gp2)
        if owner then
            if m_CounterAttack.method == "Ownership" then m_ownershipAttack(owner)
            elseif m_CounterAttack.method == "Void" then m_voidAttack(owner)
            elseif m_CounterAttack.method == "Ragdoll" then m_ragdollAttack(owner) end
        end
    end
end
local function m_startCounter(method)
    m_CounterAttack.method = method or m_CounterAttack.method
    if m_CounterAttack.enabled then return end
    m_CounterAttack.enabled = true
    m_CounterAttack.thread = task.spawn(function()
        while m_CounterAttack.enabled do pcall(m_counterScan); task.wait() end
    end)
end
local function m_stopCounter()
    m_CounterAttack.enabled = false
    if m_CounterAttack.thread then task.cancel(m_CounterAttack.thread); m_CounterAttack.thread = nil end
end

-- ---------- 十三、Auto Break Barrier ----------
local m_AutoBreakBarrier = { enabled = false, thread = nil }
local m_breakSpot = m_cf(-491, -7, -166)
local function m_autoBreakBarrierLoop()
    while m_AutoBreakBarrier.enabled do
        local chr = m_lp.Character
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        if not hrp then break end
        local folder = m_ws:FindFirstChild(m_lp.Name .. "SpawnedInToys")
        if not folder then break end
        if not m_CanSpawn or m_CanSpawn.Value then
            task.spawn(function()
                pcall(function() m_SpawnRemote:InvokeServer("FoodHamburger", m_breakSpot, m_v32(0,0,0)) end)
            end)
            task.wait(0.3)
            local burger = folder:FindFirstChild("FoodHamburger")
            if burger then
                local hold = burger:FindFirstChild("HoldPart")
                local holdFn = hold and hold:FindFirstChild("HoldItemRemoteFunction")
                if holdFn then pcall(function() holdFn:InvokeServer(burger, chr) end) end
                task.wait(0.1)
                local saved = hrp.CFrame
                hrp.CFrame = m_breakSpot
                hrp.AssemblyLinearVelocity = Vector3.zero
                task.wait(0.1)
                if burger.Parent then pcall(function() m_DestroyRemote:FireServer(burger) end) end
                task.wait(0.1)
                hrp.CFrame = saved
                hrp.AssemblyLinearVelocity = Vector3.zero
                m_AutoBreakBarrier.enabled = false
                m_notify("Barrier broken", "", 3)
                break
            end
        end
        task.wait(0.2)
    end
    m_AutoBreakBarrier.thread = nil
end
local function m_startAutoBreakBarrier()
    if m_AutoBreakBarrier.enabled then return end
    m_AutoBreakBarrier.enabled = true
    m_AutoBreakBarrier.thread = task.spawn(m_autoBreakBarrierLoop)
end
local function m_stopAutoBreakBarrier()
    m_AutoBreakBarrier.enabled = false
    if m_AutoBreakBarrier.thread then task.cancel(m_AutoBreakBarrier.thread); m_AutoBreakBarrier.thread = nil end
end

-- ---------- 十四、Defend Friend ----------
local m_DefendFriend = { target = nil, busy = false }
local function m_defendFriend(friend)
    if not friend or not friend.Character then
        m_notify("Defend", "Friend has no character", 2); return
    end
    local chr = friend.Character
    local torso = chr:FindFirstChild("Torso") or chr:FindFirstChild("UpperTorso") or chr:FindFirstChild("HumanoidRootPart")
    if not torso then return end
    local myChr = m_lp.Character
    local myHead = myChr and myChr:FindFirstChild("Head")
    if not myHead then return end
    m_waitCanSpawn()
    local folder = m_ws:FindFirstChild(m_lp.Name .. "SpawnedInToys")
    local before = {}
    if folder then
        for _, c in ipairs(folder:GetChildren()) do
            if c.Name == "NinjaShuriken" then before[c] = true end
        end
    end
    task.spawn(function()
        pcall(function() m_SpawnRemote:InvokeServer("NinjaShuriken", myHead.CFrame * m_cf(0,15,20), m_v32(0,0,0)) end)
    end)
    local t = tick()
    while tick() - t < 3 do
        folder = m_ws:FindFirstChild(m_lp.Name .. "SpawnedInToys")
