--[[ Raycast 自瞄 ]]--
local S_OriginalRaycast = nil
local S_RaycastModule = nil
task.spawn(function()
    pcall(function()
        local lp = Players.LocalPlayer
        local rm = require(lp.PlayerScripts:WaitForChild("RaycastModule"))
        S_RaycastModule = rm
        S_OriginalRaycast = rm.RaycastFromCam
        local function getTarget(maxDist, maxFov)
            local cam = workspace.CurrentCamera
            local camPos = cam.CFrame.Position
            local camLook = cam.CFrame.LookVector
            local best = nil
            local bestAngle = maxFov or 80
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character then
                    if S.AimMode == "指定玩家" and S.AimTarget and p.Name ~= S.AimTarget then
                        continue
                    end
                    local r2 = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("Head")
                    local h2 = p.Character:FindFirstChildOfClass("Humanoid")
                    if r2 and h2 and h2.Health > 0 then
                        local offset = r2.Position - camPos
                        local dist = offset.Magnitude
                        if dist <= (maxDist or 50) then
                            local dot = camLook:Dot(offset.Unit)
                            local angle = math.deg(math.acos(math.clamp(dot, -1, 1)))
                            if angle < bestAngle then
                                bestAngle = angle
                                best = r2
                            end
                        end
                    end
                end
            end
            return best
        end
        rm.RaycastFromCam = function(p1, p2)
            if not S.SilentAim then return S_OriginalRaycast(p1, p2) end
            local target = getTarget(50, 80)
            if target then
                local cam = workspace.CurrentCamera
                local camPos = cam.CFrame.Position
                local dir = (target.Position - camPos).Unit * 55
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = {lp.Character}
                params.IgnoreWater = true
                local hit = workspace:Raycast(camPos, dir, params)
                if hit and hit.Instance and hit.Instance:IsDescendantOf(target.Parent) then
                    return hit, hit.Instance.CFrame:ToObjectSpace(CFrame.new(hit.Position))
                end
            end
            return S_OriginalRaycast(p1, p2)
        end
    end)
end)

--[[ Anti Explosion ]]--
local function setupAntiExplosion(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not hrp then return end
    if T.antiExplosionConnection then T.antiExplosionConnection:Disconnect() end
    T.antiExplosionConnection = Workspace.ChildAdded:Connect(function(model)
        if not S.AntiExplosion then return end
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not r then return end
        if model:IsA("BasePart") and (model.Position - r.Position).Magnitude <= 20 then
            if h.SeatPart ~= nil then
                r.Anchored = true
                task.wait(0.03)
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
                r.Anchored = false
            else
                r.Anchored = true
                task.wait()
                h:ChangeState(Enum.HumanoidStateType.Running)
                r.Anchored = false
                h.AutoRotate = true
                for _, limb in ipairs(c:GetDescendants()) do
                    if limb:IsA("BasePart") and limb.Name == "RagdollLimbPart" then
                        limb.CanCollide = false
                    end
                end
            end
        end
    end)
end

