local function mercuryIsMaliciousLine(myPos, targetPart)
    if not myPos or not targetPart then return false end
    local p = targetPart.Position
    return math.abs(myPos.X - p.X) >= 40000 or math.abs(myPos.Y - p.Y) >= 40000 or math.abs(myPos.Z - p.Z) >= 40000
end
local function mercuryCleanupLineData()
    local now = tick()
    for k, data in pairs(T.mercuryAntiLineLagPlayerData) do
        if not data or not data.lastTime or now - data.lastTime > 3 then
            T.mercuryAntiLineLagPlayerData[k] = nil
        else
            local t = {}
            for _, ts in ipairs(data.timestamps or {}) do
                if ts >= now - MLL_WINDOW then table.insert(t, ts) end
            end
            data.timestamps = t
        end
    end
end
local function mercuryStartAntiLineLag()
    T.mercuryAntiLineLagEnabled = true
    mercuryDisableBeam()
    if not CreateLine then return end
    T.mercuryAntiLineLagConn = CreateLine.OnClientEvent:Connect(function(player, target, cframe)
        if not T.mercuryAntiLineLagEnabled or not player or player == LocalPlayer then return end
        local chr = player.Character
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local targetPart = cframe or (typeof(target) == "CFrame" and target)
        if not targetPart then return end
        if mercuryIsMaliciousLine(hrp.Position, targetPart) then
            local now = tick()
            if not T.mercuryAntiLineLagPlayerData[player] then
                T.mercuryAntiLineLagPlayerData[player] = { lastNotify = 0, timestamps = {}, lastTime = now }
            end
            local d = T.mercuryAntiLineLagPlayerData[player]
            table.insert(d.timestamps, now)
            d.lastTime = now
            local t = {}
            for _, ts in ipairs(d.timestamps) do
                if ts >= now - MLL_WINDOW then table.insert(t, ts) end
            end
            d.timestamps = t
            if #d.timestamps >= MLL_THRESHOLD and now - d.lastNotify >= MLL_NOTIFY_COOLDOWN then
                d.lastNotify = now
                warn("[Mercury] Line lag detected! " .. (player.DisplayName or player.Name) .. " is spamming lines!")
            end
        end
    end)
    T.mercuryAntiLineLagThread = task.spawn(function()
        while T.mercuryAntiLineLagEnabled do
            task.wait(0.05)
            mercuryCleanupLineData()
        end
    end)
end
local function mercuryStopAntiLineLag()
    T.mercuryAntiLineLagEnabled = false
    if T.mercuryAntiLineLagConn then T.mercuryAntiLineLagConn:Disconnect(); T.mercuryAntiLineLagConn = nil end
    if T.mercuryAntiLineLagThread then task.cancel(T.mercuryAntiLineLagThread); T.mercuryAntiLineLagThread = nil end
