local function startAntiGucci()
    if T.antiGucciTask then task.cancel(T.antiGucciTask) T.antiGucciTask = nil end
    T.antiGucciTask = task.spawn(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local rootPart = character:WaitForChild("HumanoidRootPart")
        T.antiGucciSafePos = rootPart.CFrame
        local function ensureBlobman()
            local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
            local blob = inv and inv:FindFirstChild("CreatureBlobman")
            if not blob or not blob.Parent then
                pcall(function() SpawnToy:InvokeServer("CreatureBlobman", rootPart.CFrame, Vector3.zero) end)
                task.wait(1)
                inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                blob = inv and inv:FindFirstChild("CreatureBlobman")
            end
            return blob
        end
        local blob = ensureBlobman()
        if not blob then return end
        local seat = blob:FindFirstChildWhichIsA("VehicleSeat", true)
        if not seat then return end
        rootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
        task.wait()
        local gucciRunning = true
        seat:Sit(humanoid)
        local grabThread = task.spawn(function()
            local f = 0
            while gucciRunning do
                for _, part in ipairs(blob:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if f % 3 == 0 then pcall(function() SetOwner:FireServer(part, rootPart.CFrame) end)
                        elseif f % 3 == 1 then pcall(function() CreateLine:FireServer(part, Vector3.zero, part.Position, false) end)
                        else pcall(function() DestroyLine:FireServer(part) end) end
                    end
                end
                f = f + 1
                task.wait(0.035)
            end
        end)
        local start = tick()
        while tick() - start < 0.5 and S.AntiGucci do
            pcall(function()
                RagdollRemote:FireServer(rootPart, 0)
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
            RunService.Heartbeat:Wait()
        end
        gucciRunning = false
        local primary = blob.PrimaryPart or blob:FindFirstChildWhichIsA("BasePart", true)
        if primary then
            pcall(function() SetOwner:FireServer(primary, rootPart.CFrame) end)
            pcall(function() sethiddenproperty(primary, "NetworkIsSleeping", false) end)
        end
        pcall(function() seat:Destroy() end)
        task.wait(0.1)
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            humanoid.Sit = false
        end
        task.wait(0.05)
        rootPart.CFrame = T.antiGucciSafePos
        pcall(function()
            if blob:FindFirstChild("Head") then
                blob.Head.CFrame = CFrame.new(0, 50000, 0)
                blob.Head.Anchored = true
            end
        end)
    end)
