                                m_StickyEvent:FireServer(sticky, torso, CFrame.Angles(math.rad(90), math.rad(45), 0))
                            end)
                        end
                        m_notify("Defend", "Attached to " .. friend.Name, 2)
                    end
                    return
                end
            end
        end
        task.wait(0.1)
    end
end

-- ---------- 十五、PCLD ESP ----------
local m_PCLDESP = { enabled = false, thread = nil, connections = {} }
local m_PCLD_NAMES = { "PlayerCharacterLocationDetector", "CharacterDetector", "PartESP" }
local function m_isPCLD(part)
    if not part or not part:IsA("BasePart") then return false end
    local lower = part.Name:lower()
    for _, n in ipairs(m_PCLD_NAMES) do
        if lower:find(n:lower()) then return true end
    end
    return false
end
local function m_startPCLDESP()
    if m_PCLDESP.enabled then return end
    m_PCLDESP.enabled = true
    m_PCLDESP.thread = task.spawn(function()
        local tracked = {}
        while m_PCLDESP.enabled do
            for _, p in ipairs(m_ws:GetDescendants()) do
                if m_isPCLD(p) and not tracked[p] then
                    tracked[p] = true
                    local anchor = Instance.new("Part")
                    anchor.Name = "PCLD_Anchor"
                    anchor.Anchored = true
                    anchor.CanCollide = false
                    anchor.CanTouch = false
                    anchor.CanQuery = false
                    anchor.Transparency = 1
                    anchor.Size = p.Size
                    anchor.CFrame = p.CFrame
                    anchor.Parent = m_ws
                    local box = Instance.new("SelectionBox")
                    box.Name = "PCLD_Box"
                    box.Adornee = anchor
                    box.Color3 = Color3.new(1,1,1)
                    box.SurfaceColor3 = Color3.new(0,0,0)
                    box.SurfaceTransparency = 0.75
                    box.Transparency = 0.5
                    box.LineThickness = 0.02
                    box.Parent = anchor
                    task.spawn(function()
                        while m_PCLDESP.enabled and p.Parent do
                            anchor.CFrame = p.CFrame
                            anchor.Size = p.Size
                            task.wait()
                        end
                        if anchor then anchor:Destroy() end
                        tracked[p] = nil
                    end)
                end
            end
            task.wait(0.5)
        end
        for _, p in ipairs(m_ws:GetDescendants()) do
            if p.Name == "PCLD_Anchor" then p:Destroy() end
        end
    end)
end
local function m_stopPCLDESP()
    m_PCLDESP.enabled = false
    if m_PCLDESP.thread then task.cancel(m_PCLDESP.thread); m_PCLDESP.thread = nil end
    for _, p in ipairs(m_ws:GetDescendants()) do
        if p.Name == "PCLD_Anchor" then p:Destroy() end
    end
end

-- ---------- 十六、载具飞行 ----------
local fly_flag7 = false
local fly_n25 = 5
local fly_fn12, fly_fn13
local fly_flag8 = false
local fly_connection = nil
local fly_connection2 = nil
local fly_flag9 = false
local function fly_fn14(arg) return arg and arg:FindFirstChild("HumanoidRootPart") end
local function fly_fn16()
    fly_flag9 = false
    if fly_connection then fly_connection:Disconnect(); fly_connection = nil end
    if fly_connection2 then fly_connection2:Disconnect(); fly_connection2 = nil end
    local chr = m_lp.Character
    if chr then
        local hum = chr:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
    pcall(function() m_ws.CurrentCamera.CameraType = Enum.CameraType.Custom end)
end
local function fly_fn17(arg)
    local character = m_lp.Character or m_lp.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        repeat task.wait() until character:FindFirstChildOfClass("Humanoid")
        humanoid = character:FindFirstChildOfClass("Humanoid")
    end
    if fly_connection then fly_connection:Disconnect() end
    if fly_connection2 then fly_connection2:Disconnect() end
    local hrp = fly_fn14(character)
    local tbl5 = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
    local tbl6 = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
    local n26 = 0
    local function startFly()
        fly_flag9 = true
        local bodyGyro = Instance.new("BodyGyro")
        local bodyVelocity_ = Instance.new("BodyVelocity")
        bodyGyro.P = 90000
        bodyGyro.Parent = hrp
        bodyVelocity_.Parent = hrp
        bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.CFrame = hrp.CFrame
        bodyVelocity_.Velocity = Vector3.zero
        bodyVelocity_.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        task.spawn(function()
            while true do
                task.wait()
                local cam = m_ws.CurrentCamera
                if not arg and humanoid then humanoid.PlatformStand = true end
                if tbl5.L + tbl5.R ~= 0 or tbl5.F + tbl5.B ~= 0 or tbl5.Q + tbl5.E ~= 0 then
                    n26 = 50
                elseif not (tbl5.L + tbl5.R ~= 0 or tbl5.F + tbl5.B ~= 0 or tbl5.Q + tbl5.E ~= 0) and n26 ~= 0 then
                    n26 = 0
                end
                if tbl5.L + tbl5.R ~= 0 or tbl5.F + tbl5.B ~= 0 or tbl5.Q + tbl5.E ~= 0 then
                    local p = cam.CFrame.p
                    bodyVelocity_.Velocity = (cam.CFrame.LookVector * (tbl5.F + tbl5.B) + cam.CFrame * CFrame.new(tbl5.L + tbl5.R, (tbl5.F + tbl5.B + tbl5.Q + tbl5.E) * 0.2, 0).p - p) * n26
                    tbl6 = { F = tbl5.F, B = tbl5.B, L = tbl5.L, R = tbl5.R }
                elseif tbl5.L + tbl5.R == 0 and tbl5.F + tbl5.B == 0 and tbl5.Q + tbl5.E == 0 and n26 ~= 0 then
                    local p = cam.CFrame.p
                    bodyVelocity_.Velocity = (cam.CFrame.LookVector * (tbl6.F + tbl6.B) + cam.CFrame * CFrame.new(tbl6.L + tbl6.R, (tbl6.F + tbl6.B + tbl5.Q + tbl5.E) * 0.2, 0).p - p) * n26
                else
                    bodyVelocity_.Velocity = Vector3.zero
                end
                bodyGyro.CFrame = cam.CFrame
                if fly_flag9 then continue end
                break
            end
            tbl5 = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
            tbl6 = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
            n26 = 0
            bodyGyro:Destroy()
            bodyVelocity_:Destroy()
            if humanoid then humanoid.PlatformStand = false end
        end)
    end
    fly_connection = m_uis.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then tbl5.F = arg and fly_n25 or 1
        elseif input.KeyCode == Enum.KeyCode.S then tbl5.B = -(arg and fly_n25 or 1)
        elseif input.KeyCode == Enum.KeyCode.A then tbl5.L = -(arg and fly_n25 or 1)
        elseif input.KeyCode == Enum.KeyCode.D then tbl5.R = arg and fly_n25 or 1
        elseif input.KeyCode == Enum.KeyCode.E then tbl5.Q = (arg and fly_n25 or 1) * 2
        elseif input.KeyCode == Enum.KeyCode.Q then tbl5.E = -(arg and fly_n25 or 1) * 2
        end
        pcall(function() cam.CameraType = Enum.CameraType.Track end)
    end)
    fly_connection2 = m_uis.InputEnded:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.W then tbl5.F = 0
        elseif input.KeyCode == Enum.KeyCode.S then tbl5.B = 0
        elseif input.KeyCode == Enum.KeyCode.A then tbl5.L = 0
        elseif input.KeyCode == Enum.KeyCode.D then tbl5.R = 0
        elseif input.KeyCode == Enum.KeyCode.E then tbl5.Q = 0
        elseif input.KeyCode == Enum.KeyCode.Q then tbl5.E = 0
        end
    end)
    startFly()
end
fly_fn12 = function()
    if fly_flag7 then return end
    fly_flag7 = true
    fly_flag8 = true
    fly_fn16()
    task.wait()
    fly_fn17(true)
end
fly_fn13 = function()
    fly_flag7 = false
    fly_flag8 = false
    fly_fn16()
end
m_lp.CharacterAdded:Connect(function()
    task.wait(0.5)
    if fly_flag8 then
        fly_flag7 = true
        fly_fn16()
        task.wait()
        fly_fn17(true)
    end
end)

m_uis.InputBegan:Connect(function(input, gp)
