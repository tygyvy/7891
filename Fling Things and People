-- ---------- 一、Anti-Kick Method ----------
local m_AntiKick = {
    method = "Base Shuriken",
    enabled = false,
    thread = nil,
    conn = nil,
    spawned = nil,
    lastSpawn = 0,
}
local function m_waitCanSpawn()
    if not m_CanSpawn then return end
    local t = tick()
    while not m_CanSpawn.Value and tick() - t < 3 do task.wait() end
end
local function m_spawnAntiKickCarrier(toyName)
    m_waitCanSpawn()
    local chr = m_lp.Character
    local head = chr and chr:FindFirstChild("Head")
    if not head then return nil end
    local folder = m_ws:FindFirstChild(m_lp.Name .. "SpawnedInToys")
    local before = {}
    if folder then
        for _, c in ipairs(folder:GetChildren()) do
            if c.Name == toyName then before[c] = true end
        end
    end
    task.spawn(function()
        pcall(function()
            m_SpawnRemote:InvokeServer(toyName, head.CFrame * m_cf(0, 15, 20), m_v32(0, 0, 0))
        end)
    end)
    local t = tick()
    while tick() - t < 3 do
        folder = m_ws:FindFirstChild(m_lp.Name .. "SpawnedInToys")
        if folder then
            for _, c in ipairs(folder:GetChildren()) do
                if c.Name == toyName and not before[c] then
                    c.Name = "AntiKick"
                    for _, d in ipairs(c:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name ~= "StickyPart" and d.Name ~= "SoundPart" then
                            d.Transparency = 1
                        elseif d:IsA("Decal") or d:IsA("Texture") then
                            d.Transparency = 1
                        end
                    end
                    return c
                end
            end
        end
        task.wait(0.1)
    end
    return nil
end
local function m_stickAntiKick(obj)
    if not obj or not obj.Parent then return end
    local sticky = obj:FindFirstChild("StickyPart")
    if not sticky then return end
    local chr = m_lp.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local firePart = hrp:FindFirstChild("FirePlayerPart") or hrp:WaitForChild("FirePlayerPart", 2)
    if not firePart then return end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then d.CanCollide = false; d.CanQuery = false end
    end
    if m_SNO then
        task.spawn(function() m_SNO:FireServer(sticky, sticky.CFrame) end)
    end
