-- 八、Anti Burn
local antiBurnEnabled = false
local antiBurnConn = nil
local antiBurnSavedCF = nil
local antiBurnSavedTrans = nil
local antiBurnSavedSize = nil
local function getBurnBarrier()
    local plots = Workspace:FindFirstChild("Plots")
    local p1 = plots and plots:FindFirstChild("Plot1")
    local barrier = p1 and p1:FindFirstChild("Barrier")
    return barrier and barrier:FindFirstChild("PlotBarrier")
end
local function saveBurnState()
    local b = getBurnBarrier()
    if b then
        antiBurnSavedCF = b.CFrame
        antiBurnSavedTrans = b.Transparency
        antiBurnSavedSize = b.Size
    end
end
local function restoreBurnState()
    local b = getBurnBarrier()
    if b and antiBurnSavedCF then
        b.CFrame = antiBurnSavedCF
        b.Transparency = antiBurnSavedTrans or 0
        b.Size = antiBurnSavedSize or Vector3.one
    end
end
local function handleBurn(character, hum, debounce)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local b = getBurnBarrier()
    if not b or not b.Parent then return end
    saveBurnState()
    b.Transparency = 1
    b.Size = Vector3.zero
    while debounce and debounce.Value == true and b.Parent and hrp.Parent do
        b.CFrame = hrp.CFrame
        b.Size = Vector3.zero
        task.wait()
    end
    if debounce and debounce.Parent then debounce.Value = false end
    restoreBurnState()
end
local function watchCharacterBurn(character)
    task.wait(0.3)
    if not antiBurnEnabled then return end
    local hum = character:FindFirstChild("Humanoid")
    if not hum then return end
    local conn
    conn = hum:GetPropertyChangedSignal("Health"):Connect(function()
        if not antiBurnEnabled then conn:Disconnect(); return end
        local fd = hum:FindFirstChild("FireDebounce")
        if fd and fd.Value == true then task.spawn(handleBurn, character, hum, fd) end
    end)
end
