-- ---------- 五、Anti Line Lag ----------
local m_AutoLineLag = { enabled = false, playerData = {}, conn = nil, thread = nil }
local m_LL_THRESHOLD, m_LL_WINDOW, m_LL_COOLDOWN = 5, 1.5, 6
local m_beamMove = nil
local function m_getBeamMove()
    if not m_beamMove and m_lp then
        local ps = m_lp:FindFirstChild("PlayerScripts")
        if ps then m_beamMove = ps:FindFirstChild("CharacterAndBeamMove") end
    end
    return m_beamMove
end
local function m_disableBeam() pcall(function() local b = m_getBeamMove(); if b and b.Enabled then b.Enabled = false end end) end
local function m_enableBeam() pcall(function() local b = m_getBeamMove(); if b and not b.Enabled then b.Enabled = true end end) end
local function m_isMalicious(myPos, targetPart)
    if not myPos or not targetPart then return false end
    local p = targetPart.Position
    return math.abs(myPos.X-p.X) >= 40000 or math.abs(myPos.Y-p.Y) >= 40000 or math.abs(myPos.Z-p.Z) >= 40000
end
local function m_cleanupLineData()
    local now = tick()
    for k, d in pairs(m_AutoLineLag.playerData) do
        if not d or not d.lastTime or now - d.lastTime > 3 then
            m_AutoLineLag.playerData[k] = nil
        else
            local t = {}
            for _, ts in ipairs(d.timestamps or {}) do
                if ts >= now - m_LL_WINDOW then table.insert(t, ts) end
            end
            d.timestamps = t
        end
    end
end
local function m_startAntiLineLag()
    m_AutoLineLag.enabled = true
    m_disableBeam()
    if not m_CreateLine then return end
    m_AutoLineLag.conn = m_CreateLine.OnClientEvent:Connect(function(player, target, cframe)
        if not m_AutoLineLag.enabled or not player or player == m_lp then return end
        local chr = player.Character
        local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local targetPart = cframe or (typeof(target) == "CFrame" and target)
        if not targetPart then return end
        if m_isMalicious(hrp.Position, targetPart) then
            local now = tick()
            if not m_AutoLineLag.playerData[player] then
                m_AutoLineLag.playerData[player] = { lastNotify = 0, timestamps = {}, lastTime = now }
            end
            local d = m_AutoLineLag.playerData[player]
            table.insert(d.timestamps, now)
            d.lastTime = now
            local t = {}
            for _, ts in ipairs(d.timestamps) do
                if ts >= now - m_LL_WINDOW then table.insert(t, ts) end
            end
            d.timestamps = t
            if #d.timestamps >= m_LL_THRESHOLD and now - d.lastNotify >= m_LL_COOLDOWN then
                d.lastNotify = now
                m_notify("Line lag detected!", (player.DisplayName or player.Name) .. " is spamming lines!", 5)
            end
        end
    end)
    m_AutoLineLag.thread = task.spawn(function()
        while m_AutoLineLag.enabled do task.wait(0.05); m_cleanupLineData() end
    end)
end
local function m_stopAntiLineLag()
    m_AutoLineLag.enabled = false
    if m_AutoLineLag.conn then m_AutoLineLag.conn:Disconnect(); m_AutoLineLag.conn = nil end
    if m_AutoLineLag.thread then task.cancel(m_AutoLineLag.thread); m_AutoLineLag.thread = nil end
    m_AutoLineLag.playerData = {}
    m_enableBeam()
end

