local mercuryLimbOffsets = {
    Head = { X = 0, Y = 1.5, Z = 0, RX = 0, RY = 0, RZ = 0 },
    ["Left Arm"] = { X = -1.5, Y = 0, Z = 0, RX = 0, RY = 0, RZ = 0 },
    ["Right Arm"] = { X = 1.5, Y = 0, Z = 0, RX = 0, RY = 0, RZ = 0 },
    ["Left Leg"] = { X = -0.5, Y = -2, Z = 0, RX = 0, RY = 0, RZ = 0 },
    ["Right Leg"] = { X = 0.5, Y = -2, Z = 0, RX = 0, RY = 0, RZ = 0 },
}

local function mercuryFindChild(parent, name, timeout)
    return parent:FindFirstChild(name) or parent:WaitForChild(name, timeout or 3)
end

local function mercuryCleanup(key)
    if T.mercuryCons[key] then
        pcall(function() T.mercuryCons[key]:Disconnect() end)
        T.mercuryCons[key] = nil
    end
end

local function mercurySetLimbsNoCollide(character)
    for k in pairs(mercuryLimbOffsets) do
        local part = character:FindFirstChild(k)
        if part and part:IsA("BasePart") then
            part.CanCollide = false
            part.Massless = false
            local rag = part:FindFirstChild("RagdollLimbPart")
            if rag then rag.CanCollide = false end
        end
    end
end

local function mercurySetLimbsCollide(character)
    for k in pairs(mercuryLimbOffsets) do
        local part = character:FindFirstChild(k)
        if part and part:IsA("BasePart") then
            part.CanCollide = true
            part.CanTouch = true
        end
    end
end

local function mercuryPositionLimbs(character, baseCFrame, isBlob)
    for k, off in pairs(mercuryLimbOffsets) do
        local part = character:FindFirstChild(k)
        if part and part:IsA("BasePart") then
            local y = off.Y
            local legFlag = false
            if isBlob ~= nil then legFlag = isBlob else legFlag = (k == "Left Leg" or k == "Right Leg") end
            if legFlag and (k == "Left Leg" or k == "Right Leg") then y = 8888 end
            part.CFrame = baseCFrame * CFrame.new(off.X, y, off.Z) * CFrame.Angles(math.rad(off.RX), math.rad(off.RY), math.rad(off.RZ))
        end
    end
end

local function mercuryEnableBlobMovement(character)
    if T.mercuryFlagBlobMove then return end
    T.mercuryFlagBlobMove = true
    local h = character:FindFirstChildOfClass("Humanoid")
    if h then T.mercuryWalkSpeed = h.WalkSpeed; h.WalkSpeed = 60 end
    if T.mercuryConnection then T.mercuryConnection:Disconnect() end
    T.mercuryConnection = RunService.Stepped:Connect(function(_, dt)
        if not T.mercuryFlagBlobMove then return end
        local c = LocalPlayer.Character
        if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        local hm = c:FindFirstChildOfClass("Humanoid")
        if not hrp or not hm then return end
        if not (hm.SeatPart and hm.SeatPart.Parent and hm.SeatPart.Parent.Name == "CreatureBlobman") then return end
        hm.WalkSpeed = 60
        local md = hm.MoveDirection
        if md.Magnitude > 0 then
            local n = md.Unit * 60 * dt
            hrp.CFrame = hrp.CFrame + Vector3.new(n.X, 0, n.Z)
        end
    end)
end

local function mercuryDisableBlobMovement()
    if not T.mercuryFlagBlobMove then return end
    T.mercuryFlagBlobMove = false
    if T.mercuryConnection then T.mercuryConnection:Disconnect(); T.mercuryConnection = nil end
    local c = LocalPlayer.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        if h and T.mercuryWalkSpeed then h.WalkSpeed = T.mercuryWalkSpeed; T.mercuryWalkSpeed = nil end
    end
end

local function mercuryClearRagdollConns()
    for _, key in ipairs({"A_observer","A_loop","A_blobSeat","A_blobFastRagdoll","A_connection","A_Death"}) do
        mercuryCleanup(key)
    end
end

local function mercurySetupRagdoll(character)
    mercuryClearRagdollConns()
    if not character then return end
    local hm = mercuryFindChild(character, "Humanoid", 5)
    local torso = mercuryFindChild(character, "Torso", 5) or mercuryFindChild(character, "UpperTorso", 5)
    local hrp = mercuryFindChild(character, "HumanoidRootPart", 5)
    if not hm or not torso or not hrp then return end
    if not T.mercuryFlagRagdoll then return end
    local rag = mercuryFindChild(hm, "Ragdolled", 10)
    if not rag then return end

    T.mercuryCons.A_Death = hm.Died:Connect(function()
        mercuryClearRagdollConns(); mercuryDisableBlobMovement(); T.mercuryFlagBlobResetting = false
    end)

    local blobResetting = false
    local rr = RagdollRemote
    local cam = Workspace.CurrentCamera

    local function resetBlob()
        if T.mercuryFlagBlobResetting then return end
        T.mercuryFlagBlobResetting = true
        if T.mercuryCons.A_blobFastRagdoll then T.mercuryCons.A_blobFastRagdoll:Disconnect(); T.mercuryCons.A_blobFastRagdoll = nil end
        mercuryDisableBlobMovement()
        if hrp.Parent then hrp.CFrame = hrp.CFrame + Vector3.new(0, 4, 0) end
        task.spawn(function()
            for _ = 1, 20 do
                if hm.Parent then hm.Sit = false end
                task.wait(0.1)
            end
            blobResetting = false; T.mercuryFlagBlobResetting = false
        end)
    end

    T.mercuryCons.A_blobSeat = hm:GetPropertyChangedSignal("SeatPart"):Connect(function()
        if T.mercuryFlagBlobResetting then return end
        if not T.mercuryFlagRagdoll then return end
        if not rag.Value then return end
        if hm.SeatPart and hm.SeatPart.Parent and hm.SeatPart.Parent.Name == "CreatureBlobman" and not blobResetting then
            blobResetting = true
            local seat = hm.SeatPart
            mercuryEnableBlobMovement(character)
            while not hm.Sit and T.mercuryFlagRagdoll and rag.Value do task.wait() end
            if rr and hrp.Parent then rr:FireServer(hrp, 3) end
            while not rag.Value and not hm.Sit and T.mercuryFlagRagdoll do task.wait() end
            task.wait(0.15)
            if hm.Parent and seat.Parent then hm.Sit = true; seat:Sit(hm) end
            task.delay(0.25, function()
                if T.mercuryCons.A_blobFastRagdoll then T.mercuryCons.A_blobFastRagdoll:Disconnect() end
                if T.mercuryFlagBlobResetting or not T.mercuryFlagRagdoll then return end
                T.mercuryCons.A_blobFastRagdoll = RunService.Heartbeat:Connect(function()
                    if rag.Value and hm.SeatPart and hm.SeatPart.Parent and hm.SeatPart.Parent.Name == "CreatureBlobman" and rr and hrp.Parent then
                        rr:FireServer(hrp, 1)
                    elseif not T.mercuryFlagBlobResetting then
                        resetBlob()
                    end
                end)
            end)
        end
    end)

    local BombExplode = RS:FindFirstChild("BombEvents") and RS.BombEvents:FindFirstChild("BombExplode")
    if BombExplode then
        T.mercuryCons.A_connection = BombExplode.OnClientEvent:Connect(function(part, pos)
            if not T.mercuryFlagRagdoll or not hrp.Parent or not hm.Parent then return end
            task.spawn(function()
                if part.Radius + 10 > (pos - hrp.Position).Magnitude then
                    hrp.Anchored = true
                    task.wait()
                    hm:ChangeState(Enum.HumanoidStateType.Running)
                    hrp.Anchored = false
                    mercurySetLimbsNoCollide(character)
                end
            end)
        end)
    end

    local function ragLoop()
        if rag.Value and T.mercuryFlagRagdoll then
            mercurySetLimbsNoCollide(character)
            if T.mercuryCons.A_loop then T.mercuryCons.A_loop:Disconnect() end
            T.mercuryCons.A_loop = RunService.RenderStepped:Connect(function()
                local isBlob = hm and hm.SeatPart and hm.SeatPart.Parent and hm.SeatPart.Parent.Name == "CreatureBlobman"
                if not character.Parent or not hrp.Parent or not torso.Parent or not hm.Parent or not rag.Value then
                    if T.mercuryCons.A_loop then T.mercuryCons.A_loop:Disconnect(); T.mercuryCons.A_loop = nil end
                    return
                end
                if isBlob and not T.mercuryFlagBlobResetting then
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then resetBlob(); return end
                end
                if not isBlob and not T.mercuryFlagBlobResetting then
                    hm.PlatformStand = false
                    hm.Sit = false
                end
                local lv = cam.CFrame.LookVector
                hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-lv.X, -lv.Z), 0)
                if torso.Parent then mercuryPositionLimbs(character, torso.CFrame, isBlob) end
            end)
        else
            if T.mercuryCons.A_loop then T.mercuryCons.A_loop:Disconnect(); T.mercuryCons.A_loop = nil end
            if T.mercuryCons.A_blobFastRagdoll then T.mercuryCons.A_blobFastRagdoll:Disconnect(); T.mercuryCons.A_blobFastRagdoll = nil end
            mercurySetLimbsCollide(character)
            if hrp then hrp.Anchored = false end
            if hm then hm.PlatformStand = false end
            blobResetting = false
            mercuryDisableBlobMovement()
        end
    end

    T.mercuryCons.A_observer = rag:GetPropertyChangedSignal("Value"):Connect(ragLoop)
    if rag.Value then ragLoop() end
end

local function mercurySetupGrab(character)
    local hrp = mercuryFindChild(character, "HumanoidRootPart", 5)
    local hm = mercuryFindChild(character, "Humanoid", 5)
    local torso = mercuryFindChild(character, "Torso", 5) or mercuryFindChild(character, "UpperTorso", 5)
    local held = mercuryFindChild(LocalPlayer, "IsHeld", 5)
    if not (hrp and hm and torso and held) then return end
    if not T.mercuryFlagGrab then return end
    mercuryCleanup("AG_GrabDetect")
    if T.mercuryCons.AG_StruggleTask then task.cancel(T.mercuryCons.AG_StruggleTask); T.mercuryCons.AG_StruggleTask = nil end
    local cam = Workspace.CurrentCamera

    local function struggle()
        if T.mercuryCons.AG_StruggleTask then task.cancel(T.mercuryCons.AG_StruggleTask) end
        T.mercuryCons.AG_StruggleTask = task.spawn(function()
            while held.Value and T.mercuryFlagGrab and hm.Parent and hrp.Parent do
                local ce = RS:FindFirstChild("CharacterEvents")
                if ce then
                    if ce:FindFirstChild("Struggle") then ce.Struggle:FireServer(LocalPlayer) end
                    if ce:FindFirstChild("RagdollRemote") then ce.RagdollRemote:FireServer(hrp, 0) end
                end
                task.wait(0.15)
            end
        end)
    end

    T.mercuryCons.AG_GrabDetect = held:GetPropertyChangedSignal("Value"):Connect(function()
        if held.Value then
            T.mercuryFlagGrabbed = false
            task.wait()
            T.mercuryFlagGrabbed = true
            if hrp.Parent then hrp.Anchored = true; task.wait(); hrp.Anchored = false end
            struggle()
        else
            T.mercuryFlagGrabbed = false
            if T.mercuryCons.AG_StruggleTask then task.cancel(T.mercuryCons.AG_StruggleTask); T.mercuryCons.AG_StruggleTask = nil end
        end
    end)

    if held.Value then struggle() end
    if T.mercuryCons.AG_MainLoop then T.mercuryCons.AG_MainLoop:Disconnect() end
    T.mercuryCons.AG_MainLoop = RunService.RenderStepped:Connect(function()
        if not held.Value or not hrp.Parent or not hm.Parent then return end
        hm.PlatformStand = false
        hm.Sit = false
        local lv = cam.CFrame.LookVector
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-lv.X, -lv.Z), 0)
        if torso.Parent and T.mercuryFlagGrabbed then
            local rag = hm:FindFirstChild("Ragdolled")
            if rag and rag.Value == true then mercuryPositionLimbs(character, torso.CFrame, false) end
        end
    end)
end

local function mercuryEnableDefense()
    T.mercuryFlagGrab = true
    T.mercuryFlagRagdoll = true
    if LocalPlayer.Character then
        task.spawn(function()
            mercurySetupGrab(LocalPlayer.Character)
            mercurySetupRagdoll(LocalPlayer.Character)
        end)
    end
    mercuryCleanup("AG_CharAdded")
    T.mercuryCons.AG_CharAdded = LocalPlayer.CharacterAdded:Connect(function(c)
        task.wait()
        if T.mercuryFlagGrab then mercurySetupGrab(c) end
        if T.mercuryFlagRagdoll then mercurySetupRagdoll(c) end
    end)
end

local function mercuryDisableDefense()
    T.mercuryFlagGrab = false
    T.mercuryFlagRagdoll = false
    mercuryClearRagdollConns()
    mercuryCleanup("AG_GrabDetect")
    mercuryCleanup("AG_MainLoop")
    mercuryCleanup("AG_CharAdded")
    mercuryDisableBlobMovement()
end

