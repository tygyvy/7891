-- 保存配置
local HttpService = game:GetService("HttpService")
local CONFIG_KEY = "DeadRailsHub_Config"

local function saveConfig(name)
    local config = {}
    for _, tab in pairs(Tabs) do
        if tab and tab.GetValues then
            local values = tab:GetValues()
            for flag, value in pairs(values) do
                config[flag] = value
            end
        end
    end
    local data = HttpService:JSONEncode({ name = name, config = config, savedAt = os.time() })
    local success, err = pcall(function()
        writefile and writefile(CONFIG_KEY .. "_" .. name .. ".json", data)
    end)
    if success then WindUI:Notify({ Title = "Settings", Content = "Config '" .. name .. "' saved!", Duration = 3 })
    else WindUI:Notify({ Title = "Settings", Content = "Failed to save: " .. tostring(err), Duration = 3 }) end
end

local function loadConfig(name)
    local success, data = pcall(function()
        return readfile and readfile(CONFIG_KEY .. "_" .. name .. ".json")
    end)
    if not success or not data then WindUI:Notify({ Title = "Settings", Content = "Config not found", Duration = 3 }); return end
    local decoded = HttpService:JSONDecode(data)
    if not decoded or not decoded.config then WindUI:Notify({ Title = "Settings", Content = "Invalid config", Duration = 3 }); return end
    for flag, value in pairs(decoded.config) do
        for _, tab in pairs(Tabs) do
            if tab and tab.SetValue then
                pcall(function() tab:SetValue(flag, value) end)
            end
        end
    end
    WindUI:Notify({ Title = "Settings", Content = "Config '" .. name .. "' loaded!", Duration = 3 })
end

local function deleteConfig(name)
    local success, err = pcall(function()
        delfile and delfile(CONFIG_KEY .. "_" .. name .. ".json")
    end)
    if success then WindUI:Notify({ Title = "Settings", Content = "Config '" .. name .. "' deleted!", Duration = 3 })
    else WindUI:Notify({ Title = "Settings", Content = "Failed to delete", Duration = 3 }) end
end

local function getConfigList()
    local list = {}
    pcall(function()
        for _, f in ipairs(listfiles and listfiles() or {}) do
            if f:match(CONFIG_KEY) then
                table.insert(list, f:gsub(CONFIG_KEY .. "_", ""):gsub("%.json", ""))
            end
        end
    end)
    return list
end

