local GUN_PELLETS = 15
local gun = {
    enabled = false,
    range = 50,
    scanDelay = 0.05,
    filter = {},
    allowed = {},
    run = 0,
    tracking = false,
    lastShotAt = 0,
    lastReloadAt = 0,
}

local function gunKey(n) return (string.lower(n):gsub("[^%w]", "")) end

local function getGunFolder()
    local ok, f = pcall(function() return ReplicatedStorage.Assets.Tools.Weapon.Gun end)
    return ok and f or nil
end

local function getGunObjectFolder()
    local ok, f = pcall(function() return ReplicatedStorage.Shared.Universe.Object.Objects.Weapon.Gun end)
    return ok and f or nil
end

local function getGunNames()
    local names, seen = {}, {}
    local f = getGunObjectFolder()
    if f then
        for _, d in ipairs(f:GetDescendants()) do
            if d:IsA("ModuleScript") and not seen[d.Name] then
                seen[d.Name] = true
                table.insert(names, d.Name)
            end
        end
    end
    if #names == 0 then
        local tf = getGunFolder()
        if tf then
            for _, ch in ipairs(tf:GetChildren()) do table.insert(names, ch.Name) end
        end
    end
    table.sort(names)
    return names
end

local function rebuildAllowed()
    local a = {}
    if next(gun.filter) ~= nil then
        for n in pairs(gun.filter) do a[gunKey(n)] = true end
    else
        for _, n in ipairs(getGunNames()) do a[gunKey(n)] = true end
    end
    gun.allowed = a
end

local function getWeaponConfig(tool)
    local cfg = tool:FindFirstChild("WeaponConfiguration")
    local state = tool:FindFirstChild("ClientWeaponState")
    if not cfg or not state then return nil end
    return {
        fireDelay = cfg:FindFirstChild("FireDelay"),
        autoFireDelay = cfg:FindFirstChild("AutoFireDelay"),
        currentAmmo = state:FindFirstChild("CurrentAmmo"),
        isReloading = state:FindFirstChild("IsReloading"),
        lastFireTime = state:FindFirstChild("LastFireTime"),
        bulletType = cfg:FindFirstChild("BulletType"),
    }
end

local function hasAmmo(wc)
    if not wc then return true end
    local bt = wc.bulletType and wc.bulletType.Value
    if not bt or bt == "" then return true end
    local c = LocalPlayer:GetAttribute(bt .. "Ammo")
    if c ~= nil then return c > 0 end
    return true
end

local function triggerReload(tool)
    local r = ReplicatedStorage:FindFirstChild("Remotes")
    r = r and r:FindFirstChild("Weapon")
    r = r and r:FindFirstChild("Reload")
    if r then r:FireServer(0, tool) end
end

local function isGunReady(tool, wc)
    if not wc then return false end
    if wc.isReloading and wc.isReloading.Value then return false end
    local ammo = wc.currentAmmo and wc.currentAmmo.Value
    if ammo ~= nil and ammo <= 0 then
        if hasAmmo(wc) and tick() - gun.lastReloadAt >= 2 then
            gun.lastReloadAt = tick()
            triggerReload(tool)
        end
        return false
    end
    if not hasAmmo(wc) then return false end
    return true
end

local function getFireDelay(wc)
    if not wc then return 0.15 end
    local fd = wc.fireDelay and wc.fireDelay.Value or 0.15
    local afd = wc.autoFireDelay and wc.autoFireDelay.Value
    return math.max(0.05, afd and math.max(afd, fd) or fd)
end

local function getNextFireTime(wc)
    if not wc then return 0 end
    local lft = wc.lastFireTime and wc.lastFireTime.Value or 0
    return lft + getFireDelay(wc)
end

local function findReadyGun(c)
    local function try(tool)
        if not (tool:IsA("Tool") and gun.allowed[gunKey(tool.Name)]) then return nil, nil end
        local wc = getWeaponConfig(tool)
        if not wc then return nil, nil end
        if wc.isReloading and wc.isReloading.Value then return nil, nil end
        return tool, wc
    end
    for _, ch in ipairs(c:GetChildren()) do
        local t, wc = try(ch)
        if t then return t, wc end
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, ch in ipairs(bp:GetChildren()) do
            local t, wc = try(ch)
            if t then return t, wc end
        end
    end
    return nil, nil
end

local function gunStep()
    if not HumanoidRootPart then return end
    local r = ReplicatedStorage:FindFirstChild("Remotes")
    r = r and r:FindFirstChild("Weapon")
    r = r and r:FindFirstChild("Shoot")
    if not r then return end
    local tool, wc = findReadyGun(Character)
    if not tool then return end
    local fd = getFireDelay(wc)
    local now = tick()
    if now - gun.lastShotAt < fd then return end
    local sNow = workspace:GetServerTimeNow()
    if sNow < getNextFireTime(wc) then return end
    if not isGunReady(tool, wc) then return end
    local bp, bh, bd = nil, nil, gun.range
    for m, h in pairs(trackedNPCs) do
        if m.Parent and h.Health > 0 then
            local p = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
            if p then
                local d = (p.Position - HumanoidRootPart.Position).Magnitude
                if d <= bd then bp, bh, bd = p, h, d end
            end
        end
    end
    if bp then
        local hits = {}
        for i = 1, GUN_PELLETS do hits[tostring(i)] = bh end
        local o = HumanoidRootPart.Position + Vector3.new(0, 1.5, 0)
        r:FireServer(workspace:GetServerTimeNow(), tool, CFrame.lookAt(o, bp.Position), hits)
        gun.lastShotAt = tick()
    end
end

local function stopGunAura()
    gun.run += 1
    if gun.conn then gun.conn:Disconnect(); gun.conn = nil end
    gun.enabled = false
    if gun.tracking then gun.tracking = false; stopNPCTracking() end
end

local function startGunAura()
    stopGunAura()
    gun.enabled = true
    gun.tracking = true
    gun.lastShotAt = 0
    gun.lastReloadAt = 0
    startNPCTracking()
    rebuildAllowed()
    gun.conn = RunEvery(function() return gun.scanDelay end, gunStep)
end

