    local weldHook =
        { active = false, original = nil, raw = false, world = nil, cache = nil, cachedAt = 0, cachedFor = nil }
    local function findWeldTarget(modules, dragged)
        local now = os.clock()
        if weldHook.cachedFor == dragged and now - weldHook.cachedAt < 0.25 then
            return weldHook.cache
        end
        local world, comps = modules.world, modules.comps
        local draggedModel = world:get(dragged, comps.ModelInstance)
        if not draggedModel then
            return nil
        end
        local origin = draggedModel:GetPivot().Position
        local bestEntity, bestDist
        for id in world:query(comps.WeldSurface, comps.ModelInstance) do
            if id ~= dragged and not modules.isShopItem(id) then
                local model = world:get(id, comps.ModelInstance)
                if model and model.Parent and not model:IsDescendantOf(draggedModel) then
                    local d = (model:GetPivot().Position - origin).Magnitude
                    if not bestDist or d < bestDist then
                        bestEntity, bestDist = id, d
                    end
                end
            end
        end
        weldHook.cache = bestEntity
        weldHook.cachedAt = now
        weldHook.cachedFor = dragged
        return bestEntity
    end
    local function stopWeldAnywhere()
        if not weldHook.active then
            return
        end
        weldHook.active = false
        local w = weldHook.world
        if w then
            if weldHook.raw then
                w.insert_resource = weldHook.original
            else
                w.insert_resource = nil
            end
        end
        weldHook.world = nil
        weldHook.original = nil
        weldHook.cache = nil
    end
    local function startWeldAnywhere()
        stopWeldAnywhere()
        if not ECS then
            ECS = loadECS()
        end
        if not ECS then
            return false
        end
        local world, comps = ECS.world, ECS.comps
        local original = world.insert_resource
        if type(original) ~= "function" then
            return false
        end
        weldHook.world = world
        weldHook.original = rawget(world, "insert_resource")
        weldHook.raw = weldHook.original ~= nil
        weldHook.active = true
        world.insert_resource = function(self, component, value, ...)
            if weldHook.active and component == comps.DraggingStateResource and type(value) == "table" then
                local dragged = value.draggingEntity
                if
                    dragged
                    and not value.weldTarget
                    and world:has(dragged, comps.Weldable)
                    and not ECS.isShopItem(dragged)
                then
                    local target = findWeldTarget(ECS, dragged)
                    if target then
                        value = table.clone(value)
                        value.weldTarget = target
                    end
                end
            end
            return original(self, component, value, ...)
        end
        return true
    end
