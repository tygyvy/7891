        v.Velocity = Vector3.zero
        v.Parent = root
    end
    local g = root:FindFirstChild(vflyGyroName)
    if not g then
        g = Instance.new("BodyGyro")
        g.Name = vflyGyroName
        g.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        g.P = 9e4
        g.CFrame = root.CFrame
