                TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
                { CFrame = targetCFrame }
            )
            tween:Play()
            tween.Completed:Wait()
        end

        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
        humanoid.AutoRotate = false
        hrp.Anchored = true

        FortTeleportBtn.Connection = RunService.Heartbeat:Connect(function()
            if not FortTeleportBtn.Active then
                if FortTeleportBtn.Connection then
                    FortTeleportBtn.Connection:Disconnect()
                    FortTeleportBtn.Connection = nil
                end
                return
            end

            if not character.Parent or not hrp.Parent then
                FortTeleportBtn.Active = false
                if FortTeleportBtn.Connection then
                    FortTeleportBtn.Connection:Disconnect()
                    FortTeleportBtn.Connection = nil
                end
                if FortTeleportBtn.Saved then
                    local hrp2 = FortTeleportBtn.Saved.hrp
                    local humanoid2 = FortTeleportBtn.Saved.humanoid
                    if hrp2 and hrp2.Parent then
                        hrp2.Anchored = FortTeleportBtn.Saved.anchored
                    end
                    if humanoid2 and humanoid2.Parent then
                        humanoid2.WalkSpeed = FortTeleportBtn.Saved.walkSpeed
                        humanoid2.JumpPower = FortTeleportBtn.Saved.jumpPower
                        humanoid2.JumpHeight = FortTeleportBtn.Saved.jumpHeight
                        humanoid2.AutoRotate = FortTeleportBtn.Saved.autoRotate
                    end
                    FortTeleportBtn.Saved = nil
                end
                FortTeleportBtn:SetTitle("寻找或传送到宪法堡")
                return
            end

            local seat = findSeat()
            if seat then
                if FortTeleportBtn.Connection then
                    FortTeleportBtn.Connection:Disconnect()
                    FortTeleportBtn.Connection = nil
                end

                tweenTo(seat.CFrame * CFrame.new(0, 2, 0))

                FortTeleportBtn.Active = false
                if FortTeleportBtn.Saved then
                    local hrp3 = FortTeleportBtn.Saved.hrp
                    local humanoid3 = FortTeleportBtn.Saved.humanoid
                    if hrp3 and hrp3.Parent then
                        hrp3.Anchored = FortTeleportBtn.Saved.anchored
                    end
                    if humanoid3 and humanoid3.Parent then
                        humanoid3.WalkSpeed = FortTeleportBtn.Saved.walkSpeed
                        humanoid3.JumpPower = FortTeleportBtn.Saved.jumpPower
                        humanoid3.JumpHeight = FortTeleportBtn.Saved.jumpHeight
                        humanoid3.AutoRotate = FortTeleportBtn.Saved.autoRotate
                    end
                    FortTeleportBtn.Saved = nil
                end
                FortTeleportBtn:SetTitle("寻找或传送到宪法堡")

                task.wait()
                seat:Sit(humanoid)
                return
            end

            local rotation = hrp.CFrame.Rotation
            local target = CFrame.new(hrp.Position + direction * 50) * rotation
            local distance = (target.Position - hrp.Position).Magnitude
            local duration = math.max(distance / 90000)

            local tween = TweenService:Create(
                hrp,
                TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
                { CFrame = target }
            )
            tween:Play()
            tween.Completed:Wait()
        end)
    end
})
