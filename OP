function FileExists(p)
    if isfile then
        return pcall(readfile, p)
    end
    return false
end
function WriteFile(p, c)
    if writefile then
        return pcall(writefile, p, c)
    end
    return false
end
function ReadFile(p)
    if readfile then
        local ok, c = pcall(readfile, p)
        if ok then
            return c
        end
    end
    return ""
end
function loadAutoLoadSettings()
    if FileExists(AUTOLOAD_FILE) then
        local c = ReadFile(AUTOLOAD_FILE)
        if c ~= "" then
            local ok, d = pcall(function()
                return HttpService:JSONDecode(c)
            end)
            if ok and d then
                AutoLoadConfig = d.configName or "default"
                AutoLoadEnabled = d.enabled or false
                return true
            end
        end
    end
    AutoLoadConfig = "default"
    AutoLoadEnabled = false
    return false
end
function saveAutoLoadSettings()
    if not WriteFile(AUTOLOAD_FILE, "") and makefolder then
        pcall(function()
            makefolder("Darahub")
        end)
        pcall(function()
            makefolder("Darahub/AutoLoad")
        end)
        pcall(function()
            makefolder("Darahub/AutoLoad/Game")
        end)
        pcall(function()
            makefolder("Darahub/AutoLoad/Game/DeadRail")
        end)
    end
    local ok, j = pcall(function()
        return HttpService:JSONEncode({ enabled = AutoLoadEnabled, configName = AutoLoadConfig })
    end)
    if ok then
        WriteFile(AUTOLOAD_FILE, j)
    end
end
