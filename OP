        Desc = "移除交互提示的长按时间",
        Value = false,
        Callback = function(s)
            if s then
                startInstantPrompt()
            else
                stopInstantPrompt()
            end
        end,
    })
    table.insert(extraCleanups, stopInstantPrompt)
end

