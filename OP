    if not workspace.CurrentCamera then return end
    if hasEnabledOption(espSettings.Player) then updatePlayerESP() else for c, esp in pairs(espElements.Player) do removeTargetESP(c, esp) end; espElements.Player = {} end
    if hasEnabledOption(espSettings.Mob) then updateMobESP() else for c, esp in pairs(espElements.Mob) do removeTargetESP(c, esp) end; espElements.Mob = {} end
    updateTracerESP()
end

local function refreshESP()
    local mobNeeded = hasEnabledOption(espSettings.Mob)
    if mobNeeded and not mobTrackingActive then mobTrackingActive = true; startNPCTracking()
    elseif not mobNeeded and mobTrackingActive then mobTrackingActive = false; stopNPCTracking(); for c, esp in pairs(espElements.Mob) do removeTargetESP(c, esp) end; espElements.Mob = {} end
    local itemNeeded = hasEnabledOption(espSettings.Item)
    if itemNeeded then iecStart() else iecStop() end
    local anyEnabled = mobNeeded or itemNeeded or hasEnabledOption(espSettings.Player)
    if anyEnabled and not espConnection then espConnection = RunService.RenderStepped:Connect(onESPRenderStepped)
    elseif not anyEnabled and espConnection then espConnection:Disconnect(); espConnection = nil; for c, esp in pairs(espElements.Player) do removeTargetESP(c, esp) end; espElements.Player = {}; for c, esp in pairs(espElements.Mob) do removeTargetESP(c, esp) end; espElements.Mob = {}; cleanupTracerESP() end
end

local function stopESP()
    for _, s in pairs(espSettings) do for k in pairs(s) do if k ~= "BoxType" then s[k] = false end end end
    refreshESP(); for c, esp in pairs(espElements.Player) do removeTargetESP(c, esp) end; espElements.Player = {}
    for c, esp in pairs(espElements.Mob) do removeTargetESP(c, esp) end; espElements.Mob = {}; iecClearAll(); cleanupTracerESP()
end

