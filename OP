    Title = "治疗物品", Flag = "HealItemsDropdown", Desc = "按顺序找第一个可用的", Values = HEAL_ITEMS,
    Value = { "Bandage", "Snake Oil" }, Multi = true, AllowNone = true,
    Callback = function(v)
        local set = {}
        if type(v) == "table" then for _, n in ipairs(v) do set[n] = true end end
        heal.selected = set
    end,
})
Tabs.Player:Input({
    Title = "触发治疗血量", Flag = "HealMinHealthInput", Desc = "血量低于或等于此值时治疗", Placeholder = "50",
    Value = tostring(heal.minHealth),
    Callback = function(v) local n = tonumber(v); if n and n >= 0 then heal.minHealth = n end end,
