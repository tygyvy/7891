        fovCircle.BackgroundTransparency = 1; fovCircle.BorderSizePixel = 0; fovCircle.Parent = fovGui
        local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(1, 0); cr.Parent = fovCircle
