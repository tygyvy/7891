function RunEvery(interval, fn)
    local acc, busy = 0, false
    return RunService.Heartbeat:Connect(function(dt)
        if busy then
            return
        end
        acc += dt
        local wait = type(interval) == "function" and interval() or interval
        if acc < wait then
            return
        end
        acc = 0
        busy = true
        pcall(fn)
        busy = false
    end)
end

