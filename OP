local function ScanObjectEntries(folder, requires)
    local entries, all = {}, {}
    if not folder then return entries end
    if not ECS then ECS = loadECS() end
    local compNames, hasNames = {}, false
    if ECS and type(ECS.comps) == "table" then
        for k, v in pairs(ECS.comps) do
            local t = type(v)
            if t == "table" or t == "function" or t == "userdata" or t == "number" then
                compNames[v] = tostring(k)
                hasNames = true
            end
        end
    end
    local function buildPath(module)
        local parts = {}
        local node = module.Parent
        while node and node ~= folder do
            table.insert(parts, 1, node.Name)
            node = node.Parent
        end
        if #parts == 0 then return nil end
        return table.concat(parts, " / ")
    end
    local function describe(module)
        local okR, data = pcall(require, module)
        if not okR or type(data) ~= "table" or type(data.components) ~= "table" then
            return nil, buildPath(module), nil
        end
        local displayName
        local caps = {}
        for comp, val in pairs(data.components) do
            local cname = compNames[comp]
            if cname then
                caps[cname] = true
                if cname == "Name" then displayName = tostring(val) end
            end
        end
        if type(data.tags) == "table" then
            for _, tag in pairs(data.tags) do
                local tname = compNames[tag]
                if tname then caps[tname] = true end
            end
        end
        return displayName, buildPath(module), caps
    end
    local seen, usedTitles, count = {}, {}, 0
    for _, d in ipairs(folder:GetDescendants()) do
        if d:IsA("ModuleScript") then
            local key = d:GetFullName()
            if not seen[key] then
                seen[key] = true
                local displayName, details, caps = describe(d)
                local title = displayName or d.Name
                if usedTitles[title] then title = title .. " (" .. details .. ")" end
                if usedTitles[title] then title = title .. " #" .. tostring(count) end
                usedTitles[title] = true
                local e = { Title = title, Id = d.Name, Desc = details }
                table.insert(all, e)
                local matches = true
                if requires and next(requires) ~= nil and caps and hasNames then
                    matches = false
                    for _, r in ipairs(requires) do
                        if caps[r] then matches = true; break end
                    end
                end
                if matches then table.insert(entries, e) end
            end
            count += 1
            if count % 40 == 0 then task.wait() end
        end
    end
    if #entries == 0 then entries = all end
    table.sort(entries, function(x, y) return x.Title < y.Title end)
    return entries
end

local function CreateListFilter(opts)
    local titleToId, idToTitle, selected = {}, {}, {}
    local dropdown
    local function toSet(values)
        local set = {}
        if type(values) == "table" then
            for _, n in ipairs(values) do
                local title = type(n) == "table" and n.Title or n
                if title ~= nil then set[titleToId[tostring(title)] or tostring(title)] = true end
            end
        end
        return set
    end
    dropdown = opts.Tab:Dropdown({
        Title = opts.Title,
        Flag = opts.Flag,
        Desc = opts.Desc or "空 = 全部",
        Values = {},
        Value = {},
        Multi = true,
        AllowNone = true,
        SearchBarEnabled = true,
        Callback = function(v)
            selected = toSet(v)
            opts.OnChange(selected)
        end,
    })
    opts.Tab:Button({
        Title = "刷新 " .. opts.Title,
        Callback = function()
            local entries = opts.Scan()
            if #entries == 0 then
                WindUI:Notify({ Title = opts.Title, Content = "没有找到物品", Duration = 3 })
                return
            end
            table.clear(titleToId)
            table.clear(idToTitle)
            local view = {}
            for _, e in ipairs(entries) do
                titleToId[e.Title] = e.Id
                idToTitle[e.Id] = e.Title
                table.insert(view, { Title = e.Title, Desc = e.Desc })
            end
            local sel = {}
            for id in pairs(selected) do
                if idToTitle[id] then table.insert(sel, idToTitle[id]) end
            end
            if dropdown and dropdown.Refresh then dropdown:Refresh(view, sel) end
            WindUI:Notify({ Title = opts.Title, Content = #entries .. " 个", Duration = 3 })
        end,
    })
    return dropdown
end

