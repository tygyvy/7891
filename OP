do
    local ProximityPromptService = game:GetService("ProximityPromptService")
    local originals = setmetatable({}, { __mode = "k" })
    local connections = {}
    local enabled = false
    local function apply(prompt)
        if not enabled or not prompt:IsA("ProximityPrompt") then
            return
        end
        if originals[prompt] == nil then
            originals[prompt] = prompt.HoldDuration
        end
        if prompt.HoldDuration ~= 0 then
            prompt.HoldDuration = 0
        end
    end
    local function stopInstantPrompt()
        enabled = false
        for _, c in ipairs(connections) do
            c:Disconnect()
        end
        table.clear(connections)
        for prompt, hold in pairs(originals) do
            if prompt.Parent then
                prompt.HoldDuration = hold
            end
        end
        table.clear(originals)
    end
    local function startInstantPrompt()
        stopInstantPrompt()
        enabled = true
        for _, o in ipairs(workspace:GetDescendants()) do
            apply(o)
        end
        table.insert(connections, workspace.DescendantAdded:Connect(apply))
        table.insert(connections, ProximityPromptService.PromptShown:Connect(apply))
    end
    Tabs.Main:Space()
    Tabs.Main:Section({ Title = "交互", TextSize = 20 })
    Tabs.Main:Divider()
    Tabs.Main:Toggle({
        Title = "即时交互提示",
