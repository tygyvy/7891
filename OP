    end,
})

-- 5. Auto Revive
local revive = { run = 0, delay = 0.5, lastTry = setmetatable({}, { __mode = "k" }), lastWarn = 0 }

local function hasBandage()
    local key = normalizeName("Bandage")
    local function scan(c)
        if not c then return false end
        for _, ch in ipairs(c:GetChildren()) do
            if ch:IsA("Tool") and normalizeName(ch.Name) == key then return true end
        end
        return false
    end
    return scan(Character) or scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
end

local function getRevivePrompt(pl)
    local model = pl.Character or workspace:FindFirstChild(pl.Name)
    if not model then return nil, nil end
    local root = model:FindFirstChild("HumanoidRootPart")
    local prompt = root and root:FindFirstChild("RevivePrompt")
    if prompt and prompt:IsA("ProximityPrompt") then return prompt, root end
    return nil, root
end

local function reviveStep()
    if not HumanoidRootPart or not Humanoid or Humanoid.Health <= 0 then return end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            local prompt, root = getRevivePrompt(pl)
            if prompt and root then
                if not prompt.Enabled then prompt.Enabled = true end
                if prompt.Enabled then
                    local dist = (root.Position - HumanoidRootPart.Position).Magnitude
                    local now = os.clock()
                    if dist <= prompt.MaxActivationDistance and now - (revive.lastTry[prompt] or 0) >= revive.delay then
                        if not hasBandage() then
                            if os.clock() - revive.lastWarn >= 5 then
                                revive.lastWarn = os.clock()
                                WindUI:Notify({ Title = "Auto Revive", Content = "No Bandage in your inventory", Duration = 3 })
                            end
                            return
                        end
                        revive.lastTry[prompt] = now
                        prompt.HoldDuration = 0
                        fireproximityprompt(prompt)
                    end
                end
            end
        end
    end
end

local function stopAutoRevive() revive.run += 1; if revive.conn then revive.conn:Disconnect(); revive.conn = nil end end

local function startAutoRevive()
    stopAutoRevive()
    if not fireproximityprompt then
        WindUI:Notify({ Title = "Auto Revive", Content = "Your executor does not support fireproximityprompt", Duration = 3 })
        return false
    end
    revive.conn = RunEvery(0.1, reviveStep)
    return true
end

local AutoReviveToggle
AutoReviveToggle = Tabs.Player:Toggle({
