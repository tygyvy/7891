WeldAnywhereToggle = Tabs.Misc:Toggle({ Title = "Weld Anywhere", Flag = "WeldAnywhereToggle", Value = false, Callback = function(s)
    if s then if not startWeldAnywhere() then WindUI:Notify({ Title = "Weld Anywhere", Content = "Could not hook weld system", Duration = 3 }); WeldAnywhereToggle:Set(false) end
    else stopWeldAnywhere() end
end })

