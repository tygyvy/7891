    nameLbl.Size = UDim2.new(1, 0, 0, 18)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text = player.Name
    nameLbl.TextColor3 = Color3.fromRGB(255, 0, 0)
    nameLbl.TextSize = 14
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextStrokeTransparency = 0.3

    local distLbl = Instance.new("TextLabel", bb)
    distLbl.Size = UDim2.new(1, 0, 0, 16)
    distLbl.Position = UDim2.new(0, 0, 0, 18)
    distLbl.BackgroundTransparency = 1
    distLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
    distLbl.TextSize = 11
    distLbl.Font = Enum.Font.Gotham
    distLbl.TextStrokeTransparency = 0.3

    local hl = Instance.new("Highlight", char)
    hl.FillColor = Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 0, 0)
    hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0.2
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    ESPObjects[player] = { gui = bb, hl = hl, name = nameLbl, dist = distLbl }
end

local function clearESP()
    for player, obj in pairs(ESPObjects) do
        if obj.gui then obj.gui:Destroy() end
        if obj.hl then obj.hl:Destroy() end
    end
    ESPObjects = {}
end

local function updateESP()
    local espToggle = Library.Flags.ESPToggle
    local espColor = Library.Flags.ESPColor
    local espFill = Library.Flags.ESPFill
    if not espToggle or not espToggle:Get() then
        if next(ESPObjects) then clearESP() end
        return
    end

    local color = espColor and espColor:Get() or Color3.fromRGB(255, 0, 0)
    local fill = espFill and espFill:Get() or 0.6
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not ESPObjects[player] then
                    makeESP(player)
                end
                local obj = ESPObjects[player]
                if obj then
                    obj.gui.Adornee = hrp
                    obj.gui.Enabled = true
                    obj.name.TextColor3 = color
                    obj.name.Text = player.Name
                    obj.hl.FillColor = color
                    obj.hl.OutlineColor = color
                    obj.hl.FillTransparency = fill
                    if myHRP then
                        obj.dist.Text = string.format("%d studs",
                            math.floor((hrp.Position - myHRP.Position).Magnitude))
                    end
                end
            end
        end
    end
end

