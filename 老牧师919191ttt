function Window:SelectTab(tab)
    if self.CurrentTab == tab then return end
    local previous = self.CurrentTab
    self.CurrentTab = tab
    if previous then
        previous._page.Visible = false
        tween(previous._button, { BackgroundTransparency = 1 }, 0.2)
        tween(previous._stroke, { Transparency = 1 }, 0.2)
        tween(previous._label, { TextColor3 = Theme.Muted }, 0.2)
        if previous._icon then tween(previous._icon, { ImageColor3 = Theme.Muted }, 0.2) end
    end
    tween(tab._button, { BackgroundTransparency = 0 }, 0.2)
    tween(tab._stroke, { Transparency = 0 }, 0.2)
    tween(tab._label, { TextColor3 = Theme.Text }, 0.2)
    if tab._icon then tween(tab._icon, { ImageColor3 = Theme.Accent }, 0.2) end
    tab._page.Visible = true
end

function Window:Toggle(open)
    if open == nil then open = not self.Open end
    if open == self.Open then return end
    self.Open = open
    if open then
        self.Root.Visible = true
        tween(self.Scale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
        tween(self.Body, { GroupTransparency = 0 }, 0.25)
    else
        tween(self.Scale, { Scale = 0.94 }, 0.2, Enum.EasingStyle.Quint)
        tween(self.Body, { GroupTransparency = 1 }, 0.16)
    end
end

function Window:Notify(opts)
    opts = normalize(opts, {})
    local toast = create("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -20, 0, 20 + (#self._toasts or 0) * 60),
        Size = UDim2.fromOffset(240, 50),
        BackgroundColor3 = Theme.Surface2,
        BorderSizePixel = 0,
        Parent = self.Gui,
    })
    corner(toast, UDim.new(0, 8))
    stroke(toast, Theme.Stroke)
    label({
        Position = UDim2.fromOffset(12, 6),
        Size = UDim2.new(1, -24, 0, 18),
        Text = opts.Title or "Notice",
        TextSize = 14,
        Parent = toast,
    })
    label({
        Position = UDim2.fromOffset(12, 26),
        Size = UDim2.new(1, -24, 0, 16),
        Text = opts.Content or "",
        TextSize = 12,
        FontFace = Fonts.Regular,
        TextColor3 = Theme.Muted,
        Parent = toast,
    })
    self._toasts = (self._toasts or 0) + 1
    task.delay(opts.Duration or 3, function()
        toast:Destroy()
        self._toasts = math.max((self._toasts or 1) - 1, 0)
    end)
end

function Window:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    for _, c in ipairs(self._connections) do c:Disconnect() end
    self._connections = {}
    self.Gui:Destroy()
end

