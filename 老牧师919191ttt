function Window:_enableDrag()
    local dragging = false
    local grabOffset = Vector2.zero
    table.insert(self._connections, UserInputService.InputBegan:Connect(function(input)
        if not isPress(input) then return end
        if not self.Open or not self.Root.Visible then return end
        local point = pointerPosition()
        local bodyPos = self.Body.AbsolutePosition
        local bodySize = self.Body.AbsoluteSize
        if point.X < bodyPos.X or point.X > bodyPos.X + bodySize.X then return end
        if point.Y < bodyPos.Y or point.Y > bodyPos.Y + bodySize.Y then return end
        -- 不拖到控件上
        for _, obj in ipairs(self.Body:GetDescendants()) do
            if (obj:IsA("GuiButton") or obj:IsA("TextBox")) and obj.Visible then
                local pos = obj.AbsolutePosition
                local size = obj.AbsoluteSize
                if point.X >= pos.X and point.X <= pos.X + size.X and
                   point.Y >= pos.Y and point.Y <= pos.Y + size.Y then
                    return
                end
            end
        end
        dragging = true
        local centre = self.Root.AbsolutePosition + self.Root.AbsoluteSize * self.Root.AnchorPoint - self.Gui.AbsolutePosition
        grabOffset = point - centre
    end))
    table.insert(self._connections, UserInputService.InputEnded:Connect(function(input)
        if isPress(input) then dragging = false end
    end))
    table.insert(self._frameSteps, function(dt)
        if not dragging then return end
        local target = pointerPosition() - grabOffset
        local root = self.Root
        local centre = root.AbsolutePosition + root.AbsoluteSize * root.AnchorPoint - self.Gui.AbsolutePosition
        local alpha = 1 - math.exp(-dt * 45)
        local step = centre:Lerp(target, alpha)
        root.Position = UDim2.fromOffset(step.X, step.Y)
    end)
end

function Window:_listen(kind, handler, owner)
    local list = self._inputListeners[kind]
    table.insert(list, handler)
    local function disconnect()
        for index, entry in ipairs(list) do
            if entry == handler then
                table.remove(list, index)
                break
            end
        end
    end
    if owner then
        owner._listeners = owner._listeners or {}
        table.insert(owner._listeners, disconnect)
    end
    return disconnect
end

