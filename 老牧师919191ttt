-- 快速互动逻辑
local function tryFirePrompt(prompt, part, myHRP)
    if not prompt or not prompt.Parent then return end
    if prompt:IsA("ProximityPrompt") then
        if not prompt.Enabled then return end
        if typeof(fireproximityprompt) == "function" then
            pcall(fireproximityprompt, prompt)
        else
            -- 降级：临时改距离
            local old = prompt.MaxActivationDistance
            prompt.MaxActivationDistance = 99999
            task.wait()
            prompt.MaxActivationDistance = old
        end
    elseif prompt:IsA("ClickDetector") then
        if typeof(fireclickdetector) == "function" then
            pcall(fireclickdetector, prompt)
        else
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr:DistanceFromCharacter(part.Position) < 50 then
                    pcall(function() prompt:MouseClick(plr) end)
                    break
                end
            end
        end
    end
end

local function findNearestPrompt(range)
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local best, bestDist = nil, range
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
            local part = obj.Parent
            if part and part:IsA("BasePart") then
                local d = (part.Position - myHRP.Position).Magnitude
                if d < bestDist then
                    best = { prompt = obj, part = part }
                    bestDist = d
                end
            end
        end
    end
    return best
end

-- 快速互动：按 E 触发
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    local quick = Library.Flags.QuickInteract
    local rangeSlider = Library.Flags.QuickRange
    if quick and quick:Get() and input.KeyCode == Enum.KeyCode.E then
        local range = rangeSlider and rangeSlider:Get() or 15
        local found = findNearestPrompt(range)
        if found then
            tryFirePrompt(found.prompt, found.part)
        end
    end
end)

