local function toggleRainbow(enabled)
    if rainbowConn then rainbowConn:Disconnect() rainbowConn = nil end
    if not enabled then
        if not Settings.playerTransparentEnabled then
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 0
                        part.Color = Color3.fromRGB(163, 162, 165)
                        part.Material = Enum.Material.Plastic
                    elseif part:IsA("Decal") then
                        part.Transparency = 0
                    end
                end
                for _, acc in pairs(char:GetChildren()) do
                    if acc:IsA("Accessory") then
                        local h = acc:FindFirstChild("Handle")
                        if h then h.Transparency = 0 h.Color = Color3.fromRGB(163, 162, 165) h.Material = Enum.Material.Plastic end
                    end
                end
            end
        else
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Color = Color3.fromRGB(163, 162, 165)
                        part.Material = Enum.Material.ForceField
                    end
                end
                for _, acc in pairs(char:GetChildren()) do
                    if acc:IsA("Accessory") then
                        local h = acc:FindFirstChild("Handle")
                        if h then h.Color = Color3.fromRGB(163, 162, 165) h.Material = Enum.Material.ForceField end
                    end
                end
            end
        end
        return
    end

    local hue = 0
    rainbowConn = RunService.RenderStepped:Connect(function(dt)
        local cycle = Settings.rainbowCycle or 1.0
        hue = hue + dt * (1 / cycle)
        if hue > 1 then hue = hue - 1 end
        local color = Color3.fromHSV(hue, 0.85, 1)
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.Color = color
                part.Material = Enum.Material.ForceField
            end
        end
        for _, acc in pairs(char:GetChildren()) do
            if acc:IsA("Accessory") then
                local h = acc:FindFirstChild("Handle")
                if h then h.Color = color h.Material = Enum.Material.ForceField end
            end
        end
    end)
end

local function reapplyCosmeticOnRespawn()
    if Settings.playerTransparentEnabled then
