                playHitSound()
                playAngryRobotShootSound()
                local color = LaserColors[Settings.tracerColor] or LaserColors["Blue"]
                if Settings.tracerColor == "Rainbow" then color = getRainbowColor() end
                spawnCustomTracer(myHrp.Position, targetHead.Position, color)
