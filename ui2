local function deleteByName(name)
    local count = 0
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst and inst.Parent and inst.Name == name then
            pcall(function() inst:Destroy() end)
            count = count + 1
        end
    end
    return count
end

local function startDeleteLoop()
    if deleteConn then return end
    deleteConn = RunService.Heartbeat:Connect(function()
        if not Settings.deletePersistent then return end
        for _, inst in ipairs(workspace:GetDescendants()) do
            if inst and inst.Parent then
                for _, name in ipairs(Settings.deleteTargetNames) do
                    if inst.Name == name then
                        pcall(function() inst:Destroy() end)
                        break
                    end
                end
            end
        end
    end)
end

local function stopDeleteLoop()
    if deleteConn then deleteConn:Disconnect() deleteConn = nil end
end

