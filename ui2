                local now = tick()
                if not lastHitLog[target.Name] or (now - lastHitLog[target.Name].time > 0.2) then
                    local logItem = addHitLog(LocalPlayer.Name, target.Name, tool.Name)
                    lastHitLog[target.Name] = {time = now, weapon = tool.Name, logItem = logItem}
