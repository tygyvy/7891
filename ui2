local LogFrame
local function hookKillDetect(char, plr)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local conn
    conn = hum.Died:Connect(function()
        task.wait(0.1)
        local lastHit = lastHitLog[plr.Name]
        if lastHit and (tick() - lastHit.time < 2) then
            if lastHit.logItem and lastHit.logItem.Parent then
                local text = lastHit.logItem:FindFirstChildOfClass("TextLabel")
                if text then
                    text.Text = string.format("🔫 你 → %s [%s] ☠ 击杀", plr.Name, lastHit.weapon or "未知武器")
                    text.TextColor3 = Color3.fromRGB(255, 80, 80)
                end
            end
        end
        if conn then conn:Disconnect() end
    end)
end

local function hookAllPlayers()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            hookKillDetect(plr.Character, plr)
        end
        plr.CharacterAdded:Connect(function(char)
            hookKillDetect(char, plr)
        end)
    end
    Players.PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function(char)
            hookKillDetect(char, plr)
        end)
    end)
end
