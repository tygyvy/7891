local function clearESP()
    for plrName, objs in pairs(espObjects) do
        for _, obj in pairs(objs) do
            if obj and obj.Destroy then obj:Destroy() end
        end
    end
    espObjects = {}
end

local function getESPColor(plr)
    local teamName = plr.Team and plr.Team.Name or ""
    if teamName == "Inmates" and plr.Character then
        local hostile = plr.Character:GetAttribute("Hostile")
        local trespass = plr.Character:GetAttribute("Trespassing")
        if hostile or trespass then
            return TeamColors["Inmates"]
        end
    end
    return TeamColors[teamName] or Color3.fromRGB(255, 255, 255)
end

local function removeESPForPlayer(plrName)
    if espObjects[plrName] then
        for _, obj in pairs(espObjects[plrName]) do
            if obj and obj.Destroy then obj:Destroy() end
        end
        espObjects[plrName] = nil
    end
end

local function createESP(plr)
    if not Settings.espEnabled or not plr.Character then return end
    local char = plr.Character
    local head = char:FindFirstChild("Head")
    if not head then return end

    removeESPForPlayer(plr.Name)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_" .. plr.Name
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.Adornee = head
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local frame = Instance.new("Frame", billboard)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1

    local teamName = plr.Team and plr.Team.Name or "Unknown"
    local teamLabel = Instance.new("TextLabel", frame)
    teamLabel.Size = UDim2.new(1, 0, 0, Settings.espTeamSize + 4)
    teamLabel.Position = UDim2.new(0, 0, 0, 0)
    teamLabel.BackgroundTransparency = 1
    teamLabel.Text = "[" .. teamName .. "]"
    teamLabel.TextColor3 = getESPColor(plr)
    teamLabel.Font = Enum.Font.GothamBold
    teamLabel.TextSize = Settings.espTeamSize
    teamLabel.TextStrokeTransparency = 0
    teamLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    teamLabel.Visible = Settings.espShowTeam

    local nameLabel = Instance.new("TextLabel", frame)
    nameLabel.Size = UDim2.new(1, 0, 0, Settings.espNameSize + 4)
    nameLabel.Position = UDim2.new(0, 0, 0, Settings.espTeamSize + 4)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = plr.Name
    nameLabel.TextColor3 = getESPColor(plr)
    nameLabel.Font = Enum.Font.Gotham
    nameLabel.TextSize = Settings.espNameSize
    nameLabel.TextStrokeTransparency = 0.3
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.Visible = Settings.espShowName

    local distLabel = Instance.new("TextLabel", frame)
    distLabel.Size = UDim2.new(1, 0, 0, Settings.espDistSize + 4)
    distLabel.Position = UDim2.new(0, 0, 0, Settings.espTeamSize + Settings.espNameSize + 8)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = ""
    distLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
