local function getRainbowColor()
    local hue = (tick() % 3) / 3
    return Color3.fromHSV(hue, 0.9, 1)
end

local function isVisible(myHead, targetHead, targetChar)
    if not Settings.wallCheck then return true end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
    raycastParams.IgnoreWater = true
    local origin = myHead.Position
    local direction = targetHead.Position - origin
    local result = workspace:Raycast(origin, direction, raycastParams)
    if not result or result.Instance:IsDescendantOf(targetChar) then
        return true
    end
    return false
end

local function checkTargetTeam(plr)
    local targetTeam = plr.Team and plr.Team.Name
    if not Settings.targetGuards and not Settings.targetInmates and not Settings.targetCriminals then
        return true
    end
    if targetTeam == "Guards"    and Settings.targetGuards    then return true end
    if targetTeam == "Inmates"   and Settings.targetInmates   then return true end
    if targetTeam == "Criminals" and Settings.targetCriminals then return true end
    return false
end

local function checkHostileTrespass(plr)
    local char = plr.Character
    if not char then return false end
    local targetTeam = plr.Team and plr.Team.Name
    if targetTeam ~= "Inmates" then return true end
    local hostile = char:GetAttribute("Hostile")
    local trespass = char:GetAttribute("Trespassing")
    if Settings.hostileCheck and Settings.trespassCheck then
        return hostile or trespass
    elseif Settings.hostileCheck then
        return hostile == true
    elseif Settings.trespassCheck then
        return trespass == true
    end
    return true
end

local function getNearest(maxDist)
    maxDist = maxDist or Settings.maxDistance
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") or not myChar:FindFirstChild("Head") then return nil end
    local myHead = myChar.Head
    local myPos = myChar.HumanoidRootPart.Position
    local nearest, minDist = nil, maxDist

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChildOfClass("Humanoid") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                if not checkTargetTeam(plr) then continue end
                if not checkHostileTrespass(plr) then continue end
                local targetHead = plr.Character.Head
                local dist = (targetHead.Position - myPos).Magnitude
                if dist < minDist then
                    if isVisible(myHead, targetHead, plr.Character) then
                        nearest = plr
                        minDist = dist
                    end
                end
            end
        end
    end
    return nearest
end

local function getToolAmmo(tool)
    if not tool then return nil end
    local ammoVal = tool:FindFirstChild("CurrentAmmo")
    if ammoVal and (ammoVal:IsA("IntValue") or ammoVal:IsA("NumberValue")) then
        return ammoVal.Value
    end
    return tool:GetAttribute("CurrentAmmo")
end

