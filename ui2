local function updateESPSizes()
    for _, objs in pairs(espObjects) do
        local billboard = objs[1]
        local teamLabel, nameLabel, distLabel = objs[2], objs[3], objs[4]
        if teamLabel then
            teamLabel.TextSize = Settings.espTeamSize
            teamLabel.Size = UDim2.new(1,0,0,Settings.espTeamSize+4)
            teamLabel.Visible = Settings.espShowTeam
        end
        if nameLabel then
            nameLabel.TextSize = Settings.espNameSize
            nameLabel.Size = UDim2.new(1,0,0,Settings.espNameSize+4)
            nameLabel.Visible = Settings.espShowName
        end
        if distLabel then
            distLabel.TextSize = Settings.espDistSize
            distLabel.Size = UDim2.new(1,0,0,Settings.espDistSize+4)
            distLabel.Visible = Settings.espShowDistance
        end
        local totalH = 0
        if Settings.espShowTeam then totalH = totalH + Settings.espTeamSize + 4 end
        if Settings.espShowName then totalH = totalH + Settings.espNameSize + 4 end
        if Settings.espShowDistance then totalH = totalH + Settings.espDistSize + 4 end
        local y = 0
        if teamLabel then teamLabel.Position = UDim2.new(0,0,0,y) if Settings.espShowTeam then y = y + Settings.espTeamSize + 4 end end
        if nameLabel then nameLabel.Position = UDim2.new(0,0,0,y) if Settings.espShowName then y = y + Settings.espNameSize + 4 end end
        if distLabel then distLabel.Position = UDim2.new(0,0,0,y) end
        if billboard then billboard.Size = UDim2.new(0, 200, 0, totalH + 10) end
    end
end

local function toggleESP(enabled)
    if espConn then espConn:Disconnect() espConn = nil end
    if not enabled then clearESP() return end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then createESP(plr) end
    end
    Players.PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function(char)
            if Settings.espEnabled then task.wait(0.5) createESP(plr) end
        end)
    end)
    espConn = RunService.RenderStepped:Connect(function()
        if not Settings.espEnabled then return end
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
        local myPos = myChar.HumanoidRootPart.Position

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health <= 0 then removeESPForPlayer(plr.Name) continue end
                local head = plr.Character:FindFirstChild("Head")
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if head and hrp then
                    if not espObjects[plr.Name] then createESP(plr) end
                    local objs = espObjects[plr.Name]
                    if objs and objs[4] then
                        objs[4].Text = math.floor((hrp.Position - myPos).Magnitude) .. "m"
                    end
                    local color = getESPColor(plr)
                    if objs[2] then objs[2].TextColor3 = color end
                    if objs[3] then objs[3].TextColor3 = color end
                    if objs[2] then
                        objs[2].Text = "[" .. (plr.Team and plr.Team.Name or "Unknown") .. "]"
                    end
                end
            end
        end
        for plrName, _ in pairs(espObjects) do
            local found = false
            for _, plr in pairs(Players:GetPlayers()) do
                if plr.Name == plrName then found = true break end
            end
            if not found then removeESPForPlayer(plrName) end
        end
    end)
end

