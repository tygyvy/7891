	function GetNearestCloset()
		local closest = nil
		local MaxDistance = math.huge
		local currentRoomName = LocalPlayer:GetAttribute("CurrentRoom")
		local assets = workspace.CurrentRooms[currentRoomName]
		if assets then
			for _, v in ipairs(assets:GetDescendants()) do
				local validHide = table.find({"Wardrobe","Rooms_Locker","Rooms_Locker_Fridge","Toolshed","Locker_Large","Backdoor_Wardrobe","Bed","Double_Bed"},v.Name)
				if validHide and v.PrimaryPart then
					local dist = (LocalPlayer.Character.HumanoidRootPart.Position - v.PrimaryPart.Position).Magnitude
					if dist < MaxDistance then
						closest = v
						MaxDistance = dist 
					end
				end
			end
		end
		return closest
	end

	function GetNearestLocker()
		local closest = nil
		local MaxDistance = math.huge
		for _, v in ipairs(workspace.CurrentRooms:GetDescendants()) do
			if (v.Name == "Rooms_Locker" or v.Name == "Rooms_Locker_Fridge") and v.PrimaryPart then
				local dist = (LocalPlayer.Character.HumanoidRootPart.Position - v.PrimaryPart.Position).Magnitude
				if dist < MaxDistance then
					closest = v
					MaxDistance = dist
				end
			end
		end
		return closest
	end

