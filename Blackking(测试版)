function WaitForChildOfClass(Parent, ClassName)
	local obj = Parent:FindFirstChildOfClass(ClassName)
	if obj then return obj end
	repeat
		obj = Parent.DescendantAdded:Wait()
	until obj:IsA(ClassName)
	return obj
end

