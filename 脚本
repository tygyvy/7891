-- ==============================================
-- Roblox 四大游戏聚合脚本（Doors/森林99夜/死铁轨/僵尸）
-- 卡密：7891
-- 每个游戏功能完全独立，不共用逻辑
-- ==============================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:FindFirstChildOfClass("Humanoid")
local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")
local Camera = workspace.CurrentCamera

-- UI全局
local MainGui, LoadGui, MenuGui, FuncGui
local Verified = false
local CurrentGame = nil

-- 保存原始属性
local OriginalWalkSpeed = Humanoid.WalkSpeed
local OriginalFov = Camera.FieldOfView
local OriginalBrightness = Camera.Brightness

-- 清理UI
local function ClearUI()
    if MainGui then MainGui:Destroy() MainGui = nil end
    if LoadGui then LoadGui:Destroy() LoadGui = nil end
    if MenuGui then MenuGui:Destroy() MenuGui = nil end
    if FuncGui then FuncGui:Destroy() FuncGui = nil end
end

-- ==============================================
-- 1. 卡密界面（7891）
-- ==============================================
local function LoginUI()
    ClearUI()
    MainGui = Instance.new("ScreenGui")
    MainGui.Parent = CoreGui

    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0,320,0,180)
    Frame.Position = UDim2.new(0.5,-160,0.5,-90)
    Frame.BackgroundColor3 = Color3.new(0.08,0.08,0.12)
    Frame.BorderSizePixel = 2
    Frame.BorderColor3 = Color3.new(0,1,1)
    Frame.Parent = MainGui

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1,0,0,40)
    Title.BackgroundTransparency = 1
    Title.Text = "多游戏聚合脚本"
    Title.TextColor3 = Color3.new(1,1,1)
    Title.TextSize = 22
    Title.Parent = Frame

    local KeyBox = Instance.new("TextBox")
    KeyBox.Size = UDim2.new(0.8,0,0,40)
    KeyBox.Position = UDim2.new(0.1,0,0.35,0)
    KeyBox.BackgroundColor3 = Color3.new(0.15,0.15,0.2)
    KeyBox.TextColor3 = Color3.new(1,1,1)
    KeyBox.PlaceholderText = "输入卡密"
    KeyBox.TextSize = 18
    KeyBox.Parent = Frame

    local Confirm = Instance.new("TextButton")
    Confirm.Size = UDim2.new(0.8,0,0,40)
    Confirm.Position = UDim2.new(0.1,0,0.65,0)
    Confirm.BackgroundColor3 = Color3.new(0,0.5,1)
    Confirm.Text = "确认"
    Confirm.TextColor3 = Color3.new(1,1,1)
    Confirm.TextSize = 18
    Confirm.Parent = Frame

    Confirm.MouseButton1Click:Connect(function()
        if KeyBox.Text == "7891" then
            Verified = true
            LoadingUI()
        else
            KeyBox.Text = ""
            KeyBox.PlaceholderText = "卡密错误"
        end
    end)
end

