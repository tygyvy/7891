<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>森林99夜脚本界面</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Microsoft YaHei,sans-serif}
body{background:#111;color:#fff;min-height:100vh;padding:20px}
.page{display:none;min-height:100vh;flex-direction:column;align-items:center;justify-content:center;gap:18px}
.page.active{display:flex}
.float-box{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#0066cc;color:#fff;padding:12px 26px;border-radius:10px;box-shadow:0 0 15px #0099ff;display:none;z-index:99}
input#key{padding:10px 14px;width:200px;border-radius:6px;border:none;text-align:center}
button{padding:10px 20px;background:#007bff;color:#fff;border:none;border-radius:6px;cursor:pointer}
.btn-summon{background:#cc7000;padding:6px 12px;font-size:12px}
.progress-bar{width:280px;height:8px;background:#333;border-radius:4px;overflow:hidden}
.progress{height:100%;background:#007bff;width:0%}
.menu-item{background:#222;padding:16px;width:260px;text-align:center;border-radius:8px;cursor:pointer}
.func-box{width:100%;max-width:420px;display:flex;flex-direction:column;gap:10px}
.func-item{background:#222;padding:12px 14px;border-radius:8px;display:flex;align-items:center;justify-content:space-between}
.func-name{flex:1;font-size:14px}
.slider{width:100px;height:6px;background:#444;border-radius:3px;appearance:none;outline:none}
.slider::-webkit-slider-thumb{appearance:none;width:16px;height:16px;background:#007bff;border-radius:50%}
.switch{width:44px;height:22px;background:#555;border-radius:11px;position:relative}
.switch::after{content:'';position:absolute;width:18px;height:18px;background:#fff;border-radius:50%;top:2px;left:2px;transition:.2s}
.switch.on{background:#007bff}
.switch.on::after{left:24px}
</style>
</head>
<body>

<!-- 悬浮提示 -->
<div class="float-box" id="floatTip">欢迎使用森林中99夜脚本</div>

<!-- 1 卡网输入 -->
<div class="page active" id="page1">
  <h2>请输入卡网</h2>
  <input type="text" id="key" placeholder="输入卡网">
  <button onclick="checkKey()">确认</button>
</div>

<!-- 2 加载 -->
<div class="page" id="page2">
  <h3>正在加载...</h3>
  <div class="progress-bar"><div class="progress" id="p1"></div></div>
</div>

<!-- 3 主菜单 -->
<div class="page" id="page3">
  <h2>主菜单</h2>
  <div class="menu-item" onclick="gotoFuncLoad()">森林中的99个夜晚</div>
  <div class="menu-item" onclick="alert('Doors 功能未开放')">Doors</div>
</div>

<!-- 4 功能加载 -->
<div class="page" id="page4">
  <h3>正在加载功能...</h3>
  <div class="progress-bar"><div class="progress" id="p2"></div></div>
</div>

<!-- 5 功能页面 -->
<div class="page" id="page5">
  <h2>森林中的99个夜晚</h2>
  <div class="func-box">
    <div class="func-item">
      <div class="func-name">杀戮光环 50~500</div>
      <input type="range" class="slider" min="50" max="500" value="100">
      <div class="switch" onclick="this.classList.toggle('on')"></div>
    </div>
    <div class="func-item">
      <div class="func-name">无敌模式</div>
      <div class="switch" onclick="this.classList.toggle('on')"></div>
    </div>
    <div class="func-item">
      <div class="func-name">速度调节 16~200</div>
      <input type="range" class="slider" min="16" max="200" value="50">
      <div class="switch" onclick="this.classList.toggle('on')"></div>
    </div>
    <div class="func-item">
      <div class="func-name">150%范围燃料放入篝火</div>
      <button class="btn-summon" onclick="alert('已执行召唤')">召唤</button>
    </div>
    <div class="func-item">
      <div class="func-name">召唤废料范围150%</div>
      <div class="switch" onclick="this.classList.toggle('on')"></div>
    </div>
    <div class="func-item">
      <div class="func-name">自动收集木头150%范围</div>
      <button class="btn-summon" onclick="alert('已执行召唤')">召唤</button>
    </div>
    <div class="func-item">
      <div class="func-name">无限跳</div>
      <div class="switch" onclick="this.classList.toggle('on')"></div>
    </div>
    <div class="func-item">
      <div class="func-name">亮度100</div>
      <div class="switch" onclick="this.classList.toggle('on')"></div>
    </div>
    <div class="func-item">
      <div class="func-name">飞行 1~100</div>
      <input type="range" class="slider" min="1" max="100" value="20">
      <div class="switch" onclick="this.classList.toggle('on')"></div>
    </div>
  </div>
</div>

<script>
// 验证卡网
function checkKey(){
  let v=document.getElementById('key').value.trim()
  if(v==='67'){
    let tip=document.getElementById('floatTip')
    tip.style.display='block'
    setTimeout(()=>{
      tip.style.display='none'
      show(2)
      load1()
    },1500)
  }else{
    alert('卡网错误')
  }
}

// 切换页面
function show(n){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'))
  document.getElementById('page'+n).classList.add('active')
}

// 第一次加载
function load1(){
  let p=document.getElementById('p1')
  let w=0
  let t=setInterval(()=>{
    w++
    p.style.width=w+'%'
    if(w>=100){clearInterval(t);setTimeout(()=>show(3),200)}
  },20)
}

// 功能加载
function gotoFuncLoad(){
  show(4)
  let p=document.getElementById('p2')
  let w=0
  let t=setInterval(()=>{
    w++
    p.style.width=w+'%'
    if(w>=100){clearInterval(t);setTimeout(()=>show(5),200)}
  },20)
}
</script>
</body>
</html>
