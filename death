local function SendCaption(Text)
	if firesignal then
		firesignal(RemotesFolder.Caption.OnClientEvent, "[Abysall Hub] " .. Text)
	else
		RemotesFolder.CaptionClient:Fire("[Abysall Hub] " .. Text)
	end
end

-- ===== 立即死亡函数 =====
local function KillNow()
	local Char = LocalPlayer.Character
	if not Char then return false end

	local Hum = Char:FindFirstChildOfClass("Humanoid")
	if not Hum then return false end

	-- 优先用 replicatesignal 在服务器端击杀
	if replicatesignal then
		replicatesignal(LocalPlayer.Kill)
		return true
	end

	-- 没有 replicatesignal 就本地设 Health 为 0
	Hum.Health = 0
	return true
end

-- ===== 等待当前角色并立刻死亡 =====
local function WaitAndKill()
	while not LocalPlayer.Character do task.wait(0.1) end
	while not LocalPlayer.Character:FindFirstChildOfClass("Humanoid") do task.wait(0.1) end
	KillNow()
end

