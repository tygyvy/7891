local function Reg(inst, cat, label)
    if not inst or not inst.Parent then return end
    if Tracked[inst] then return end
    local color = ESP_COLORS[cat] or Color3.new(1,1,1)
    local esp = CreateESP(inst, label or cat, color, Cfg.ESPRange)
    if esp then
        esp.Cat = cat
        Tracked[inst] = esp
    end
end

