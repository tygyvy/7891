-- ================= 清理 =================
Library:OnUnload(function()
    for inst in pairs(Tracked) do DestroyESP(inst) end
    if UpdateConn then UpdateConn:Disconnect() end
    if MoveConn then MoveConn:Disconnect() end
    if AutoInteractConn then AutoInteractConn:Disconnect() end
    if AutoHideConn then AutoHideConn:Disconnect() end
    if promptConn then promptConn:Disconnect() end
    if idledConn then idledConn:Disconnect() end
    if ACMBody then ACMBody:Destroy() end
    if Cfg.Fullbright then ApplyFullbright(false) end
    if Cfg.NoFog then ApplyNoFog(false) end
    if Cfg.InstantPrompt then ApplyInstantPrompt(false) end
    if Cfg.DisableIdleKick then ApplyIdleKick(false) end
    for _, v in ipairs(ESPFolder:GetChildren()) do v:Destroy() end
    if tracerGui then tracerGui:Destroy() end
    if gui then gui:Destroy() end
    for name in pairs(fakeRemotes) do RestoreRemote(name) end
end)

