    if Cfg.NoFog then ApplyNoFog(false) end
    if Cfg.InstantPrompt then ApplyInstantPrompt(false) end
    if Cfg.DisableIdleKick then ApplyIdleKick(false) end
    for _, v in ipairs(ESPFolder:GetChildren()) do v:Destroy() end
