local AntiSlideBase = nil

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    if AntiSlideBase == nil then
        AntiSlideBase = hum.WalkSpeed
    end

    if hum.WalkSpeed > AntiSlideBase then
        hum.WalkSpeed = AntiSlideBase
    end

    local v = root.AssemblyLinearVelocity
    local flat = Vector3.new(v.X, 0, v.Z)
    if flat.Magnitude > AntiSlideBase then
        root.AssemblyLinearVelocity = Vector3.new(
            flat.Unit.X * AntiSlideBase,
            v.Y,
            flat.Unit.Z * AntiSlideBase
        )
    end
end)

