local fakeRemotes = {}

local function GetRemotesFolder()
    return RS:FindFirstChild("RemotesFolder") or RS:FindFirstChild("EntityInfo") or RS:FindFirstChild("Bricks")
end

local function ReplaceRemote(name)
    local rf = GetRemotesFolder()
    if not rf then return end
    local real = rf:FindFirstChild(name)
    if not real or fakeRemotes[name] then return end
    local fake = Instance.new("RemoteEvent")
    fake.Name = name
    fake.Parent = rf
    real.Parent = nil
    fakeRemotes[name] = { real = real, fake = fake }
end

local function RestoreRemote(name)
    local data = fakeRemotes[name]
    if not data then return end
    if data.real then data.real.Parent = data.fake.Parent end
    if data.fake then data.fake:Destroy() end
    fakeRemotes[name] = nil
end

local function GetEntityModules()
    local cm = RS:FindFirstChild("ModulesClient") or RS:FindFirstChild("ClientModules")
    return cm and cm:FindFirstChild("EntityModules")
end

local function DisableModule(container, name)
    if not container then return end
    for _, m in ipairs(container:GetDescendants()) do
        if m:IsA("ModuleScript") and m.Name == name and not m.Name:find("_Disabled") then
            m.Name = name .. "_Disabled"
            return true
        end
    end
end

local function EnableModule(container, name)
    if not container then return end
    for _, m in ipairs(container:GetDescendants()) do
        if m:IsA("ModuleScript") and m.Name == name .. "_Disabled" then
            m.Name = name
            return true
        end
    end
end

local function HandleEntity(name, model, on)
    if name == "GiggleCeiling" then
        local hb = model:FindFirstChild("Hitbox")
        if hb and hb:IsA("BasePart") then hb.CanTouch = not on end
    elseif name == "DoorFake" or name == "FakeDoor" then
        local hidden = model:FindFirstChild("Hidden")
        if hidden and hidden:IsA("BasePart") then hidden.CanTouch = not on end
        local lock = model:FindFirstChild("Lock")
        if lock and lock:FindFirstChild("UnlockPrompt") then lock.UnlockPrompt.Enabled = not on end
    elseif name == "Snare" then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = not on end
        end
    elseif name == "JeffTheKiller" then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = not on p.CanTouch = not on end
        end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and on then hum.Health = 0 end
    elseif name == "SideroomSpace" then
        local col = model:FindFirstChild("Collision")
        if col and col:IsA("BasePart") then col.CanCollide = on col.CanTouch = not on end
    elseif name == "GloomPile" then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = not on end
        end
    end
end

local function HandleObstruction(name, obj, on)
    if name == "Lava" and obj:IsA("BasePart") then
        obj.CanTouch = not on
    elseif name == "ScaryWall" then
        for _, p in ipairs(obj:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = not on p.CanCollide = not on end
        end
    elseif name == "SeekFloodline" and obj:IsA("BasePart") then
        obj.CanCollide = on
    elseif name == "Seek_Arm" or name == "ChandelierObstruction" then
        for _, p in ipairs(obj:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = not on end
        end
    elseif name == "BananaPeel" and obj:IsA("BasePart") then
        obj.CanTouch = not on
    end
end

