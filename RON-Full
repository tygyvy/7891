local promptOrig = setmetatable({}, { __mode = "k" })
local promptConn = nil

local function MakeInstant(pp)
    if not pp:IsA("ProximityPrompt") then return end
    if pp:GetAttribute("RON_FakePrompt") then return end
    if promptOrig[pp] == nil then promptOrig[pp] = pp.HoldDuration end
    pp.HoldDuration = 0
end

local function ApplyInstantPrompt(on)
    if on then
        task.spawn(function()
            local n = 0
            for _, d in ipairs(Workspace:GetDescendants()) do
                if not Cfg.InstantPrompt then return end
                if d:IsA("ProximityPrompt") then pcall(MakeInstant, d) end
                n = n + 1
                if n % 400 == 0 then task.wait() end
            end
        end)
        if not promptConn then
            promptConn = Workspace.DescendantAdded:Connect(function(d)
                if Cfg.InstantPrompt and d:IsA("ProximityPrompt") then
                    task.defer(pcall, MakeInstant, d)
                end
            end)
        end
    else
        if promptConn then promptConn:Disconnect() promptConn = nil end
        for pp, orig in pairs(promptOrig) do
            if pp.Parent then pcall(function() pp.HoldDuration = orig end) end
            promptOrig[pp] = nil
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.5)
        if Cfg.InstantPrompt then
            for pp in pairs(promptOrig) do
                if pp.Parent and pp.HoldDuration ~= 0 then pp.HoldDuration = 0 end
            end
        end
    end
end)

-- 交互范围扩展
local reachOrig = setmetatable({}, { __mode = "k" })

local function ApplyReach(pp)
    if not pp:IsA("ProximityPrompt") then return end
    if pp:GetAttribute("RON_FakePrompt") then return end
    local o = reachOrig[pp]
    if not o then
        o = { Dist = pp.MaxActivationDistance, LOS = pp.RequiresLineOfSight }
        reachOrig[pp] = o
    end
    pp.MaxActivationDistance = o.Dist * Cfg.PromptReach
    pp.RequiresLineOfSight = Cfg.PromptClip and false or o.LOS
end

local function ApplyReachAll()
    task.spawn(function()
        local n = 0
        for _, d in ipairs(Workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") then pcall(ApplyReach, d) end
            n = n + 1
            if n % 400 == 0 then task.wait() end
        end
        for pp in pairs(reachOrig) do
            if pp.Parent then pcall(ApplyReach, pp) end
        end
    end)
end

