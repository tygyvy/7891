-- ==================== 注册 ====================
local function RemoveEntry(inst)
    local e = S_Tracked[inst]
    if not e then return end
    S_Tracked[inst] = nil
    if e.Conn then pcall(e.Conn.Disconnect, e.Conn) e.Conn = nil end
    if e.HL then pcall(function() e.HL:Destroy() end) end
    if e.BB then pcall(function() e.BB:Destroy() end) end
end

local function Register(inst, cat, label, opts)
    if not inst or not inst.Parent then return end
    if not Active[cat] then return end

    if cat == "entities" and label == "Mandrake" and not (opts and opts.Direct) then
        if not S_Tracked[inst] and not Watch.M[inst] and not Watch.IsBurrowName(inst.Name) then
            Watch.M[inst] = { Opts = opts }
            Watch.Run()
        end
        return
    end

    local existing = S_Tracked[inst]
    if existing then
        if cat == existing.Cat then return end
        RemoveEntry(inst)
    end

    local part = (opts and opts.Part) or S_GetPart(inst)
    if not part then return end

    local conn = inst.AncestryChanged:Connect(function(_, parent)
        if not parent then RemoveEntry(inst) end
    end)

    local color = COLORS[cat] or Color3.new(1,1,1)
    local esp = CreateESP(inst, label or cat, color, Cfg.ESPRange)
    if not esp then return end
    esp.Cat = cat
    esp.Inst = inst
    esp.Part = part
    esp.Label = label or cat
    esp.Conn = conn
    esp.Known = opts and opts.Known
    esp.Key = opts and opts.Key
    esp.Prompt = opts and opts.Prompt
    esp.GeoT = 0
    esp.NoGeo = false
    esp.RoomNum = opts and opts.RoomNum
    esp.Door = opts and opts.Door
    esp.Dist = 0
    esp.Shown = false
    S_Tracked[inst] = esp
end

local function RegisterWhenReady(inst, cat, label)
    Register(inst, cat, label)
    if S_Tracked[inst] or S_GetPart(inst) then return end
    task.spawn(function()
        for _ = 1, 30 do
            task.wait(0.2)
            if not inst.Parent or S_Tracked[inst] then return end
            if S_GetPart(inst) then Register(inst, cat, label) return end
        end
    end)
end

local function RegisterByName(target)
