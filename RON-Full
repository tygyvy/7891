    else
        deltaLabel.Text = ""
    end
    local labels = { ready = "Start", running = "Pause", paused = "Resume", finished = "Restart" }
    btnMain.Text = labels[TT.state]
end
local function DrawSplits()
    local n = #TT.list
    local first = math.max(1, n - 4)
    for i = 1, 5 do
        local rec, r = TT.list[first + i - 1], rows[i]
        if rec then
            r.f.Visible = true
            r.n.Text = "Room " .. rec.room
            r.t.Text = FmtFull(rec.t)
            if rec.delta then
                r.d.Text = FmtDelta(rec.delta)
                r.d.TextColor3 = rec.delta > 0 and C.behind or C.run
            else
                r.d.Text = "-" r.d.TextColor3 = C.dim
            end
        else
            r.f.Visible = false
        end
    end
end
RenderAll = function() DrawBig() DrawInfo() DrawSplits() end

local function Reset()
    TT.state, TT.acc, TT.t0, TT.list, TT.highest, TT.delta, TT.newPB = "ready", 0, 0, {}, 0, nil, false
    RenderAll()
end
local function Start()
    if TT.state ~= "ready" then return end
    TT.acc, TT.t0, TT.list, TT.highest, TT.delta, TT.newPB = 0, os.clock(), {}, CurRoom(), nil, false
    TT.state = "running"
    RenderAll()
end
local function Pause()
    if TT.state ~= "running" then return end
    TT.acc = Elapsed()
    TT.state = "paused"
    RenderAll()
end
local function Resume()
    if TT.state ~= "paused" then return end
    TT.t0 = os.clock()
    TT.state = "running"
    RenderAll()
end
local function Finish()
    if TT.state ~= "running" and TT.state ~= "paused" then return end
    TT.acc = Elapsed()
    TT.state = "finished"
    local fl = FloorName()
    if fl ~= "Lobby" and #TT.list >= 10 and (not PB[fl] or TT.acc < PB[fl].pb) then
        local splits = {}
        for _, rec in ipairs(TT.list) do splits[tostring(rec.room)] = rec.t end
        PB[fl] = { pb = TT.acc, splits = splits }
        SavePB()
        TT.newPB = true
        pcall(function() Library:Notify("新 PB！", FmtFull(TT.acc) .. "  -  " .. fl, 5) end)
    else
        pcall(function() Library:Notify("速通结束", FmtFull(TT.acc), 4) end)
    end
    RenderAll()
end
local function Toggle()
    if TT.state == "ready" then Start()
    elseif TT.state == "running" then Pause()
    elseif TT.state == "paused" then Resume()
    else Reset() Start() end
end

