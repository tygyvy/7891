                        orbitPause = now + 2
                        for _, it in ipairs(list) do MoveObj(it, CFrame.new(hrp.Position)) end
                    end
                    if now >= orbitPause then
                        orbitAngle = orbitAngle + (1/60) * Cfg.OrbitSpeed
                        for i, it in ipairs(list) do
                            local a = orbitAngle + ((i - 1) / count) * math.pi * 2
                            local off = Vector3.new(math.cos(a) * Cfg.OrbitDistance, Cfg.OrbitHeight, math.sin(a) * Cfg.OrbitDistance)
                            MoveObj(it, CFrame.new(hrp.Position + off))
                        end
                    end
                end
            end
        end
    end
end)

