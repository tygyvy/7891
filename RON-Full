    elseif name == "DoorFake" or name == "FakeDoor" then
        local hidden = model:FindFirstChild("Hidden")
        if hidden and hidden:IsA("BasePart") then hidden.CanTouch = not on end
        local lock = model:FindFirstChild("Lock")
        if lock and lock:FindFirstChild("UnlockPrompt") then lock.UnlockPrompt.Enabled = not on end
