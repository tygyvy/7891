local fakeRemotes = {}

local function GetRemotesFolder()
    return RS:FindFirstChild("RemotesFolder") or RS:FindFirstChild("EntityInfo") or RS:FindFirstChild("Bricks")
end

local function ReplaceRemote(name)
    local rf = GetRemotesFolder()
    if not rf then return end
    local real = rf:FindFirstChild(name)
    if not real or fakeRemotes[name] then return end
    local fake = Instance.new("RemoteEvent")
    fake.Name = name
    fake.Parent = rf
    real.Parent = nil
    fakeRemotes[name] = { real = real, fake = fake }
end

local function RestoreRemote(name)
    local data = fakeRemotes[name]
    if not data then return end
    if data.real then data.real.Parent = data.fake.Parent end
    if data.fake then data.fake:Destroy() end
    fakeRemotes[name] = nil
end

local function GetEntityModules()
    local cm = RS:FindFirstChild("ModulesClient") or RS:FindFirstChild("ClientModules")
    return cm and cm:FindFirstChild("EntityModules")
end

local function DisableModule(container, name)
    if not container then return end
    for _, m in ipairs(container:GetDescendants()) do
        if m:IsA("ModuleScript") and m.Name == name and not m.Name:find("_Disabled") then
            m.Name = name .. "_Disabled"
            return true
        end
    end
end

local function EnableModule(container, name)
    if not container then return end
    for _, m in ipairs(container:GetDescendants()) do
        if m:IsA("ModuleScript") and m.Name == name .. "_Disabled" then
            m.Name = name
            return true
        end
    end
end

local function HandleEntity(name, model, on)
    if name == "GiggleCeiling" then
        local hb = model:FindFirstChild("Hitbox")
        if hb and hb:IsA("BasePart") then hb.CanTouch = not on end
    elseif name == "DoorFake" or name == "FakeDoor" then
        local hidden = model:FindFirstChild("Hidden")
        if hidden and hidden:IsA("BasePart") then hidden.CanTouch = not on end
        local lock = model:FindFirstChild("Lock")
        if lock and lock:FindFirstChild("UnlockPrompt") then lock.UnlockPrompt.Enabled = not on end
    elseif name == "Snare" then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = not on end
        end
    elseif name == "JeffTheKiller" then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = not on p.CanTouch = not on end
        end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and on then hum.Health = 0 end
    elseif name == "SideroomSpace" then
        local col = model:FindFirstChild("Collision")
        if col and col:IsA("BasePart") then col.CanCollide = on col.CanTouch = not on end
    elseif name == "GloomPile" then
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = not on end
        end
    end
end

local function HandleObstruction(name, obj, on)
    if name == "Lava" and obj:IsA("BasePart") then
        obj.CanTouch = not on
    elseif name == "ScaryWall" then
        for _, p in ipairs(obj:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = not on p.CanCollide = not on end
        end
    elseif name == "SeekFloodline" and obj:IsA("BasePart") then
        obj.CanCollide = on
    elseif name == "Seek_Arm" or name == "ChandelierObstruction" then
        for _, p in ipairs(obj:GetDescendants()) do
            if p:IsA("BasePart") then p.CanTouch = not on end
        end
    elseif name == "BananaPeel" and obj:IsA("BasePart") then
        obj.CanTouch = not on
    end
end

local function ApplyAntis()
    for _, c in ipairs(Workspace:GetChildren()) do
        if c:IsA("Model") then
            if Cfg.BypassGiggle and c.Name == "GiggleCeiling" then HandleEntity(c.Name, c, true) end
            if Cfg.BypassDupe and (c.Name == "DoorFake" or c.Name == "FakeDoor") then HandleEntity(c.Name, c, true) end
            if Cfg.BypassSnare and c.Name == "Snare" then HandleEntity(c.Name, c, true) end
            if Cfg.BypassJeff and c.Name == "JeffTheKiller" then HandleEntity(c.Name, c, true) end
            if Cfg.BypassVacuum and c.Name == "SideroomSpace" then HandleEntity(c.Name, c, true) end
            if Cfg.BypassGloombatEggs and c.Name == "GloomPile" then HandleEntity(c.Name, c, true) end
            if Cfg.BypassKillbricks and c.Name == "Lava" then HandleObstruction(c.Name, c, true) end
            if Cfg.BypassSeekingWall and c.Name == "ScaryWall" then HandleObstruction(c.Name, c, true) end
            if Cfg.BypassBanana and c.Name == "BananaPeel" then HandleObstruction(c.Name, c, true) end
            if Cfg.BypassSeekObstructions then
                if c.Name == "SeekFloodline" or c.Name == "Seek_Arm" or c.Name == "ChandelierObstruction" then
                    HandleObstruction(c.Name, c, true)
                end
            end
        end
    end

    local mods = GetEntityModules()
    if mods then
        if Cfg.RemoveScreech then DisableModule(mods, "Screech") else EnableModule(mods, "Screech") end
        if Cfg.RemoveHalt then DisableModule(mods, "Shade") else EnableModule(mods, "Shade") end
        if Cfg.RemoveA90 then DisableModule(mods, "A90") else EnableModule(mods, "A90") end
        if Cfg.RemoveDread then DisableModule(mods, "Dread") else EnableModule(mods, "Dread") end
    end

    if Cfg.NoScreechDamage then ReplaceRemote("Screech") else RestoreRemote("Screech") end
    if Cfg.NoHaltDamage then ReplaceRemote("ShadeResult") else RestoreRemote("ShadeResult") end
    if Cfg.NoA90Damage then ReplaceRemote("A90") else RestoreRemote("A90") end

    if Cfg.RemoveSeekTrigger then
        local rooms = Workspace:FindFirstChild("CurrentRooms")
        local hrp = GetHRP()
        if rooms and hrp and firetouchinterest then
            for _, room in ipairs(rooms:GetChildren()) do
                local trigger = room:FindFirstChild("TriggerEventCollision")
                if trigger and trigger:IsA("BasePart") then
                    pcall(function()
                        firetouchinterest(hrp, trigger, 0)
                        task.wait()
                        firetouchinterest(hrp, trigger, 1)
                    end)
                end
            end
        end
    end

    if Cfg.RemoveFigure then
        for _, name in ipairs({ "FigureRig", "Figure", "FigureRagdoll" }) do
            local fig = Workspace:FindFirstChild(name)
            if fig then
                for _, p in ipairs(fig:GetDescendants()) do
                    if p:IsA("BasePart") and isnetworkowner and isnetworkowner(p) then
                        p.Position = Vector3.new(-49999, -49999, -49999)
                    end
                end
            end
        end
    end

    if Cfg.RemoveBasementGate or Cfg.RemovePaintingsDoor or Cfg.RemoveSkeletonDoor then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("BasePart") then
                local match = (Cfg.RemoveBasementGate and obj.Name == "ThingToOpen")
                    or (Cfg.RemovePaintingsDoor and obj.Name == "MovingDoor")
                    or (Cfg.RemoveSkeletonDoor and obj.Name == "Wax_Door")
                if match then
                    pcall(function() obj:PivotTo(CFrame.new(-10000, -10000, -10000)) end)
                end
            end
        end
    end

    if Cfg.RemoveCutscenes then
        local cuts = { "Figure", "FigureEnd", "FigureHotelEnd", "SeekIntroFools",
                        "SeekIntroHotel", "SeekIntroMines", "SeekIntroMines2" }
        local mods2 = GetEntityModules()
        if mods2 then
            for _, name in ipairs(cuts) do DisableModule(mods2, name) end
        end
    end

    if Cfg.DisableEntityJumpscares then
        local mods3 = GetEntityModules()
        if mods3 then
            for _, m in ipairs(mods3:GetDescendants()) do
                if m:IsA("ModuleScript") and m.Name:find("Jumpscare") and not m.Name:find("_Disabled") then
                    m.Name = m.Name .. "_Disabled"
                end
            end
        end
    end
end

