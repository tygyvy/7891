            FBOrig = {
                Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
                Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
                GlobalShadows = Lighting.GlobalShadows,
            }
        end
        local amb = math.floor(math.clamp(Cfg.FBAmbient, 0, 100) / 100 * 255 + 0.5)
        local c = Color3.fromRGB(amb, amb, amb)
        Lighting.Brightness = math.clamp(Cfg.FBBrightness, 0, 10)
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.Ambient = c
        Lighting.OutdoorAmbient = c
    elseif FBOrig then
        for k, v in pairs(FBOrig) do pcall(function() Lighting[k] = v end) end
        FBOrig = nil
    end
end

local function ApplyNoFog(on)
    if on then
        if not FogOrig then
            FogOrig = { FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart }
        end
        Lighting.FogEnd = 100000
        Lighting.FogStart = 100000
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then
                if not AtmoOrig[a] then AtmoOrig[a] = { a.Density, a.Haze } end
                a.Density, a.Haze = 0, 0
            end
        end
    else
        if FogOrig then
            for k, v in pairs(FogOrig) do pcall(function() Lighting[k] = v end) end
            FogOrig = nil
        end
        for a, o in pairs(AtmoOrig) do
            if a.Parent then pcall(function() a.Density, a.Haze = o[1], o[2] end) end
            AtmoOrig[a] = nil
        end
    end
end

