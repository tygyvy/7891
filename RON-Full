            if next(ids) then
                for _, c in ipairs(hr:GetDescendants()) do
                    if IsBoxName(c.Name) then
                        local tid = c:GetAttribute("Tool_BoxID")
                        if tid ~= nil and ids[tostring(tid)] then Hon.Boxes[c] = tostring(tid) end
