if not ESPFolder.Parent then ESPFolder.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local Tracked = {}

local function CreateESP(inst, label, color, maxDist)
    if not inst or not inst.Parent then return nil end
    local part = GetPart(inst)
    if not part then return nil end
    local hl = Instance.new("Highlight")
    hl.Adornee = inst
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = 0.75
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = ESPFolder
    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.Size = UDim2.fromOffset(200, 50)
    bb.StudsOffset = Vector3.new(0, 2, 0)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Parent = ESPFolder
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.fromScale(1, 1)
    tl.BackgroundTransparency = 1
    tl.TextColor3 = color
    tl.TextStrokeTransparency = 0.3
    tl.Font = Enum.Font.Oswald
    tl.TextSize = 16
    tl.Text = label
    tl.Parent = bb
    return { Inst = inst, Part = part, HL = hl, BB = bb, TL = tl, Label = label, MaxDist = maxDist or 400 }
end

local function DestroyESP(inst)
    local e = Tracked[inst]
    if not e then return end
    if e.HL then e.HL:Destroy() end
    if e.BB then e.BB:Destroy() end
    Tracked[inst] = nil
end

local function UpdateESP()
    local hrp = GetHRP()
    for inst, e in pairs(Tracked) do
        if not inst.Parent then
            DestroyESP(inst)
        elseif not e.Part.Parent then
            local p = GetPart(inst)
            if p then e.Part = p e.BB.Adornee = p else DestroyESP(inst) end
        elseif hrp then
            local d = (e.Part.Position - hrp.Position).Magnitude
            local vis = d <= e.MaxDist
            e.HL.Enabled = vis
            e.BB.Enabled = vis
            if vis then e.TL.Text = string.format("%s [%dm]", e.Label, math.floor(d * 0.28)) end
        end
    end
end

local UpdateConn = RunService.Heartbeat:Connect(UpdateESP)

