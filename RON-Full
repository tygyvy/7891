local function GetCurrentFloor()
    local gd = RS:FindFirstChild("GameData")
    local fv = gd and gd:FindFirstChild("Floor")
    return fv and fv.Value or "?"
end

local function GetLatestRoom()
    local gd = RS:FindFirstChild("GameData")
    local lv = gd and gd:FindFirstChild("LatestRoom")
    return lv and lv.Value or 0
end

local function DoFloorSkip()
    local rooms = Workspace:FindFirstChild("CurrentRooms")
    if not rooms then return false end
    local lv = GetLatestRoom()
    local targetRoom = nil
    for _, room in ipairs(rooms:GetChildren()) do
        local n = tonumber(room.Name)
        if n and n >= lv then
            local door = room:FindFirstChild("Door")
            if door and door:GetAttribute("Opened") ~= true then
                targetRoom = door
                break
            end
        end
    end
    if not targetRoom then return false end
    local hrp = GetHRP()
    if not hrp then return false end
    local safe = true
    for _, m in ipairs(Workspace:GetChildren()) do
        if m:IsA("Model") and DANGER[m.Name] and m:GetAttribute("Inactive") ~= true then
            safe = false
            break
        end
    end
    if not safe then return false end
    local char = GetChar()
    if char then
        char:PivotTo(targetRoom:GetPivot() * CFrame.new(0, -1, 0))
        return true
    end
    return false
end

