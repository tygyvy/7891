local MoveConn = RunService.Heartbeat:Connect(function()
    local hum = GetHum()
    local hrp = GetHRP()
    if not hum or not hrp then return end

    if Cfg.SpeedEnabled then hum.WalkSpeed = Cfg.SpeedValue else hum.WalkSpeed = 16 end

    if Cfg.JumpEnabled then
        if hum.UseJumpPower then hum.JumpPower = Cfg.JumpPower
        else hum.JumpHeight = math.clamp(Cfg.JumpPower / 10, 7.2, 50) end
    else
        if hum.UseJumpPower then hum.JumpPower = 50 else hum.JumpHeight = 7.2 end
    end

    if Cfg.Noclip then
        local char = GetChar()
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end

    if Cfg.FlyEnabled then
        local mv = hum.MoveDirection
        local vy = 0
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vy = 1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vy = -1 end
