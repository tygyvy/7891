        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = not on p.CanTouch = not on end
        end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum and on then hum.Health = 0 end
    elseif name == "SideroomSpace" then
        local col = model:FindFirstChild("Collision")
        if col and col:IsA("BasePart") then col.CanCollide = on col.CanTouch = not on end
