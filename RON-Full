local function Colour()
    if TT.state == "ready" then return C.ready end
    if TT.state == "paused" then return C.pause end
    if TT.state == "finished" then return TT.newPB and C.gold or C.done end
    if TT.delta and TT.delta > 0 then return C.behind end
    return C.run
end
local function DrawBig()
    local main, ms = Fmt(Elapsed())
    local txt = string.format('%s<font size="%d">%s</font>', main, S(22), ms)
    if txt ~= lastBig then lastBig = txt big.Text = txt end
