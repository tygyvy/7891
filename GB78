local function destroyESP(model)
    local obj = T.espObjects[model]
    if not obj then return end
    for _, p in ipairs(obj.parts) do pcall(function() p:Destroy() end) end
    if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
    T.espObjects[model] = nil
end

local function clearAllESP()
    for m in pairs(T.espObjects) do destroyESP(m) end
    T.espObjects = {}
end

local function updateESP()
    local myRoot = root()
    if not myRoot then return end
    local myPos = myRoot.Position

    local zombiesFolder = Workspace:FindFirstChild("Zombies")
    if zombiesFolder then
        for _, m in ipairs(zombiesFolder:GetChildren()) do
            if m:IsA("Model") then
                local t = getZombieType(m)
                local shouldShow = S.ESPZombie and t and S.ESPZombieTypes[t]
                if shouldShow then
                    local mhrp = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or m:FindFirstChild("Torso")
                    if mhrp then
                        local d = (mhrp.Position - myPos).Magnitude
                        if d <= S.ESPMaxDistance then
                            if not T.espObjects[m] then
                                createESP(m, ZOMBIE_NAMES[t] or "僵尸", ZOMBIE_COLORS[t] or Color3.new(1,1,1), false)
                            end
                            local obj = T.espObjects[m]
                            if obj then
                                if obj.nameLbl then obj.nameLbl.Visible = S.ESPShowName end
                                if obj.healthLbl then
                                    obj.healthLbl.Visible = S.ESPShowHealth
                                    local h = m:FindFirstChildOfClass("Humanoid")
                                    if h then
                                        obj.healthLbl.Text = string.format("%d/%d", math.floor(h.Health), math.floor(h.MaxHealth))
                                        obj.healthLbl.TextColor3 = h.Health / h.MaxHealth > 0.5 and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,80,80)
                                    end
                                end
                                if obj.distLbl then
                                    obj.distLbl.Visible = S.ESPShowDistance
                                    obj.distLbl.Text = string.format("%d 米", math.floor(d))
                                end
                            end
                        else
                            destroyESP(m)
                        end
                    end
                else
                    destroyESP(m)
                end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local c = plr.Character
            local chrp = c:FindFirstChild("HumanoidRootPart")
            local ch = c:FindFirstChildOfClass("Humanoid")
            if chrp and ch and ch.Health > 0 then
                local d = (chrp.Position - myPos).Magnitude
                if S.ESPPlayer and d <= S.ESPMaxDistance then
                    if not T.espObjects[c] then
                        createESP(c, plr.DisplayName, Color3.fromRGB(0, 200, 255), true)
                    end
                    local obj = T.espObjects[c]
                    if obj then
                        if obj.nameLbl then obj.nameLbl.Visible = S.ESPShowName end
                        if obj.healthLbl then
                            obj.healthLbl.Visible = S.ESPShowHealth
                            obj.healthLbl.Text = string.format("%d/%d", math.floor(ch.Health), math.floor(ch.MaxHealth))
                            obj.healthLbl.TextColor3 = ch.Health / ch.MaxHealth > 0.5 and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,80,80)
                        end
                        if obj.distLbl then
                            obj.distLbl.Visible = S.ESPShowDistance
                            obj.distLbl.Text = string.format("%d 米", math.floor(d))
                        end
                    end
                else
                    destroyESP(c)
                end
            else
                destroyESP(c)
            end
        end
    end

    for m in pairs(T.espObjects) do
        if not m or not m.Parent then destroyESP(m) end
    end
end

