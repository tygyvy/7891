tbl.setupAutoCollect = function()
    if tbl.descendantAddedConn then tbl.descendantAddedConn:Disconnect() end
    for _, v16 in workspace:GetDescendants() do
        if v16:IsA("ProximityPrompt") then tbl.activePrompts[v16] = true end
    end
    tbl.descendantAddedConn = workspace.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("ProximityPrompt") then tbl.activePrompts[descendant] = true end
    end)
    tbl.autoCollectConnection = RunService.Heartbeat:Connect(function()
        if not tbl.autoCollectEnabled or not localPlayer.Character then return end
