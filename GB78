tbl.warpFly.microStepLoop = function()
    if not tbl.warpFly.hrp then return end
    tbl.warpFly._tmp.targetPos = tbl.warpFly.hrp.Position
    tbl.warpFly._tmp.lastTime = os.clock()
    while tbl.warpFly.enabled do
        if not tbl.warpFly.hrp or not tbl.warpFly.hrp.Parent or not tbl.warpFly.hum or not tbl.warpFly.hum.Parent then
            tbl.warpFly.stop()
            break
        end
        tbl.warpFly._tmp.now = os.clock()
        tbl.warpFly._tmp.dt = tbl.warpFly._tmp.now - tbl.warpFly._tmp.lastTime
        tbl.warpFly._tmp.lastTime = tbl.warpFly._tmp.now
        local v23 = tbl.warpFly.detectWall()
        if v23 and not tbl.warpFly.isNoclipping then tbl.warpFly.enterNoClip()
        elseif not v23 and tbl.warpFly.isNoclipping then tbl.warpFly.exitNoClip() end
        local mv = Vector3.zero
        local ok, vec = pcall(function()
            local cm = require(localPlayer.PlayerScripts:WaitForChild("PlayerModule")):GetControls()
            return cm:GetMoveVector()
        end)
        if ok and vec then mv = vec end
        local cf = workspace.CurrentCamera.CFrame
        local moveDir = cf.LookVector * -mv.Z + cf.RightVector * mv.X
        local vertical = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = 1
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical = -1 end
        local totalDelta = (moveDir + Vector3.new(0, vertical, 0)) * tbl.warpFly.flySpeed * tbl.warpFly._tmp.dt
        tbl.warpFly._tmp.targetPos = tbl.warpFly._tmp.targetPos + totalDelta
        local cur = tbl.warpFly.hrp.Position
        local rem = tbl.warpFly._tmp.targetPos - cur
        local dist = rem.Magnitude
        if dist > 0 then
            local steps = math.ceil(dist / 10)
            local stepVec = rem / steps
            for i = 1, steps do
                if tbl.warpFly.enabled then
                    cur = cur + stepVec
                    tbl.warpFly.hrp.CFrame = CFrame.new(cur) * tbl.warpFly.hrp.CFrame.Rotation
                end
            end
        else
            tbl.warpFly.hrp.CFrame = CFrame.new(tbl.warpFly._tmp.targetPos) * tbl.warpFly.hrp.CFrame.Rotation
        end
        tbl.warpFly.hrp.AssemblyLinearVelocity = Vector3.zero
        tbl.warpFly.hum:ChangeState(Enum.HumanoidStateType.Climbing)
        task.wait()
    end
end
tbl.warpFly.healthLockLoop = function()
    while tbl.warpFly.enabled do
        if tbl.warpFly.hum and tbl.warpFly.hum.Health <= 0 then tbl.warpFly.hum.Health = tbl.warpFly.hum.MaxHealth end
        task.wait(0.1)
    end
end
