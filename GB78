tbl.doAutoRepair = function()
    local list, n = tbl.getRichBuildables()
    if n == 0 then return end
    local target = nil
    if tbl.autoRepairTargetMode == "Closest" then
        local best = list[1]
        for i = 2, n do if list[i].dist < best.dist then best = list[i] end end
        target = best.obj
    elseif tbl.autoRepairTargetMode == "LowestHealth" then
        local best = list[1]
        for i = 2, n do
            local v = list[i]
            if v.ratio < best.ratio or (v.ratio == best.ratio and v.cur < best.cur) then best = v end
        end
        target = best.obj
    end
    if target then tbl.fireRepairSilent(target) end
end
tbl.autoRepairLoopFunc = function()
    while tbl.engineerAutoRepairEnabled do
        tbl.doAutoRepair()
        task.wait(tbl.repairCooldown)
    end
end
