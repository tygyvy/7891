local GUN_NAMES = {
    Musket = true, Carbine = true, Rifle = true, Pistol = true, Blunderbuss = true,
    ["Air Rifle"] = true, ["Nock Gun"] = true, ["Navy Pistol"] = true, ["Brass Pistol"] = true,
    ["Double Barrel Pistol"] = true, ["Flintlock Pistol"] = true, Shotgun = true,
    ["Bolt Rifle"] = true, ["Officer Pistol"] = true, ["Heavy Pistol"] = true,
    ["Light Dragoon Pistol"] = true, ["Horse Artillery Pistol"] = true,
}
local function isGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local anim = tool:FindFirstChild("Animations")
    if anim and (anim:FindFirstChild("Aim") or anim:FindFirstChild("Aiming")) then return true end
    return GUN_NAMES[tool.Name] == true
end
local function getShotsLoaded(tool)
    if not tool then return 0 end
    local sl = tool:FindFirstChild("ShotsLoaded")
    if sl and (sl:IsA("IntValue") or sl:IsA("NumberValue")) then return sl.Value end
    local players = Workspace:FindFirstChild("Players")
    if players then
        local me = players:FindFirstChild(LocalPlayer.Name)
        if me then
            local t = me:FindFirstChild(tool.Name)
            if t then
                local sl2 = t:FindFirstChild("ShotsLoaded")
                if sl2 then return sl2.Value end
            end
        end
    end
    return 0
end
local function getRemote(tool)
    if not tool then return nil end
    local r = tool:FindFirstChild("RemoteEvent")
    if r then return r end
    local players = Workspace:FindFirstChild("Players")
    if players then
        local me = players:FindFirstChild(LocalPlayer.Name)
        if me then
            local t = me:FindFirstChild(tool.Name)
            if t then return t:FindFirstChild("RemoteEvent") end
        end
    end
    return nil
end

local function startAutoReload()
    if T.autoReloadConn then return end
    T.autoReloadConn = RunService.Heartbeat:Connect(function()
        if not S.AutoReload then return end
        local c = char()
        if not c then return end
        for _, tool in ipairs(c:GetChildren()) do
            if tool:IsA("Tool") and isGun(tool) and getShotsLoaded(tool) == 0 then
                local r = getRemote(tool)
                if r then pcall(function() r:FireServer("Reload") end) end
            end
        end
    end)
end
local function stopAutoReload()
    if T.autoReloadConn then T.autoReloadConn:Disconnect() T.autoReloadConn = nil end
end

-- ===== 自动手术 =====
local function startAutoSurgeon()
    if T.autoSurgeonConn then return end
    T.autoSurgeonConn = task.spawn(function()
        while S.AutoSurgeon do
            local c = char()
            if c then
                local supplies = c:FindFirstChild("Medical Supplies")
                local remote = supplies and supplies:FindFirstChild("RemoteEvent")
                if remote then
                    local myHRP = c:FindFirstChild("HumanoidRootPart")
                    if myHRP then
                        for _, plr in ipairs(Players:GetPlayers()) do
                            if plr ~= LocalPlayer and plr.Character then
                                local ph = plr.Character:FindFirstChildOfClass("Humanoid")
                                if ph and ph.Health > 0 and ph.Health / ph.MaxHealth * 100 <= 40 then
                                    local phrp = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Torso")
                                    if phrp and (phrp.Position - myHRP.Position).Magnitude <= 15 then
                                        pcall(function() remote:FireServer("SendRequest", ph) end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end
local function stopAutoSurgeon()
    S.AutoSurgeon = false
    if T.autoSurgeonConn then task.cancel(T.autoSurgeonConn) T.autoSurgeonConn = nil end
end

