            Lighting.Ambient = Color3.fromRGB(255,255,255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
            Lighting.Brightness = 2
        else
            if T.originalLighting then
                Lighting.ClockTime = T.originalLighting.ClockTime
                Lighting.Ambient = T.originalLighting.Ambient
                Lighting.OutdoorAmbient = T.originalLighting.OutdoorAmbient
                Lighting.Brightness = T.originalLighting.Brightness
                T.originalLighting = nil
            end
        end
    end,
})
miscLeft:AddToggle("NoFog", {
    Text = "无雾",
    Default = false,
    Callback = function(v)
        S.NoFog = v
        if v then
            if not T.originalFog then T.originalFog = { FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart } end
            Lighting.FogEnd = 1e9
            Lighting.FogStart = 0
            for _, o in ipairs(Lighting:GetDescendants()) do
                if o:IsA("Atmosphere") then o.Parent = nil end
            end
        else
            if T.originalFog then
                Lighting.FogEnd = T.originalFog.FogEnd
                Lighting.FogStart = T.originalFog.FogStart
                T.originalFog = nil
            end
        end
    end,
})
