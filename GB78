tbl.ZOMBIE_ESP_RANGE = 200
tbl.zombieEspEnabled = { Axe = false, Eye = false, Sword = false, Barrel = false, FTorso = false, Normal = false, Headless = false }
tbl.zombieEffects = {}
tbl.getZombieTypeKey = function(arg)
    if arg:FindFirstChild("Axe") then return "Axe" end
    if arg:FindFirstChild("Eye") then return "Eye" end
    if arg:FindFirstChild("Sword") then return "Sword" end
    if arg:FindFirstChild("Barrel") then return "Barrel" end
    if arg:FindFirstChild("FTorso") then return "FTorso" end
    if not arg:FindFirstChild("Head") then return "Headless" end
    return "Normal"
end
tbl.ZOMBIE_TYPES = {
    Axe = { name = "斧头僵尸", color = Color3.fromRGB(180, 0, 250) },
    Eye = { name = "红眼", color = Color3.fromRGB(255, 50, 50) },
    Sword = { name = "胸甲骑兵", color = Color3.fromRGB(255, 0, 255) },
    Barrel = { name = "自爆", color = Color3.fromRGB(250, 250, 0) },
    FTorso = { name = "提灯人", color = Color3.fromRGB(255, 120, 0) },
    Normal = { name = "山伯乐", color = Color3.fromRGB(144, 238, 144) },
    Headless = { name = "无头士兵", color = Color3.fromRGB(255, 215, 0) },
}
tbl.createZombieESP = function(arg, arg2)
    local t = tbl.ZOMBIE_TYPES[arg2]
    if not t then return nil end
    return tbl.addESP({
        Name = t.name, Model = arg, Color = t.color,
        MaxDistance = tbl.ZOMBIE_ESP_RANGE, TextSize = 14,
        ESPType = "Highlight", FillColor = t.color, OutlineColor = t.color,
        FillTransparency = 0.5, OutlineTransparency = 0,
    })
end
tbl.removeZombieEffects = function(arg)
    local e = tbl.zombieEffects[arg]
    if e then tbl.destroyESP(e.esp) tbl.zombieEffects[arg] = nil end
end
tbl.clearAllZombieEffects = function()
    for k in tbl.zombieEffects do tbl.removeZombieEffects(k) end
end
tbl.updateZombieESP = function()
    local any = false
    for _, v in tbl.zombieEspEnabled do if v then any = true break end end
    if not any then tbl.clearAllZombieEffects() return end
    local ch = localPlayer.Character
    ch = ch and ch:FindFirstChild("HumanoidRootPart")
    ch = ch and ch.Position
    if not ch then tbl.clearAllZombieEffects() return end
    for k, e in tbl.zombieEffects do
        if not k.Parent or e.esp == nil or e.esp.Deleted then tbl.removeZombieEffects(k) end
    end
    local list = {}
    local cam = workspace:FindFirstChild("Camera")
    if cam then
        for _, m in cam:GetDescendants() do
            if m:IsA("Model") and m.Name:find("Zombie") then table.insert(list, m) end
        end
    end
    local zs = workspace:FindFirstChild("Zombies")
    if zs then
        for _, m in zs:GetChildren() do
            if m:IsA("Model") and m.Name:find("Zombie") then table.insert(list, m) end
        end
    end
    for _, m in list do
        local p = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or m:FindFirstChild("Torso")
        if p then
            local d = (p.Position - ch).Magnitude
            local key = tbl.getZombieTypeKey(m)
            local enabled = tbl.zombieEspEnabled[key]
            local e = tbl.zombieEffects[m]
            if enabled and d <= tbl.ZOMBIE_ESP_RANGE then
                if e == nil then
                    local obj = tbl.createZombieESP(m, key)
                    if obj then tbl.zombieEffects[m] = { esp = obj, typeKey = key } end
                end
            elseif e ~= nil then
                tbl.removeZombieEffects(m)
            end
        end
    end
end
local lastZ = 0
RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if now - lastZ >= 0.2 then
        lastZ = now
        tbl.updateZombieESP()
    end
end)

