                    if not tbl.originalBayonetHitCheck then tbl.originalBayonetHitCheck = hookfunction(result.BayonetHitCheck, tbl.unifiedBayonetHitCheck)
                    else hookfunction(result.BayonetHitCheck, tbl.unifiedBayonetHitCheck) end
                else
