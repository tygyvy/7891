local Cross = { enabled = false, track = nil, animator = nil, origDisabled = false, loopThread = nil }

local function crossCleanup()
    if Cross.loopThread then task.cancel(Cross.loopThread) Cross.loopThread = nil end
    if Cross.track then pcall(function() Cross.track:Stop() end) Cross.track = nil end
    local c = char()
    if c and Cross.origDisabled then
        local animate = c:FindFirstChild("Animate")
        if animate then animate.Disabled = false end
        Cross.origDisabled = false
    end
end

local function crossPlayOnce()
    local c = char()
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    if not Cross.origDisabled then
        local animate = c:FindFirstChild("Animate")
        if animate and not animate.Disabled then
            animate.Disabled = true
            Cross.origDisabled = true
        end
    end
    local animId = h.RigType == Enum.HumanoidRigType.R6 and "rbxassetid://27432686" or "rbxassetid://507776043"
    local anim = Instance.new("Animation")
    anim.AnimationId = animId
    local animator = h:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = h
    end
    local track = animator:LoadAnimation(anim)
    track:Play()
    track:AdjustSpeed(0)
    if Cross.track then Cross.track:Stop() end
    Cross.track = track
end

local function crossStart()
    if Cross.enabled then return end
    Cross.enabled = true
    crossCleanup()
    Cross.loopThread = task.spawn(function()
        while Cross.enabled do
            pcall(crossPlayOnce)
            task.wait(0.1)
        end
    end)
end

local function crossStop()
    Cross.enabled = false
    crossCleanup()
end

-- ===== 杀戮光环 =====
local Aura = {
    enabled = false,
    mode = "工兵",
    attackCount = 2,
    range = 35,
    angle = 180,
    interval = 0.05,
    attackBarrel = false,
    attackDracula = false,
    skipSpawning = true,
    targetTypes = {
        Bomber = false, Cuirassier = true, Runner = true, Zapper = true,
        Igniter = true, Shambler = true, Headless = true,
    },
    showRange = false,
    smartClosed = false,
    smartProbeTimer = 0,
    innerEntry = {},
    lastAttack = {},
    thread = nil,
    rangeFolder = nil,
    rangeParts = {},
    rangeBeams = {},
}

local function auraIsTarget(model)
    if not model or not model:IsA("Model") then return false end
    local t = getZombieType(model)
    if not t then return false end
    if t == "Bomber" and not Aura.attackBarrel then return false end
    return Aura.targetTypes[t] == true
end

local function inAuraAngle(myRoot, targetPos)
    if Aura.angle >= 360 then return true end
    local unit = (targetPos - myRoot.Position).Unit
    local look = myRoot.CFrame.LookVector
    local half = Aura.angle / 2
    local dot = math.clamp(look:Dot(unit), -1, 1)
    return math.deg(math.acos(dot)) <= half
end

local function collectAuraTargets()
    local c = char()
    if not c then return {} end
    local myRoot = c:FindFirstChild("HumanoidRootPart")
    if not myRoot then return {} end
    local list = {}
    local zombies = Workspace:FindFirstChild("Zombies")
    if zombies then
        for _, m in ipairs(zombies:GetChildren()) do
            if m:IsA("Model") and m:FindFirstChild("HumanoidRootPart") then
                if Aura.skipSpawning then
                    local st = m:FindFirstChild("State")
                    if st and tostring(st.Value) == "Spawn" then continue end
                end
                if auraIsTarget(m) then
                    local pos = m.HumanoidRootPart.Position
                    local d = (pos - myRoot.Position).Magnitude
                    if d <= Aura.range and inAuraAngle(myRoot, pos) then
                        table.insert(list, { model = m, dist = d })
                    end
                end
            end
        end
    end
    if Aura.attackDracula then
        local tv = Workspace:FindFirstChild("Transylvania")
        local dra = tv and tv:FindFirstChild("Modes") and tv.Modes:FindFirstChild("Boss") and tv.Modes.Boss:FindFirstChild("Dracula")
        if dra then
            local hrp = dra:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d <= Aura.range and inAuraAngle(myRoot, hrp.Position) then
                    table.insert(list, { model = dra, dist = d })
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

local function getMelee()
    local c = char()
    if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then
            local n = t.Name:lower()
            if t:GetAttribute("Melee") or n:find("musket") or n:find("flintlock") or n:find("bayonet") or n:find("sabre") or n:find("axe") or n:find("pickaxe") or n:find("shovel") or n:find("spade") or n:find("stake") or n:find("lance") or n:find("baguette") then
                return t
            end
        end
    end
    return nil
end

local function auraHit(zombie, weapon)
    if not zombie or not zombie.Parent then return false end
    if not weapon or not weapon.Parent then return false end
    local remote = weapon:FindFirstChild("RemoteEvent")
    if not remote then return false end
    local head = zombie:FindFirstChild("Head")
    if not head then return false end
    local c = char()
    local myHead = c and c:FindFirstChild("Head")
    local pos = head.Position
    local dir = myHead and (pos - myHead.Position).Unit or Vector3.new(0,1,0)
    local name = weapon.Name:lower()
    local isBayonet = name:find("musket") or name:find("flintlock") or name:find("bayonet")
    pcall(function()
        if isBayonet then
            remote:FireServer("ThrustBayonet")
            remote:FireServer("Bayonet_HitZombie", zombie:FindFirstChild("Orig") and zombie.Orig.Value or zombie, pos, true, "Head", "Down")
        else
            remote:FireServer("Swing", "Thrust")
            remote:FireServer("PrepareSwing")
            remote:FireServer("HitZombieM", zombie, pos, true, pos, "Head", dir)
        end
    end)
    return true
end

local function auraKills()
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls then
        local k = ls:FindFirstChild("Kills")
        if k and (k:IsA("IntValue") or k:IsA("NumberValue")) then return k.Value end
    end
    return 0
end

local function auraUpdateSmart()
    if Aura.mode ~= "智能" then return end
    local c = char()
    if not c then return end
    local myRoot = c:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local inner = 13
    local now = os.clock()
    local kills = auraKills()
    local zombiesFolder = Workspace:FindFirstChild("Zombies")
    local innerList = {}
    if zombiesFolder then
        for _, m in ipairs(zombiesFolder:GetChildren()) do
            if m:IsA("Model") and m:FindFirstChild("HumanoidRootPart") then
                if auraIsTarget(m) then
                    local d = (m.HumanoidRootPart.Position - myRoot.Position).Magnitude
                    if d <= inner then
                        innerList[m] = true
                        if not Aura.innerEntry[m] then
                            Aura.innerEntry[m] = { time = now, kills = kills }
                        end
                    end
                end
            end
        end
    end
    for m in pairs(Aura.innerEntry) do
        if not innerList[m] then Aura.innerEntry[m] = nil end
    end
    if not Aura.smartClosed then
        for m, info in pairs(Aura.innerEntry) do
            if m.Parent then
                local h = m:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    if now - info.time >= 2 then
                        if auraKills() == info.kills then
                            Aura.smartClosed = true
                            Aura.smartProbeTimer = 0
                            Aura.innerEntry = {}
                            break
                        else
                            Aura.innerEntry[m] = nil
                        end
                    end
                else
                    Aura.innerEntry[m] = nil
                end
            else
                Aura.innerEntry[m] = nil
            end
        end
    else
        if now - Aura.smartProbeTimer >= 2 then
            Aura.smartProbeTimer = now
            local targets = collectAuraTargets()
            if #targets > 0 then
                local w = getMelee()
                if w then
                    local k0 = auraKills()
                    auraHit(targets[1].model, w)
                    task.wait(2)
                    if auraKills() > k0 then
                        Aura.smartClosed = false
                        Aura.innerEntry = {}
                    end
                end
            else
                Aura.smartClosed = false
            end
        end
    end
end

local function auraCreateRangeVisuals()
    if Aura.rangeFolder then Aura.rangeFolder:Destroy() end
    local folder = Instance.new("Folder")
    folder.Name = "_GB_AuraRange"
    folder.Parent = Workspace
    Aura.rangeFolder = folder
    Aura.rangeParts = {}
    Aura.rangeBeams = {}
    for i = 1, 24 do
        local p = Instance.new("Part")
        p.Size = Vector3.new(0.6, 0.6, 0.6)
        p.Shape = Enum.PartType.Ball
        p.Material = Enum.Material.Neon
        p.Anchored = true
        p.CanCollide = false
        p.CanQuery = false
        p.CanTouch = false
        p.Transparency = 0.15
        p.Color = Color3.fromRGB(0, 255, 100)
        p.Parent = folder
        table.insert(Aura.rangeParts, p)
    end
    for i = 1, 24 do
        local a0 = Instance.new("Attachment")
        a0.Parent = Aura.rangeParts[i]
        local a1 = Instance.new("Attachment")
        a1.Parent = Aura.rangeParts[i % 24 + 1]
        local beam = Instance.new("Beam")
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 100))
        beam.Width0 = 0.12
        beam.Width1 = 0.12
        beam.FaceCamera = true
        beam.Parent = folder
        table.insert(Aura.rangeBeams, beam)
    end
end

local function auraUpdateRangeVisuals()
    if not Aura.showRange or not Aura.rangeFolder then return end
    local c = char()
    if not c then return end
    local myRoot = c:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local pos = myRoot.Position
    local hasTarget = #collectAuraTargets() > 0
    local color = hasTarget and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(0, 255, 100)
    local t = os.clock() * 0.6
    for i = 1, 24 do
        local ang = i / 24 * math.pi * 2 + t
        local p = pos + Vector3.new(math.cos(ang), 0, math.sin(ang)) * Aura.range
        local part = Aura.rangeParts[i]
        if part then
            part.Position = Vector3.new(p.X, pos.Y + 0.3, p.Z)
            part.Color = color
        end
    end
    for _, beam in ipairs(Aura.rangeBeams) do
        beam.Color = ColorSequence.new(color)
    end
end

local function auraLoop()
    while Aura.enabled do
        if Aura.mode == "智能" and Aura.smartClosed then
            auraUpdateSmart()
            task.wait(0.2)
        else
            local targets = collectAuraTargets()
            if #targets > 0 then
                local weapon = getMelee()
                if weapon then
                    local count = math.min(Aura.attackCount, #targets)
                    for i = 1, count do
                        local t = targets[i]
                        if t and t.model and t.model.Parent then
                            auraHit(t.model, weapon)
                        end
                    end
                end
            end
            if Aura.mode == "智能" then auraUpdateSmart() end
            task.wait(Aura.interval)
        end
    end
end

local function auraStart()
    if Aura.enabled then return end
    Aura.enabled = true
    if Aura.rangeFolder then Aura.rangeFolder:Destroy() end
    if Aura.showRange then auraCreateRangeVisuals() end
    Aura.thread = task.spawn(auraLoop)
end

local function auraStop()
    Aura.enabled = false
    if Aura.thread then task.cancel(Aura.thread) Aura.thread = nil end
    if Aura.rangeFolder then Aura.rangeFolder:Destroy() Aura.rangeFolder = nil end
    Aura.rangeParts = {}
    Aura.rangeBeams = {}
    Aura.smartClosed = false
    Aura.innerEntry = {}
end

