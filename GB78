        if not S.AutoCannon then return end
        local c = char()
        if not c then return end
        local myRoot = c:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
        local best, bestD = nil, 30
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "12 Pound Gun" and obj:IsA("Model") then
                local hole = obj:FindFirstChild("Gun") and obj.Gun:FindFirstChild("Hole")
                if hole then
                    local d = (hole.Position - myRoot.Position).Magnitude
