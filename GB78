-- ===== 僵尸分类 =====
local function getZombieType(model)
    if not model or not model:IsA("Model") then return nil end
    local agent = model:FindFirstChild("Agent")
    if agent then
        local t = agent:FindFirstChild("Type")
        if t and t:IsA("StringValue") then
            local v = string.lower(t.Value or "")
            if v == "normal" then return "Shambler" end
            if v == "barrel" then return "Bomber" end
            if v == "fast" then return "Runner" end
            if v == "sapper" then return "Zapper" end
            if v == "igniter" then return "Igniter" end
            if v == "cuirassier" then return "Cuirassier" end
        end
    end
    local attr = model:GetAttribute("Type")
    if type(attr) == "string" then
        local v = string.lower(attr)
        if v == "normal" then return "Shambler" end
        if v == "barrel" then return "Bomber" end
        if v == "fast" then return "Runner" end
        if v == "sapper" then return "Zapper" end
        if v == "igniter" then return "Igniter" end
        if v == "cuirassier" then return "Cuirassier" end
    end
    if model:FindFirstChild("Barrel", true) then return "Bomber" end
    if model:FindFirstChild("Whale Oil Lantern", true) then return "Igniter" end
    if model:FindFirstChild("Sword", true) then return "Cuirassier" end
    if model:FindFirstChild("Axe", true) and model:FindFirstChild("Head", true) then return "Zapper" end
    if model:FindFirstChild("Eye", true) and not model:FindFirstChild("Axe", true) then return "Runner" end
    if not model:FindFirstChild("Head", true) then return "Headless" end
    return "Shambler"
end

