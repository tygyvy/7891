-- ===== 主循环 =====
tbl.ZombieWatch = { _models = {}, _addedSubs = {}, _started = false }
tbl.ZOMBIE_ESP_RANGE = 200
tbl.zombieEspEnabled = { Axe = false, Eye = false, Sword = false, Barrel = false, FTorso = false, Normal = false, Headless = false }
tbl.zombieEffects = {}
tbl.getZombieTypeKey = function(arg)
    if arg:FindFirstChild("Axe") then return "Axe" end
    if arg:FindFirstChild("Eye") then return "Eye" end
    if arg:FindFirstChild("Sword") then return "Sword" end
    if arg:FindFirstChild("Barrel") then return "Barrel" end
    if arg:FindFirstChild("FTorso") then return "FTorso" end
    if not arg:FindFirstChild("Head") then return "Headless" end
    return "Normal"
end
tbl.ZOMBIE_TYPES = {
    Axe = { name = "斧头僵尸", color = Color3.fromRGB(180, 0, 250) },
    Eye = { name = "红眼", color = Color3.fromRGB(255, 50, 50) },
    Sword = { name = "胸甲骑兵", color = Color3.fromRGB(255, 0, 255) },
    Barrel = { name = "自爆", color = Color3.fromRGB(250, 250, 0) },
    FTorso = { name = "提灯人", color = Color3.fromRGB(255, 120, 0) },
    Normal = { name = "山伯乐", color = Color3.fromRGB(144, 238, 144) },
    Headless = { name = "无头士兵", color = Color3.fromRGB(255, 215, 0) },
}
tbl.createZombieESP = function(arg, arg2)
    local v26 = tbl.ZOMBIE_TYPES[arg2]
    if not v26 then return nil end
    return tbl.addESP({
        Name = v26.name, Model = arg, Color = v26.color,
        MaxDistance = tbl.ZOMBIE_ESP_RANGE, TextSize = 14,
        ESPType = "Highlight", FillColor = v26.color, OutlineColor = v26.color,
        FillTransparency = 0.5, OutlineTransparency = 0,
    })
end
tbl.removeZombieEffects = function(arg)
    local v26 = tbl.zombieEffects[arg]
    if v26 then tbl.destroyESP(v26.esp) tbl.zombieEffects[arg] = nil end
end
tbl.clearAllZombieEffects = function()
    for k in tbl.zombieEffects do tbl.removeZombieEffects(k) end
end
tbl.updateZombieESP = function()
    local flag = false
    for _, v26 in tbl.zombieEspEnabled do if v26 then flag = true break end end
    if not flag then tbl.clearAllZombieEffects() return end
    local character = localPlayer.Character
    character = character and character:FindFirstChild("HumanoidRootPart")
    character = character and character.Position
    if not character then tbl.clearAllZombieEffects() return end
    for k, v26 in tbl.zombieEffects do
        if not k.Parent or v26.esp == nil or v26.esp.Deleted then tbl.removeZombieEffects(k) end
    end
    local tbl7 = {}
    local camera = workspace:FindFirstChild("Camera")
    if camera then
        for _, v26 in camera:GetDescendants() do
            if v26:IsA("Model") and v26.Name:find("Zombie") then table.insert(tbl7, v26) end
        end
    end
    local zombies = workspace:FindFirstChild("Zombies")
    if zombies then
        for _, v26 in zombies:GetChildren() do
            if v26:IsA("Model") and v26.Name:find("Zombie") then table.insert(tbl7, v26) end
        end
    end
    for _, v26 in tbl7 do
        local humanoidRootPart = v26:FindFirstChild("HumanoidRootPart") or v26:FindFirstChild("Head") or v26:FindFirstChild("Torso")
        if humanoidRootPart then
            local magnitude = (humanoidRootPart.Position - character).Magnitude
            local v27 = tbl.getZombieTypeKey(v26)
            local v28 = tbl.zombieEspEnabled[v27]
            local v29 = tbl.zombieEffects[v26]
            if v28 and magnitude <= tbl.ZOMBIE_ESP_RANGE then
                if v29 == nil then
                    local v31 = tbl.createZombieESP(v26, v27)
                    if v31 then tbl.zombieEffects[v26] = { esp = v31, typeKey = v27 } end
                end
            elseif v29 ~= nil then
                tbl.removeZombieEffects(v26)
            end
        end
    end
end
local lastZombieESPUpdate = 0
RunService.Heartbeat:Connect(function()
    local v26 = os.clock()
    if v26 - lastZombieESPUpdate >= 0.2 then
        lastZombieESPUpdate = v26
        tbl.updateZombieESP()
    end
end)

