-- ===== 自动挖雪 =====
local DIGGABLE_PATHS = {
    "Vardohus Fortress/Modes/Objective/DoorSnow/Diggable",
    "Vardohus Fortress/Modes/Objective/Diggable",
}
local function findDiggable()
    for _, path in ipairs(DIGGABLE_PATHS) do
        local cur = Workspace
        local ok = true
        for name in string.gmatch(path, "[^/]+") do
            cur = cur:FindFirstChild(name)
            if not cur then ok = false break end
        end
        if ok and cur then return cur end
    end
    return nil
end
local function startAutoDig()
    if T.autoDigConn then return end
    T.autoDigConn = task.spawn(function()
        while S.AutoDig do
            local c = char()
            if c then
                local tool = nil
                for _, t in ipairs(c:GetChildren()) do
                    if t.Name == "Shovel" or t.Name == "Spade" then tool = t break end
                end
                if not tool then
                    local bp = LocalPlayer:FindFirstChild("Backpack")
                    if bp then
                        for _, t in ipairs(bp:GetChildren()) do
                            if t.Name == "Shovel" or t.Name == "Spade" then
                                tool = t; t.Parent = c; task.wait(0.2); break
                            end
                        end
                    end
                end
                if tool then
                    local remote = tool:FindFirstChild("RemoteEvent")
                    local dig = findDiggable()
                    if remote and dig then
                        pcall(function() remote:FireServer("Dig", dig, dig.Position) end)
                    end
                end
            end
            task.wait(0.05)
        end
    end)
end
local function stopAutoDig()
    S.AutoDig = false
    if T.autoDigConn then task.cancel(T.autoDigConn) T.autoDigConn = nil end
end

