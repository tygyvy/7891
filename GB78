if not tbl.SilentAim then tbl.SilentAim = {} end
do
    local sa = tbl.SilentAim
    sa.Enabled = false
    sa.SilentAimSelectedTypes = {}
    sa.SilentAimCurrentTarget = nil
    sa.SilentAimUpdateConn = nil
    sa.oldFire = nil
    sa.CHECK_WALLS = true
    sa.MAX_TARGET_RANGE = 200
    local function getT(arg)
        if not arg or not arg:IsA("Model") then return nil end
        local p = arg.Parent
        if p and p.Name == "Slim" and p.Parent and p.Parent.Name == "Zombies" then return "Cuirassier" end
        local a = arg:FindFirstChild("Agent")
        if a then
            local t = a:FindFirstChild("Type")
            if t and t:IsA("StringValue") then
                local v = string.lower(t.Value or "")
                if v == "normal" then return "Shambler" end
                if v == "barrel" then return "Bomber" end
                if v == "fast" then return "Runner" end
                if v == "sapper" then return "Zapper" end
                if v == "igniter" then return "Igniter" end
                if v == "cuirassier" then return "Cuirassier" end
            end
        end
        if arg:FindFirstChild("Barrel", true) then return "Bomber" end
        if arg:FindFirstChild("Whale Oil Lantern", true) then return "Igniter" end
        if arg:FindFirstChild("Sword", true) then return "Cuirassier" end
        if arg:FindFirstChild("Axe", true) and arg:FindFirstChild("Head", true) then return "Zapper" end
        if arg:FindFirstChild("Eye", true) and not arg:FindFirstChild("Axe", true) then return "Runner" end
        return "Shambler"
    end
    local function getPart(arg)
        if not arg or not arg.Parent then return nil end
        local h = arg:FindFirstChild("Head", true)
        if h then return h end
        local t = arg:FindFirstChild("Torso") or arg:FindFirstChild("UpperTorso") or arg:FindFirstChild("HumanoidRootPart")
        if t then return t end
        return arg.PrimaryPart
    end
    sa.StartSilentAimLoop = function()
        if sa.SilentAimUpdateConn then return end
        sa.SilentAimUpdateConn = RunService.Heartbeat:Connect(function()
            if not (sa.Enabled and #sa.SilentAimSelectedTypes > 0) then
                sa.SilentAimCurrentTarget = nil
                return
            end
            local tool = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Tool")
            if tool then
                local a = tool:FindFirstChild("Animations")
                if a then tool = a:FindFirstChild("Aim") or a:FindFirstChild("Aiming") else tool = a end
            end
            if not tool then sa.SilentAimCurrentTarget = nil return end
            local mh = localPlayer.Character and localPlayer.Character:FindFirstChild("Head")
            if not mh then return end
            local mp = mh.Position
            local best = nil
            local bestD = sa.MAX_TARGET_RANGE + 1
            local set = {}
            for _, v in sa.SilentAimSelectedTypes do set[v] = true end
            local zs = workspace:FindFirstChild("Zombies")
            if zs then
                for _, m in zs:GetChildren() do
                    if m:IsA("Model") then
                        local t = getT(m)
                        if t and set[t] then
                            local p = getPart(m)
                            if p and p:IsA("BasePart") then
                                local d = (p.Position - mp).Magnitude
                                if d < bestD and d <= sa.MAX_TARGET_RANGE then
                                    bestD = d
                                    best = p
                                end
                            end
                        end
                    end
                end
            end
            sa.SilentAimCurrentTarget = best
        end)
    end
    sa.StopSilentAimLoop = function()
        if sa.SilentAimUpdateConn then sa.SilentAimUpdateConn:Disconnect() sa.SilentAimUpdateConn = nil end
        sa.SilentAimCurrentTarget = nil
    end
    sa.SetupSilentAimHooks = function()
        if sa.oldFire then return end
        if type(hookmetamethod) ~= "function" then return end
        sa.oldFire = hookmetamethod(game, "__namecall", function(arg, ...)
            local pk = table.pack(...)
            if getnamecallmethod() == "FireServer" and sa.Enabled then
                local a = { ... }
                if a[1] == "Fire" and sa.SilentAimCurrentTarget then
                    local ch = localPlayer.Character
                    if ch then
                        local pos = sa.SilentAimCurrentTarget.Position
                        return sa.oldFire(arg, unpack({
                            "Fire",
                            a[2] or ch:FindFirstChild("Model") or ch,
                            pos,
                            a[4] or workspace:GetServerTimeNow(),
                        }))
                    end
                end
                return sa.oldFire(arg, table.unpack(pk, 1, pk.n))
            end
            return sa.oldFire(arg, ...)
        end)
    end
    sa.RemoveSilentAimHooks = function()
        if sa.oldFire then
            hookmetamethod(game, "__namecall", sa.oldFire)
            sa.oldFire = nil
        end
    end
    tbl.silentAim = tbl.silentAim or {}
    tbl._silentAimRefresh = function()
        local types = {}
        if tbl.silentAim.bomber then table.insert(types, "Bomber") end
        if tbl.silentAim.cuirassier then table.insert(types, "Cuirassier") end
        if tbl.silentAim.runner then table.insert(types, "Runner") end
        if tbl.silentAim.zapper then table.insert(types, "Zapper") end
        if tbl.silentAim.igniter then table.insert(types, "Igniter") end
        if tbl.silentAim.shambler then table.insert(types, "Shambler") end
        sa.SilentAimSelectedTypes = types
        if #types > 0 then
            sa.Enabled = true
            sa.StartSilentAimLoop()
            sa.SetupSilentAimHooks()
        else
            sa.Enabled = false
            sa.StopSilentAimLoop()
            sa.RemoveSilentAimHooks()
        end
    end
end

