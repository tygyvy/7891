        if best then
            local interact = best:FindFirstChild("Gun") and best.Gun:FindFirstChild("Hole") and best.Gun.Hole:FindFirstChild("Interact")
            if interact and interact:IsA("RemoteEvent") then
                pcall(function() interact:FireServer() end)
            end
        end
    end)
end
