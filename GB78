tbl.getBuildableFolders = function()
    local folders = {}
    for _, n in { "Buildables", "Stakes", "Barricades", "Structures", "Buildings" } do
        local f = workspace:FindFirstChild(n)
        if f then folders[#folders + 1] = f end
    end
    for _, c in workspace:GetChildren() do
        if c:IsA("Folder") or c:IsA("Model") then
            local m = c:FindFirstChild("Modes")
            if m then folders[#folders + 1] = m end
        end
