tbl.attackDraculaEnabled = false
tbl.skipSpawningEnabled = true
tbl.qingShuiAura = { enabled = false, thread = nil, lastAttackTime = {} }
local function fn13() return tbl.displayRange end
local function fn15(arg)
    local flag = arg:GetAttribute("Type") == "Barrel" or arg:FindFirstChild("Barrel") ~= nil
    return tbl.attackBarrelEnabled or not flag
end
local function fn16(arg, arg2)
    if tbl.attackAngle >= 360 then return true end
    local unit = (arg2 - arg.Position).Unit
    local look = arg.CFrame.LookVector
    local half = tbl.attackAngle / 2
    return math.deg(math.acos(math.clamp(look:Dot(unit), -1, 1))) <= half
end
tbl.startQingShuiAura = function()
    if tbl.qingShuiAura.thread then return end
    tbl.qingShuiAura.enabled = true
    tbl.qingShuiAura.thread = task.spawn(function()
        while tbl.qingShuiAura.enabled do
            local w = tbl.getHeldMelee()
            if w then
                local ch = localPlayer.Character
                if ch then
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local r = fn13()
                        local list = {}
                        local zs = workspace:FindFirstChild("Zombies")
                        if zs then
                            for _, m in zs:GetChildren() do
                                if m:IsA("Model") and m:FindFirstChild("HumanoidRootPart") then
                                    if tbl.skipSpawningEnabled then
                                        local s = m:FindFirstChild("State")
                                        if s and tostring(s.Value) == "Spawn" then continue end
                                    end
                                    if fn15(m) then
                                        local pos = m.HumanoidRootPart.Position
                                        local d = (pos - hrp.Position).Magnitude
                                        if d <= r and fn16(hrp, pos) then table.insert(list, { zombie = m, dist = d }) end
                                    end
                                end
                            end
                        end
                        if tbl.attackDraculaEnabled then
                            local tv = fn2(workspace, "Transylvania", "Modes", "Boss", "Dracula")
                            if tv then
                                local dr = tv:FindFirstChild("HumanoidRootPart")
                                local dh = tv:FindFirstChild("Head")
                                if dr and dh then
                                    local pos = dr.Position
                                    local d = (pos - hrp.Position).Magnitude
                                    if d <= r and fn16(hrp, pos) then table.insert(list, { zombie = tv, dist = d }) end
                                end
                            end
                        end
                        table.sort(list, function(a, b) return a.dist < b.dist end)
                        local cnt = math.min(tbl.attackCount, #list)
                        local now = os.clock()
                        for i = 1, cnt do
                            local z = list[i].zombie
                            if not tbl.qingShuiAura.lastAttackTime[z] or now - tbl.qingShuiAura.lastAttackTime[z] > 0.05 then
                                local re = w:FindFirstChild("RemoteEvent")
                                if re then
                                    local hd = z:FindFirstChild("Head")
                                    if hd then
                                        local ch2 = localPlayer.Character
                                        ch2 = ch2 and ch2:FindFirstChild("Head")
                                        local pos = hd.Position
                                        local dir = ch2 and (pos - ch2.Position).Unit or Vector3.new(0, 1, 0)
                                        re:FireServer("Swing", "Thrust")
                                        re:FireServer("PrepareSwing")
                                        re:FireServer("HitZombieM", z, pos, true, pos, "Head", dir)
                                        tbl.qingShuiAura.lastAttackTime[z] = now
                                    end
                                end
                            end
                        end
                        if cnt > 0 then
                            local t = {}
                            for i = 1, cnt do if list[i] then table.insert(t, list[i].zombie) end end
                            tbl.currentAttackTargets = t
                        else
                            tbl.currentAttackTargets = {}
                        end
                    end
                end
            else
                tbl.currentAttackTargets = {}
            end
            task.wait(0.2)
        end
    end)
end
