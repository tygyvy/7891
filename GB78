    if not hrp then
        for k, v in pairs(tbl.playerEspObjects) do tbl.destroyESP(v) tbl.playerEspObjects[k] = nil end
        return
    end
    local mp = hrp.Position
    for _, p in Players:GetPlayers() do
        if p ~= localPlayer and p.Character then
            local c = p.Character
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                local d = (r.Position - mp).Magnitude
                if d <= 500 then
                    if not tbl.playerEspObjects[p] then
                        local obj = tbl.addESP({
                            Name = p.DisplayName, Model = c, Color = Color3.fromRGB(0, 200, 255),
                            MaxDistance = 500, TextSize = 14, ESPType = "Highlight",
                            FillColor = Color3.fromRGB(0, 200, 255), OutlineColor = Color3.fromRGB(0, 200, 255),
                            FillTransparency = 0.5, OutlineTransparency = 0,
                        })
                        if obj then tbl.playerEspObjects[p] = obj end
                    end
                else
                    if tbl.playerEspObjects[p] then tbl.destroyESP(tbl.playerEspObjects[p]) tbl.playerEspObjects[p] = nil end
                end
            else
                if tbl.playerEspObjects[p] then tbl.destroyESP(tbl.playerEspObjects[p]) tbl.playerEspObjects[p] = nil end
            end
        end
    end
end
