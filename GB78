tbl.officer.autoReload.enable = function()
    if tbl.officer.autoReload.enabled then return end
    tbl.officer.autoReload.enabled = true
    tbl.officer.autoReload.scanAllTools()
    if tbl.officer.autoReload.backpackConn then tbl.officer.autoReload.backpackConn:Disconnect() end
    local function fn7()
        local bp = localPlayer:FindFirstChild("Backpack")
        if not bp then return false end
        if tbl.officer.autoReload.backpackConn then tbl.officer.autoReload.backpackConn:Disconnect() end
