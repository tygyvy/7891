tbl.sendSingleAttack = function(z)
    if not z or not z.Parent then return false end
    local ch = localPlayer.Character
    if not ch then return false end
    local w = nil
    for _, v in ch:GetChildren() do
        if v:IsA("Tool") then
            local n = v.Name:lower()
            if v:GetAttribute("Melee") or n:find("musket") or n:find("flintlock") or n:find("bayonet") then w = v break end
        end
    end
    if not w then return false end
    local re = w:FindFirstChild("RemoteEvent")
    if not re then return false end
    local n = w.Name:lower()
    local isBay = n:find("musket") or n:find("flintlock") or n:find("bayonet")
    local hd = z:FindFirstChild("Head")
    if not hd then return false end
    local h2 = ch:FindFirstChild("Head")
    local pos = hd.Position
    local dir = h2 and (pos - h2.Position).Unit or Vector3.new(0, 1, 0)
    pcall(function()
        if isBay then
            re:FireServer("ThrustBayonet")
            re:FireServer("Bayonet_HitZombie", z:FindFirstChild("Orig") and z.Orig.Value or z, pos, true, "Head", "Down")
        else
            re:FireServer("Swing", "Thrust")
            re:FireServer("PrepareSwing")
            re:FireServer("HitZombieM", z, pos, true, pos, "Head", dir)
        end
    end)
    return true
end
tbl.updateSmartAura = function()
    if not tbl.smartAura.enabled then return end
    if not tbl.isHoldingMelee() then
        if tbl.smartAura.auraClosed then
            tbl.smartAura.auraClosed = false
            tbl.smartAura.probeMode = false
            tbl.smartAura.innerEntryKills = {}
            if not tbl.qingShuiAura.enabled then tbl.startQingShuiAura() end
        end
        return
    end
    local r = math.min(tbl.displayRange, tbl.INNER_RING_FIXED_RADIUS)
    local list = tbl.getZombiesInRadius(r)
    local now = os.clock()
    local kills = tbl.getCurrentKills()
    if not tbl.smartAura.auraClosed then
        local set = {}
        for _, z in list do
            set[z] = true
            if not tbl.smartAura.innerEntryKills[z] then
                tbl.smartAura.innerEntryKills[z] = { time = now, kills = kills }
            end
        end
        for k in tbl.smartAura.innerEntryKills do
            if not set[k] or not k.Parent then tbl.smartAura.innerEntryKills[k] = nil end
        end
        for k, info in tbl.smartAura.innerEntryKills do
            if k and k.Parent then
                local h = k:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 then
                    if tbl.smartAura.killTimeout <= now - info.time then
                        if tbl.getCurrentKills() == info.kills then
                            tbl.smartAura.auraClosed = true
                            tbl.smartAura.probeMode = true
                            tbl.smartAura.retryTimer = 0
                            tbl.smartAura.innerEntryKills = {}
                            if tbl.qingShuiAura.enabled then tbl.stopQingShuiAura() end
                            break
                        else
                            tbl.smartAura.innerEntryKills[k] = nil
                        end
                    end
                else
                    tbl.smartAura.innerEntryKills[k] = nil
                end
            else
                tbl.smartAura.innerEntryKills[k] = nil
            end
        end
        return
    end
    if tbl.smartAura.probeMode then
        if now - tbl.smartAura.retryTimer >= tbl.smartAura.retryInterval then
            tbl.smartAura.retryTimer = now
            local z = tbl.getNearestNonBarrelZombie()
            if z then
                local k0 = tbl.getCurrentKills()
                tbl.sendSingleAttack(z)
                task.wait(2)
                if k0 < tbl.getCurrentKills() then
                    tbl.smartAura.auraClosed = false
                    tbl.smartAura.probeMode = false
                    tbl.smartAura.innerEntryKills = {}
                    if not tbl.qingShuiAura.enabled then tbl.startQingShuiAura() end
                end
            else
                tbl.smartAura.auraClosed = false
                tbl.smartAura.probeMode = false
                if not tbl.qingShuiAura.enabled then tbl.startQingShuiAura() end
            end
        end
    end
end
