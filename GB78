tbl.antiVelocity = tbl.antiVelocity or { enabled = false, wasBroken = false, conn = nil, savedAnimateDisabled = nil, savedNormal = nil, lastNormalSave = 0, lastFix = 0 }
local FRACTURE_IDS = {
    ["rbxassetid://12333490324"] = true, ["12333490324"] = true,
    ["rbxassetid://12333489072"] = true, ["12333489072"] = true,
}
tbl.antiVelocityEnable = function()
    if tbl.antiVelocity.enabled then return end
    tbl.antiVelocity.enabled = true
    tbl.antiVelocity.wasBroken = false
    if tbl.antiVelocity.conn then tbl.antiVelocity.conn:Disconnect() tbl.antiVelocity.conn = nil end
    local ch = localPlayer.Character
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    if h then pcall(function() h.AutoRotate = true end) end
    tbl.antiVelocity.conn = RunService.Heartbeat:Connect(function()
        if not tbl.antiVelocity.enabled then return end
        local ch2 = localPlayer.Character
        if not ch2 then return end
        local hrp = ch2:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local h2 = ch2:FindFirstChildOfClass("Humanoid")
        if h2 and not h2.AutoRotate then pcall(function() h2.AutoRotate = true end) end
        local kv = hrp:FindFirstChild("KillVelocity") or hrp:FindFirstChild("LinearVelocity")
        if kv and (kv:IsA("BodyVelocity") or kv:IsA("LinearVelocity")) then kv.Enabled = false end
        local us = ch2:FindFirstChild("UserStates")
        if us then
            local bl = us:FindFirstChild("BrokenLegs")
            if bl then
                local flag = bl.Value == true
                if flag and not tbl.antiVelocity.wasBroken then
                    tbl.antiVelocity.wasBroken = true
                    local a = ch2:FindFirstChild("Animate")
                    if a and tbl.antiVelocity.savedAnimateDisabled == nil then tbl.antiVelocity.savedAnimateDisabled = a.Disabled end
                    task.spawn(function()
                        local h3 = ch2:FindFirstChildOfClass("Humanoid")
                        if not h3 then return end
                        pcall(function() h3.AutoRotate = true end)
                        local a2 = ch2:FindFirstChild("Animate")
                        if a2 and a2.Disabled then pcall(function() a2.Disabled = false end) end
                        pcall(function() h3:ChangeState(Enum.HumanoidStateType.Running) end)
                    end)
                end
                if flag and tbl.antiVelocity.wasBroken then
                    local h3 = ch2:FindFirstChildOfClass("Humanoid")
                    if h3 then
                        pcall(function()
                            for _, t in ipairs(h3:GetPlayingAnimationTracks()) do
                                local aid = t.Animation and t.Animation.AnimationId
                                if aid and FRACTURE_IDS[aid] then pcall(function() t:Stop() end) end
                            end
                        end)
                        pcall(function()
                            local s = h3:GetState()
                            if s == Enum.HumanoidStateType.Physics or s == Enum.HumanoidStateType.FallingDown or s == Enum.HumanoidStateType.Ragdoll then
                                h3:ChangeState(Enum.HumanoidStateType.Running)
                            end
                        end)
                    end
                end
                if not flag and tbl.antiVelocity.wasBroken then
                    tbl.antiVelocity.wasBroken = false
                    local a3 = ch2:FindFirstChild("Animate")
                    if a3 and tbl.antiVelocity.savedAnimateDisabled ~= nil then
                        pcall(function() a3.Disabled = tbl.antiVelocity.savedAnimateDisabled end)
                        tbl.antiVelocity.savedAnimateDisabled = nil
                    end
                end
            else
                tbl.antiVelocity.wasBroken = false
            end
        else
            tbl.antiVelocity.wasBroken = false
        end
    end)
end
