tbl.warpFly = {
    enabled = false, flySpeed = 35, hrp = nil, head = nil, hum = nil,
    isNoclipping = false, microStepConn = nil, healthLockConn = nil,
    diedConn = nil, originalCanCollide = {}, descendantConnection = nil, _tmp = {},
}
tbl.warpFly.detectWall = function()
    local hrp = tbl.warpFly.hrp
    if not hrp then return false end
    local pos = hrp.Position
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { localPlayer.Character }
    for i = 1, 12 do
        local n = i / 12 * 2 * math.pi
        local x = math.cos(n)
        local z = math.sin(n)
        for y = -1, 1 do
            local hit = workspace:Raycast(pos, Vector3.new(x, y * 0.5, z).Unit * 3.5, rp)
            if hit then
                local inst = hit.Instance
                if inst and inst.CanCollide and inst.Transparency < 0.9 then return true end
            end
        end
    end
    return false
end
