local FRACTURE_IDS = {
    ["rbxassetid://12333490324"] = true, ["12333490324"] = true,
    ["rbxassetid://12333489072"] = true, ["12333489072"] = true,
}
local function startAntiFracture()
    if T.antiFractureConn then return end
    T.antiFractureConn = RunService.Heartbeat:Connect(function()
        if not S.AntiFracture then return end
        local c = char()
        if not c then return end
        local h = c:FindFirstChildOfClass("Humanoid")
        if not h then return end
        for _, track in ipairs(h:GetPlayingAnimationTracks()) do
            local aid = track.Animation and track.Animation.AnimationId
            if aid and FRACTURE_IDS[aid] then
                pcall(function() track:Stop() end)
            end
        end
        local userStates = c:FindFirstChild("UserStates")
        if userStates then
            local broken = userStates:FindFirstChild("BrokenLegs")
            if broken and broken.Value == true then
                broken.Value = false
                local animate = c:FindFirstChild("Animate")
                if animate and animate.Disabled then animate.Disabled = false end
                pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
            end
        end
    end)
end
local function stopAntiFracture()
    if T.antiFractureConn then T.antiFractureConn:Disconnect() T.antiFractureConn = nil end
end

-- ===== 移动 =====
local function startFly()
    local r = root()
    if not r then return end
    T.flyBV = Instance.new("BodyVelocity", r)
    T.flyBV.MaxForce = Vector3.new(1e5,1e5,1e5)
    T.flyBV.Velocity = Vector3.zero
    T.flyBG = Instance.new("BodyGyro", r)
    T.flyBG.P = 20000; T.flyBG.D = 500
    T.flyBG.MaxTorque = Vector3.new(1e5,1e5,1e5)
    T.flyConn = RunService.Heartbeat:Connect(function()
        if not S.Fly then return end
        local cam = Workspace.CurrentCamera
        local h = hum()
        if not cam or not h or not T.flyBV or not T.flyBG then return end
        local md = h.MoveDirection
        local v3 = Vector3.zero
        if md.Magnitude > 0.01 then
            local cl = cam.CFrame.LookVector
            local cr = cam.CFrame.RightVector
            local cfh = Vector3.new(cl.X,0,cl.Z).Unit
            local crh = Vector3.new(cr.X,0,cr.Z).Unit
            v3 = (cfh * md:Dot(cfh) + crh * md:Dot(crh)) * S.FlySpeed
            v3 = v3 + Vector3.new(0, cl.Y * md:Dot(cfh) * S.FlySpeed, 0)
        end
        T.flyBV.Velocity = v3
        T.flyBG.CFrame = cam.CFrame
    end)
end
local function stopFly()
    if T.flyBV then T.flyBV:Destroy() T.flyBV = nil end
    if T.flyBG then T.flyBG:Destroy() T.flyBG = nil end
    if T.flyConn then T.flyConn:Disconnect() T.flyConn = nil end
end

