tbl.getRichBuildables = function()
    local ch = localPlayer.Character
    if not ch then return {}, 0 end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return {}, 0 end
    local pos = hrp.Position
    local range2 = tbl.autoRepairRange * tbl.autoRepairRange
    local out = {}
    local seen = {}
    local n = 0
    local function check(arg)
        if n >= 40 then return end
        local p
        if arg:IsA("BasePart") then p = arg.Position
        elseif arg:IsA("Model") then
            local pp = arg.PrimaryPart or arg:FindFirstChildWhichIsA("BasePart")
            if pp then p = pp.Position end
        end
        if not p then return end
        local d2 = (p - pos).Magnitude
        if d2 > tbl.autoRepairRange then return end
        local bh = arg:FindFirstChild("BuildingHealth") or arg:FindFirstChild("ConstructHealth")
        if not bh then
            local h = arg:FindFirstChild("Health")
            if h and h:IsA("NumberValue") then bh = h end
        end
        if not bh or seen[bh] then return end
        seen[bh] = true
        local cur = bh.Value
        if not cur then return end
        local max = bh:GetAttribute("MaxHealth") or bh:GetAttribute("Max") or 100
        if max == 0 or cur >= max then return end
        n += 1
        out[n] = { obj = bh, cur = cur, max = max, ratio = cur / max, dist = d2 }
    end
    for _, f in tbl.getBuildableFolders() do
        for _, v in f:GetChildren() do
            check(v)
            if n >= 40 then break end
            if v:IsA("Model") or v:IsA("Folder") then
                for _, v2 in v:GetChildren() do
                    if n >= 40 then break end
                    check(v2)
                end
            end
        end
        if n >= 40 then break end
    end
    return out, n
end
tbl.fireRepairSilent = function(arg)
