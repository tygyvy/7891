Btn2.Position = UDim2.new(0, 20, 0, 94)
Btn2.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
Btn2.BackgroundTransparency = 1
Btn2.Text = "Obsidian"
Btn2.TextColor3 = Color3.fromRGB(0, 230, 255)
Btn2.Font = Enum.Font.GothamBold
Btn2.TextSize = 14
Btn2.AutoButtonColor = false
Btn2.TextTransparency = 1
Instance.new("UICorner", Btn2).CornerRadius = UDim.new(0, 8)
local Btn2Stroke = Instance.new("UIStroke", Btn2)
Btn2Stroke.Color = Color3.fromRGB(0, 170, 255)
Btn2Stroke.Transparency = 1

-- ==================== 打开过场动画 ====================
task.spawn(function()
    task.wait(0.1)
    local openTween = TweenService:Create(
        MainFrame,
        TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {
            Size = UDim2.new(0, 240, 0, 150),
            BackgroundTransparency = 0.08
        }
    )
    openTween:Play()

    TweenService:Create(Stroke, TweenInfo.new(0.35), {Transparency = 0.3}):Play()
    TweenService:Create(Title, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
    TweenService:Create(Btn1, TweenInfo.new(0.35), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
    TweenService:Create(Btn2, TweenInfo.new(0.35), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
    TweenService:Create(Btn1Stroke, TweenInfo.new(0.35), {Transparency = 0.5}):Play()
    TweenService:Create(Btn2Stroke, TweenInfo.new(0.35), {Transparency = 0.5}):Play()
end)

-- ==================== 悬停效果 ====================
local function hover(btn, stroke)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(40, 40, 55)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = 0.1}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(25, 25, 35)}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = 0.5}):Play()
    end)
end
hover(Btn1, Btn1Stroke)
hover(Btn2, Btn2Stroke)

-- ==================== 关闭过场动画 + 执行 ====================
local function closeAndLoad(link)
    -- 关闭动画
    local closeTween = TweenService:Create(
        MainFrame,
        TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }
    )
    closeTween:Play()

    TweenService:Create(Stroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
    TweenService:Create(Title, TweenInfo.new(0.25), {TextTransparency = 1}):Play()
    TweenService:Create(Btn1, TweenInfo.new(0.25), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
    TweenService:Create(Btn2, TweenInfo.new(0.25), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
    TweenService:Create(Btn1Stroke, TweenInfo.new(0.25), {Transparency = 1}):Play()
    TweenService:Create(Btn2Stroke, TweenInfo.new(0.25), {Transparency = 1}):Play()

    closeTween.Completed:Connect(function()
        UIChooserGui:Destroy()
        task.spawn(function()
            pcall(function()
                loadstring(game:HttpGet(link))()
            end)
        end)
    end)
end

