local function getClosestPart(model, pos)
    local closest, best = nil, math.huge
    for _, part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") then
            local d = (part.Position - pos).Magnitude
            if d < best then best = d closest = part end
        end
    end
    return closest, best
end

local function isKillableNPC(model)
    if model == char then return false end
    if game.Players:GetPlayerFromCharacter(model) then return false end
    local h = model:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    return true
end

local function getKnifeSamplePoints()
    local pts = {}
    if Handle and Handle.Parent then
        table.insert(pts, Handle.Position)
        local backOffset = -Handle.CFrame.LookVector * (Handle.Size.Z / 3)
        table.insert(pts, Handle.Position + backOffset)
        local frontOffset = Handle.CFrame.LookVector * (Handle.Size.Z / 3)
        table.insert(pts, Handle.Position + frontOffset)
    end
    return pts
end

local function getClosestDistToPoints(model, points)
    local best = math.huge
    for _, pt in ipairs(points) do
        local _, d = getClosestPart(model, pt)
        if d and d < best then best = d end
    end
    return best
end

local function findClosestNPC(radius)
    if Tool.Parent ~= char then return nil end
    local points = getKnifeSamplePoints()
    local bestModel, bestDist = nil, math.huge
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and isKillableNPC(model) then
            local d = getClosestDistToPoints(model, points)
            if d < bestDist then bestDist = d bestModel = model end
        end
    end
    if bestModel and bestDist <= radius then return bestModel end
    return nil
end

local function findAllNPCsInRange(radius, refPos)
    local list = {}
    if Tool.Parent ~= char then return list end
    local points = refPos and {refPos} or getKnifeSamplePoints()
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and isKillableNPC(model) then
            local d = getClosestDistToPoints(model, points)
            if d <= radius then table.insert(list, model) end
        end
    end
    return list
end

