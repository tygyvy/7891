local function makeSmallBtn(row, text, xOffset, color, callback)
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(0, 32, 0, 30)
    btn.Position = UDim2.new(1, xOffset, 0.5, -15)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.TextColor3 = Color3.new(1,1,1)
    btn.ZIndex = 1002
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local function makeWideBtn(row, text, color, callback)
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(0, 90, 0, 30)
    btn.Position = UDim2.new(1, -100, 0.5, -15)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextColor3 = Color3.new(1,1,1)
    btn.ZIndex = 1002
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local function makeToggleRow(text, initialState, callback)
    local row = makeRow()
    makeRowLabel(row, text)
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(0, 90, 0, 30)
    btn.Position = UDim2.new(1, -100, 0.5, -15)
    btn.BackgroundColor3 = initialState and Color3.fromRGB(40, 90, 40) or Color3.fromRGB(90, 40, 40)
    btn.Text = initialState and "开启" or "关闭"
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextColor3 = Color3.new(1,1,1)
    btn.ZIndex = 1002
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local state = initialState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = state and "开启" or "关闭"
        btn.BackgroundColor3 = state and Color3.fromRGB(40, 90, 40) or Color3.fromRGB(90, 40, 40)
        callback(state)
    end)
    return btn, row
end

