local settingsOpen = false
local function OpenSettings()
    if settingsOpen then return end
    settingsOpen = true
    SettingsPanel.Visible = true
    SettingsPanel.Size = UDim2.fromScale(0, 0)
    game:GetService("TweenService"):Create(
        SettingsPanel,
        TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = UDim2.fromScale(0.7, 0.7) }
    ):Play()
end

local function CloseSettings()
    if not settingsOpen then return end
    settingsOpen = false
    local tw = game:GetService("TweenService"):Create(
        SettingsPanel,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Size = UDim2.fromScale(0, 0) }
    )
    tw:Play()
    tw.Completed:Connect(function()
        SettingsPanel.Visible = false
    end)
end

SettingsButton.MouseButton1Click:Connect(function()
    if settingsOpen then CloseSettings() else OpenSettings() end
end)

SettingsClose.MouseButton1Click:Connect(CloseSettings)

