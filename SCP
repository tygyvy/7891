local function KKill(victimName)
    if not victimName then return end
    if victimName == KLocalPlayer.Name then return end
    local targetPlayer = KPlayers:FindFirstChild(victimName)
    if not targetPlayer or not targetPlayer.Character then return end
    if targetPlayer == KLocalPlayer then return end
    local targetHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not targetHumanoid or targetHumanoid.Health <= 0 then return end
    if receiv == nil then receiv = getReceiverRE() end
    if receiv then
        receiv:FireServer("Damage", targetHumanoid, math.huge)
    end
end

local function KKillAll()
    if receiv == nil then receiv = getReceiverRE() end
    if not receiv then return end
    for _, player in ipairs(KPlayers:GetPlayers()) do
        if player ~= KLocalPlayer and player.Character then
            local h = player.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                receiv:FireServer("Damage", h, math.huge)
            end
        end
    end
end

