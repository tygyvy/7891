    CPanelFrame.Size = UDim2.new(0, 70, 0, 50)
end

local function ShowOnlyDelete()
    EnsurePanel()
    if btnSelect and btnKill and btnDelete then
        btnSelect.Visible = false
        btnKill.Visible = false
        btnDelete.Visible = true
    end
    CPanelFrame.Visible = true
    CPanelFrame.Size = UDim2.new(0, 70, 0, 50)
end

local function ShowAll()
    EnsurePanel()
    if btnSelect and btnKill and btnDelete then
        btnSelect.Visible = true
        btnKill.Visible = true
        btnDelete.Visible = true
    end
    CPanelFrame.Visible = true
    CPanelFrame.Size = UDim2.new(0, 220, 0, 50)
end

local function HideAll()
    if CPanelFrame then
        CPanelFrame.Visible = false
    end
end

