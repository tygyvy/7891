local function CSound(id, v)
    local a = Instance.new("Sound", workspace)
    a.SoundId = "rbxassetid://" .. id
    a.PlayOnRemove = true
    a.Volume = v
    a:Destroy()
end

local function CGetClosestNPC(radius)
    local dist = radius or math.huge
    local closest = nil
    for _, v in next, workspace:GetDescendants() do
        if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") then
            local phrp = v.HumanoidRootPart
            local phum = v.Humanoid
            if v ~= CChar and (CHrp.Position - phrp.Position).Magnitude < dist and phum.Health > 0 and phrp.ReceiveAge == 0 then
                dist = (CHrp.Position - phrp.Position).Magnitude
                closest = v
            end
        end
    end
    return closest
end

local function CDoSelect()
    local npc = CGetClosestNPC()
    if npc then
        if not getgenv().CSelection or not getgenv().CSelection.Parent then
            getgenv().CSelection = Instance.new("SelectionBox")
        end
        getgenv().CSelection.Adornee = npc
        getgenv().CSelection.Name = "SelectedNPC"
        getgenv().CSelection.Parent = workspace
        getgenv().CSelection.Color3 = Color3.new(1, 0, 0)
        CSound(12221944, 10)
    end
end

local function CDoKill()
    local t = getgenv().CSelection and getgenv().CSelection.Adornee
    if t then
        local h = t:FindFirstChild("Humanoid")
        if h then
            h.Health = -1
            h:TakeDamage(9e9)
            h:ChangeState("Dead")
            getgenv().CSelection.Adornee = nil
        end
    end
end

local function CDoDelete()
    local t = getgenv().CSelection and getgenv().CSelection.Adornee
    if t then
        local phrp = t:FindFirstChild("HumanoidRootPart")
        if phrp and CHrp then
            local height = workspace.FallenPartsDestroyHeight
            local vec = Vector3.new(CHrp.Position.X, height, CHrp.Position.Z)
            local dis = (CHrp.Position - vec).Magnitude
            phrp.CFrame *= CFrame.new(0, (-dis) + 3, 0)
            CSound(12222140, 10)
        end
    end
end

