local function EnsurePanel()
    if CPanelGui and CPanelGui.Parent then return end

    CPanelGui = Instance.new("ScreenGui")
    CPanelGui.Name = "NPCPanel_" .. tostring(math.random(1, 999999))
    CPanelGui.ResetOnSpawn = false
    CPanelGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function()
        CPanelGui.Parent = gethui() or CCoreGui
    end)

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 220, 0, 50)
    frame.Position = UDim2.new(0.5, -110, 0.5, -25)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = CPanelGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(80, 80, 110)
    stroke.Thickness = 1
    stroke.Parent = frame

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 6)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = frame

    local function makeBtn(text, color, callback)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 62, 0, 36)
        b.BackgroundColor3 = color
        b.Text = text
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.TextSize = 14
        b.Font = Enum.Font.GothamBold
        b.AutoButtonColor = true
        b.Parent = frame

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 8)
        c.Parent = b

        b.MouseButton1Click:Connect(callback)
        return b
    end

    btnSelect = makeBtn("选中", Color3.fromRGB(60, 100, 200), CDoSelect)
    btnKill = makeBtn("击杀", Color3.fromRGB(200, 50, 50), CDoKill)
    btnDelete = makeBtn("删掉", Color3.fromRGB(150, 60, 180), CDoDelete)

    CPanelFrame = frame
end

local function IsPanelVisible()
    return CPanelGui and CPanelGui.Parent and CPanelFrame and CPanelFrame.Visible
end

local function ShowOnlySelect()
    EnsurePanel()
    if btnSelect and btnKill and btnDelete then
        btnSelect.Visible = true
        btnKill.Visible = false
        btnDelete.Visible = false
    end
    CPanelFrame.Visible = true
    CPanelFrame.Size = UDim2.new(0, 70, 0, 50)
end

