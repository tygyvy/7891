local ESPPlayers = game:GetService("Players")
local ESPLocalPlayer = ESPPlayers.LocalPlayer

local Abysall = nil
local ABY_BASE = "https://raw.githubusercontent.com/therealcookiemonsterof1966/AbysallContinued/main/"

local debugText = "状态：等待启动"
local debugLabelFunc = nil

local function SetDebug(msg)
    debugText = msg
    print("[透视调试] " .. msg)
    if debugLabelFunc then
        pcall(function() debugLabelFunc("状态：" .. msg) end)
    end
end

local function LoadAbysallESP()
    if Abysall then return true end
    local ok, err = pcall(function()
        getgenv().Abysall = {
            Environment = loadstring(game:HttpGet(ABY_BASE .. "Components/Environment.luau"))(),
            ESPLibrary  = loadstring(game:HttpGet(ABY_BASE .. "Components/ESP.luau"))(),
            Legit = true
        }
        Abysall = getgenv().Abysall
    end)
    if ok and Abysall and Abysall.ESPLibrary then
        SetDebug("ESPLibrary 加载成功")
        return true
    else
        SetDebug("ESPLibrary 加载失败：" .. tostring(err))
        return false
    end
end

local function isNPC(model)
    if not model or not model:IsA("Model") then return false end
    if model == ESPLocalPlayer.Character then return false end
    if ESPPlayers:GetPlayerFromCharacter(model) then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if not (model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")) then
        return false
    end
    return true
end

local ESPList = {}
local CurrentColor = Color3.fromRGB(255, 50, 50)
local autoScan = true
local espEnabled = false

local function AddESP(Model)
    if ESPList[Model] then return end
    if not Abysall or not Abysall.ESPLibrary then return end
    local ok, err = pcall(function()
        Abysall.ESPLibrary:AddESP({
            Object = Model,
            Text = Model.Name,
            Color = CurrentColor
        })
    end)
    if ok then
        ESPList[Model] = true
    else
        SetDebug("AddESP 失败：" .. tostring(err))
    end
end

local function RemoveESP(Model)
    if not ESPList[Model] then return end
    pcall(function()
        Abysall.ESPLibrary:RemoveESP(Model)
    end)
    ESPList[Model] = nil
end

local function ClearAllESP()
    for Model in pairs(ESPList) do
        pcall(function() Abysall.ESPLibrary:RemoveESP(Model) end)
    end
    ESPList = {}
end

local function ScanMap()
    if not Abysall then return end
    SetDebug("正在扫描地图...")
    local Found = 0
    local Start = tick()
    for _, Obj in ipairs(workspace:GetDescendants()) do
        if tick() - Start > 5 then break end
        if Obj:IsA("Model") and isNPC(Obj) then
            Found += 1
            if espEnabled then
                AddESP(Obj)
            end
        end
    end
    SetDebug("扫描完成，共 " .. Found .. " 个 NPC")
end

