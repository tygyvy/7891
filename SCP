local glockTool
local function getGlockInstanceFromAny()
   if game.Players.LocalPlayer.Backpack:FindFirstChild("Glock") or game.Players.LocalPlayer.Character:FindFirstChild("Glock") then
      specIndex = getupvalue(getsenv((game.Players.LocalPlayer.Backpack:FindFirstChild("Glock") or game.Players.LocalPlayer.Character:FindFirstChild("Glock")).HandgunScript).OnFire, 14)
      return (game.Players.LocalPlayer.Backpack:FindFirstChild("Glock") or game.Players.LocalPlayer.Character:FindFirstChild("Glock"))
   end
   for _, player in next, game.Players:GetPlayers() do
      if player.Character and player.Character:FindFirstChildOfClass("Tool") and player.Character:FindFirstChildOfClass("Tool").Name == "Glock" and player.Character:FindFirstChildOfClass("Tool"):FindFirstChild("Event") then
          specIndex = getupvalue(getsenv(player.Character.Glock.HandgunScript).OnFire, 14)
          return player.Character:FindFirstChildOfClass("Tool")
      end
      if player:FindFirstChild("Backpack") and player.Backpack:FindFirstChild("Glock") and player.Backpack.Glock:FindFirstChild("Event") then
          specIndex = getupvalue(getsenv(player.Backpack.Glock.HandgunScript).OnFire, 14)
          return player.Backpack.Glock
      end
   end
end

