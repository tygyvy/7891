<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DOORS 面板</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
body{background:#0c0f17;color:#fff}

/* 卡密页面 */
.login{position:fixed;inset:0;background:#0c0f17;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;z-index:10}
h2{font-size:24px}
#key{padding:12px 16px;width:260px;border-radius:10px;border:none;background:#1b1f2e;color:#fff;text-align:center}
button{padding:10px 24px;background:#0071e3;color:#fff;border:none;border-radius:10px;font-weight:bold;cursor:pointer}

/* 悬浮提示 */
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#1b1f2e;padding:12px 24px;border-radius:12px;opacity:0;transition:.4s;z-index:999}
.toast.show{opacity:1}

/* 加载页 */
.loading{position:fixed;inset:0;background:#0c0f17;display:none;flex-direction:column;align-items:center;justify-content:center;gap:20px}
.bar{width:300px;height:8px;background:#1b1f2e;border-radius:99px;overflow:hidden}
.progress{height:100%;width:0%;background:#0071e3;transition:width .05s linear}

/* 主面板 */
.main{display:none;padding:30px 20px;max-width:500px;margin:0 auto;position:relative}
.logo{font-size:32px;font-weight:bold;color:#0071e3;margin-bottom:30px}

/* 关闭UI */
.close-btn{position:absolute;top:10px;right:20px;padding:6px 12px;background:#1b1f2e;border:none;border-radius:8px;color:#fff;cursor:pointer}

/* 功能项 */
.item{display:flex;justify-content:space-between;align-items:center;background:#1b1f2e;padding:16px;border-radius:12px;margin-bottom:12px}
.item span{font-size:16px}

/* 开关 */
.switch{width:44px;height:22px;background:#333;border-radius:99px;position:relative;cursor:pointer}
.switch::after{content:'';position:absolute;width:18px;height:18px;background:#fff;border-radius:50%;top:2px;left:2px;transition:.2s}
.switch.on{background:#0071e3}
.switch.on::after{left:24px}

/* 滑块 */
.slide{flex-direction:column;align-items:flex-start;gap:10px}
.slide input{width:100%;accent-color:#0071e3}
.val{color:#999;font-size:14px;align-self:flex-end}

/* 悬浮球 */
.float-ball{
  width:50px;height:50px;border-radius:50%;background:#0071e3;color:#fff;
  font-size:20px;font-weight:bold;display:none;place-items:center;
  position:fixed;bottom:40px;right:30px;cursor:pointer;z-index:99;
}
</style>
</head>
<body>

<!-- 卡密 -->
<div class="login" id="login">
  <h2>输入卡密</h2>
  <input type="text" id="key" placeholder="请输入卡密">
  <button onclick="check()">确认</button>
</div>

<!-- 欢迎提示 -->
<div class="toast" id="toast">欢迎使用</div>

<!-- 加载 -->
<div class="loading" id="loading">
  <div>正在加载...</div>
  <div class="bar"><div class="progress" id="prog"></div></div>
</div>

<!-- 主界面 -->
<div class="main" id="main">
  <div class="logo">DOORS</div>
  <button class="close-btn" onclick="closeUI()">关闭UI</button>

  <div id="panel">
    <div class="item"><span>👁️ 透视门</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>🟢 透视柜子</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>🟡 透视金币</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>🔴 透视实体</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>🩷 透视物品</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>🤖 自动点击(柜、床除外)</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>👁️ 防Eeye不掉血</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>⚡ 快速互动</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>💡 亮度100</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>🟢 透视书</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>❌ 删除Seek追逐战</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>

    <div class="item slide">
      <div style="display:flex;justify-content:space-between;width:100%">
        <span>👁️ 视野 FOV (60~120)</span><span class="val" id="vFov">90 / 120</span>
      </div>
      <input type="range" min="60" max="120" value="90" oninput="vFov.textContent=this.value+' / 120'">
    </div>

    <div class="item"><span>🎮 第三人称锁定视野</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>

    <div class="item slide">
      <div style="display:flex;justify-content:space-between;width:100%">
        <span>🏃 速度调节</span><span class="val" id="vSpeed">100 / 200</span>
      </div>
      <input type="range" min="0" max="200" value="100" oninput="vSpeed.textContent=this.value+' / 200'">
    </div>

    <div class="item"><span>🚪 穿墙</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>🛑 无滑步</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>

    <div class="item slide">
      <div style="display:flex;justify-content:space-between;width:100%">
        <span>📏 透视距离</span><span class="val" id="vDist">250 / 500</span>
      </div>
      <input type="range" min="0" max="500" value="250" oninput="vDist.textContent=this.value+' / 500'">
    </div>

    <div class="item"><span>🛡️ 无敌模式</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
    <div class="item"><span>♾️ 无限物品</span><div class="switch" onclick="this.classList.toggle('on')"></div></div>
  </div>
</div>

<!-- 悬浮球 -->
<div class="float-ball" id="floatBall" onclick="openUI()">6</div>

<script>
function check(){
  let v = document.getElementById('key').value.trim();
  if(v === 'NB66'){
    let t = document.getElementById('toast');
    t.classList.add('show');
    setTimeout(()=>{
      t.classList.remove('show');
      login.style.display='none';
      startLoad();
    },1500);
  }else{
    alert('卡密错误');
  }
}

function startLoad(){
  let load = document.getElementById('loading');
  let prog = document.getElementById('prog');
  load.style.display='flex';
  let w=0;
  let timer=setInterval(()=>{
    w++;
    prog.style.width=w+'%';
    if(w>=100){
      clearInterval(timer);
      setTimeout(()=>{
        load.style.display='none';
        main.style.display='block';
      },500);
    }
  },25);
}

function closeUI(){
  panel.style.display='none';
  floatBall.style.display='grid';
}

function openUI(){
  panel.style.display='block';
  floatBall.style.display='none';
}
</script>
</body>
</html>
