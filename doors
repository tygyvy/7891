        OptionBtn.Size = UDim2.new(1, 0, 0, 28)
        OptionBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        OptionBtn.Text = name
        OptionBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        OptionBtn.Font = Enum.Font.Gotham
        OptionBtn.TextSize = 13
        OptionBtn.AutoButtonColor = true

        OptionBtn.MouseButton1Click:Connect(function()
            SelectedCooldown = seconds
            TimeButton.Text = name
            DropdownOpen = false
            Dropdown.Visible = false
        end)
    end

    RefreshDropdownHeight()

    TimeButton.MouseButton1Click:Connect(function()
        DropdownOpen = not DropdownOpen
        Dropdown.Visible = DropdownOpen
    end)

    local CopyButton = Instance.new("TextButton", MainFrame)
    CopyButton.Name = "CopyButton"
    CopyButton.Position = UDim2.new(0, 20, 1, -70)
    CopyButton.Size = UDim2.new(0, 100, 0, 40)
    CopyButton.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    CopyButton.Text = "复制"
    CopyButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    CopyButton.Font = Enum.Font.GothamBold
    CopyButton.TextSize = 14

    local CopyCorner = Instance.new("UICorner", CopyButton)
    CopyCorner.CornerRadius = UDim.new(0, 8)

    local CopyStroke = Instance.new("UIStroke", CopyButton)
    CopyStroke.Thickness = 2
    CopyStroke.Color = Color3.fromRGB(255, 255, 255)
    CopyStroke.Transparency = 0
    CopyStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local RunButton = Instance.new("TextButton", MainFrame)
    RunButton.Position = UDim2.new(0, 130, 1, -70)
    RunButton.Size = UDim2.new(0, 100, 0, 40)
    RunButton.BackgroundColor3 = Color3.fromRGB(30, 36, 30)
    RunButton.Text = "不复制执行"
    RunButton.TextColor3 = Color3.fromRGB(200, 255, 200)
    RunButton.Font = Enum.Font.GothamBold
    RunButton.TextSize = 13

    local RunCorner = Instance.new("UICorner", RunButton)
    RunCorner.CornerRadius = UDim.new(0, 8)

    local RunStroke = Instance.new("UIStroke", RunButton)
    RunStroke.Thickness = 1
    RunStroke.Color = Color3.fromRGB(80, 120, 80)
    RunStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    local CloseButton = Instance.new("TextButton", MainFrame)
    CloseButton.Position = UDim2.new(0, 240, 1, -70)
    CloseButton.Size = UDim2.new(0, 100, 0, 40)
    CloseButton.BackgroundColor3 = Color3.fromRGB(36, 30, 30)
    CloseButton.Text = "关闭执行"
    CloseButton.TextColor3 = Color3.fromRGB(255, 200, 200)
    CloseButton.Font = Enum.Font.GothamBold
    CloseButton.TextSize = 13

    local CloseCorner = Instance.new("UICorner", CloseButton)
    CloseCorner.CornerRadius = UDim.new(0, 8)

    local CloseStroke = Instance.new("UIStroke", CloseButton)
    CloseStroke.Thickness = 1
    CloseStroke.Color = Color3.fromRGB(120, 80, 80)
    CloseStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    task.spawn(function()
        while CopyStroke and CopyStroke.Parent do
            TweenService:Create(CopyStroke, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { Transparency = 0.75 }):Play()
            task.wait(0.9)
            if not (CopyStroke and CopyStroke.Parent) then break end
            TweenService:Create(CopyStroke, TweenInfo.new(0.9, Enum.EasingStyle.Sine), { Transparency = 0 }):Play()
            task.wait(0.9)
        end
    end)

    local Finished = false

    local function DestroyUI()
        if ScreenGui and ScreenGui.Parent then
            ScreenGui:Destroy()
        end
    end

    CopyButton.MouseButton1Click:Connect(function()
        if Finished then return end

        local Success = false

        if toclipboard then
            local ok = pcall(function() toclipboard(COPY_TEXT) end)
            Success = ok
        end

        if not Success and setclipboard then
            local ok = pcall(function() setclipboard(COPY_TEXT) end)
            Success = ok
        end

        if Success then
            Finished = true
            CopyButton.Text = "已复制"
            CopyButton.BackgroundColor3 = Color3.fromRGB(40, 100, 40)
            SubLabel.Text = "复制成功，点击 UI 关闭"
            SubLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            MarkShown()
        else
            CopyButton.Text = "复制失败"
            CopyButton.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
            SubLabel.Text = "执行器不支持复制"
            SubLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        end
    end)

    RunButton.MouseButton1Click:Connect(function()
        if Finished then return end
        Finished = true
        MarkShown()
        DestroyUI()
    end)

    CloseButton.MouseButton1Click:Connect(function()
        if Finished then return end
        Finished = true
        DestroyUI()
        error("用户选择了关闭执行")
    end)

    MainFrame.InputBegan:Connect(function(Input)
        if not Finished then return end
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then
            DestroyUI()
        end
    end)

    print("[卡密复制] UI 已加载")
end

if ShouldShow() then
    ShowKeyUI()
end

