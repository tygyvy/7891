-- 卡密复制 UI
-- 标题：卡密复制(不是让你解卡，只是给你卡密，卡密是固定的)
-- 功能：复制卡密 / 不复制直接执行 / 关闭执行 / 下次提醒时间可选
-- ==========================================

local Services = setmetatable({}, {
    __index = function(_, Name)
        return game:GetService(Name)
    end
})

local Players = Services.Players
local TweenService = Services.TweenService
local LocalPlayer = Players.LocalPlayer

local COPY_TEXT = "DOORSMV"
local SAVE_FOLDER = "DoorsMV"
local SAVE_FILE = SAVE_FOLDER .. "/LastShown.txt"

local TIME_OPTIONS = {
    ["1小时"] = 1 * 60 * 60,
    ["2小时"] = 2 * 60 * 60,
    ["6小时"] = 6 * 60 * 60,
    ["12小时"] = 12 * 60 * 60,
    ["24小时"] = 24 * 60 * 60,
}

local SelectedCooldown = TIME_OPTIONS["24小时"]

local function GetContainer()
    if gethui then
        return gethui()
    end
    return Services.CoreGui
end

local function HasFileAPI()
    return writefile and readfile and isfile and makefolder
end

local function ShouldShow()
    if not HasFileAPI() then return true end
    if not isfolder(SAVE_FOLDER) then makefolder(SAVE_FOLDER) end
    if not isfile(SAVE_FILE) then return true end

    local Last = tonumber(readfile(SAVE_FILE))
    if not Last then return true end
    if os.time() - Last >= SelectedCooldown then return true end
    return false
end

local function MarkShown()
    if not HasFileAPI() then return end
    if not isfolder(SAVE_FOLDER) then makefolder(SAVE_FOLDER) end
    writefile(SAVE_FILE, tostring(os.time()))
end

